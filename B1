BASE_DIR = Path(__file__).resolve().parent
TEMPLATES_DIR = BASE_DIR / "assets" / "Templates"
THUMB_CACHE_DIR = TEMPLATES_DIR / ".thumbcache"
OUTPUT_DIR = BASE_DIR / "assets" / "Generated"

for _d in (TEMPLATES_DIR, THUMB_CACHE_DIR, OUTPUT_DIR):
    _d.mkdir(parents=True, exist_ok=True)

ALLOWED_EXT = {".png", ".jpg", ".jpeg", ".webp"}

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY", "")
IMAGE_MODEL = os.getenv("SALES_BANNER_IMAGE_MODEL", "gemini-3.1-flash-image")


# ---------------------------------------------------------------------------
# Request schema
# ---------------------------------------------------------------------------
# If you already have a shared Pydantic schema for this request elsewhere
# in the codebase, use that one instead and adjust the handler's parameter
# type below — this is a reasonable standalone default, not something that
# has to live here.


class SalesBannerGenerateRequest(BaseModel):
    template_id: str
    title: str = ""
    description: str = ""
    prompt: str = ""
    aspect_ratio: str = "16:9"
    photo: Optional[str] = None  # data URL or raw base64, or None to keep the template's photo


# ---------------------------------------------------------------------------
# Template discovery
# ---------------------------------------------------------------------------
#
# Note: the frontend no longer calls a template-listing endpoint — its
# picker bundles the 11 images directly from its own assets folder for
# instant rendering. These functions are kept here as plain callables in
# case something else (an admin tool, another client) wants server-side
# template metadata; wire them into a route only if/when something needs
# them. The one thing that must match between the frontend's bundled
# images and this folder is the filename stem (template-6.jpg here can be
# template-6.png on the frontend — extension doesn't need to match, the id
# does).


def _load_overrides() -> dict:
    path = TEMPLATES_DIR / "templates.json"
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def _prettify(stem: str) -> str:
    name = re.sub(r"[_\-]+", " ", stem).strip()
    if re.fullmatch(r"[0-9a-f-]{8,}", name.replace(" ", "").lower()) or name.isdigit():
        return "Untitled template"
    return name.title()


def _mime_for(path: Path) -> str:
    return {
        "png": "image/png",
        "jpg": "image/jpeg",
        "jpeg": "image/jpeg",
        "webp": "image/webp",
    }.get(path.suffix.lower().lstrip("."), "image/png")


def discover_templates() -> list[dict]:
    overrides = _load_overrides()
    templates = []
    for path in TEMPLATES_DIR.iterdir():
        if path.suffix.lower() not in ALLOWED_EXT:
            continue
        override = overrides.get(path.stem, {})
        try:
            from PIL import Image

            with Image.open(path) as img:
                width, height = img.size
        except Exception:
            width, height = (1, 1)

        aspect = width / height if height else 1.0
        common = {"16:9": 16 / 9, "4:3": 4 / 3, "1:1": 1.0, "4:5": 4 / 5, "9:16": 9 / 16}
        nearest = min(common, key=lambda k: abs(common[k] - aspect))

        templates.append(
            {
                "id": path.stem,
                "name": override.get("name") or _prettify(path.stem),
                "order": override.get("order", 999),
                "width": width,
                "height": height,
                "native_aspect_ratio": nearest,
            }
        )

    templates.sort(key=lambda t: (t["order"], t["name"]))
    return templates


def _find_template_file(template_id: str) -> Optional[Path]:
    if not re.fullmatch(r"[A-Za-z0-9_\-]+", template_id):
        return None
    for ext in ALLOWED_EXT:
        candidate = TEMPLATES_DIR / f"{template_id}{ext}"
        if candidate.exists():
            return candidate
    return None


# ---------------------------------------------------------------------------
# Gemini editing
# ---------------------------------------------------------------------------


def _client():
    if not GEMINI_API_KEY:
        return None
    from google import genai

    return genai.Client(api_key=GEMINI_API_KEY)


def _decode_data_url(value: str) -> bytes:
    if value.strip().startswith("data:") and "," in value[:80]:
        value = value.split(",", 1)[1]
    return base64.b64decode(value)


def _build_prompt(title: str, description: str, custom_prompt: str, has_photo: bool) -> str:
    parts = [
        "You are editing an existing marketing banner image, not creating a "
        "new one. Preserve the banner's exact layout, background, "
        "decorative shapes, colour palette, logo, and the logo's position "
        "pixel-for-pixel. Do not redesign, restyle, or move anything that "
        "is not explicitly called out below."
    ]
    if title:
        parts.append(f'Replace the main headline text with: "{title}".')
    if description:
        parts.append(f'Replace the supporting body text with: "{description}".')
    if has_photo:
        parts.append(
            "Replace the person currently shown in the banner with the "
            "person in the second supplied image. Match the original "
            "person's pose, framing, crop, and lighting as closely as "
            "possible so the new person sits naturally in the same spot — "
            "do not change where the person is positioned in the frame."
        )
    else:
        parts.append("Keep the existing person in the banner exactly as they are.")
    if custom_prompt:
        parts.append(f"Additional instruction from the user: {custom_prompt.strip()}")
    parts.append(
        "Keep all text sharp, correctly spelled, and legible. Do not add "
        "any new logos, watermarks, or text that wasn't requested."
    )
    return " ".join(parts)


def _extract_image(response) -> Optional[bytes]:
    for candidate in getattr(response, "candidates", []) or []:
        content = getattr(candidate, "content", None)
        for part in getattr(content, "parts", []) or []:
            inline = getattr(part, "inline_data", None)
            if inline and getattr(inline, "data", None):
                data = inline.data
                return data if isinstance(data, bytes) else base64.b64decode(data)
    return None


# ---------------------------------------------------------------------------
# The handler your router imports
# ---------------------------------------------------------------------------


async def sales_banner_generate_handler(payload: SalesBannerGenerateRequest) -> dict:
    """Edit a template with new copy and/or a new person.

    Raises HTTPException on any failure — let FastAPI's normal error
    handling surface it, rather than encoding success/failure in the
    return value the way the Flask version did.
    """
    template_id = payload.template_id.strip()
    title = payload.title.strip()
    description = payload.description.strip()
    custom_prompt = payload.prompt.strip()
    aspect_ratio = payload.aspect_ratio.strip()

    if not template_id:
        raise HTTPException(status_code=400, detail="Select a template first.")
    if not title and not description and not custom_prompt:
        raise HTTPException(
            status_code=400, detail="Add a title, description, or instruction."
        )

    template_path = _find_template_file(template_id)
    if template_path is None:
        raise HTTPException(status_code=404, detail=f"Unknown template '{template_id}'.")

    client = _client()
    if client is None:
        raise HTTPException(
            status_code=502, detail="GEMINI_API_KEY is not configured on the server."
        )

    from google.genai import types

    parts: list = [
        types.Part.from_bytes(
            data=template_path.read_bytes(), mime_type=_mime_for(template_path)
        )
    ]

    if payload.photo:
        try:
            photo_bytes = _decode_data_url(payload.photo)
        except Exception as exc:
            raise HTTPException(
                status_code=400, detail="Could not read the uploaded photo."
            ) from exc
        parts.append(types.Part.from_bytes(data=photo_bytes, mime_type="image/png"))

    parts.append(
        _build_prompt(title, description, custom_prompt, has_photo=bool(payload.photo))
    )

    config_kwargs: dict = {"response_modalities": ["TEXT", "IMAGE"]}
    try:
        config_kwargs["image_config"] = types.ImageConfig(aspect_ratio=aspect_ratio or "16:9")
    except AttributeError:
        pass  # older/newer SDK without ImageConfig — edit still runs, just without the hint

    try:
        # .aio — the async client. A sync call here would block the whole
        # FastAPI event loop for every other in-flight request while this
        # one waits on the model.
        response = await client.aio.models.generate_content(
            model=IMAGE_MODEL,
            contents=parts,
            config=types.GenerateContentConfig(**config_kwargs),
        )
    except Exception as exc:
        raise HTTPException(status_code=502, detail=f"Image model call failed: {exc}") from exc

    image_bytes = _extract_image(response)
    if not image_bytes:
        raise HTTPException(
            status_code=502,
            detail="The model did not return an image. Try again, or simplify the instruction.",
        )

    banner_id = uuid.uuid4().hex[:12]
    (OUTPUT_DIR / f"{banner_id}.png").write_bytes(image_bytes)

    return {
        "success": True,
        "banner_id": banner_id,
        "template_id": template_id,
        "image_base64": f"data:image/png;base64,{base64.b64encode(image_bytes).decode()}",
    }










