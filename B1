export type Mode = "create" | "reference" | "edit";
export type Quality = "fast" | "standard" | "pro";
export type AspectRatio = "16:9" | "4:3" | "1:1" | "4:5" | "9:16";

export interface BannerSpec {
  title: string;
  description: string;
  cta: string | null;
  template: string;
  theme: string;
  style: string;
  background: string;
  subject: string | null;
  subject_position: "left" | "right" | "center" | "none";
  text_position: "left" | "right" | "center";
  color_palette: string;
  aspect_ratio: AspectRatio;
  negative: string;
}

export interface TemplateInfo {
  id: string;
  name: string;
  description: string;
  text_position: string;
  subject_position: string;
  aspect_ratios: string[];
}

export interface BannerResult {
  banner_id: string;
  image_url: string;
  visual_url: string;
  spec: BannerSpec;
  template: string;
  warnings: string[];
}

export interface Health {
  status: string;
  brand: string;
  planner_ready: boolean;
  image_model_ready: boolean;
  missing_brand_assets: string[];
  aspect_ratios: string[];
}

/** Uploaded asset held in memory: base64 payload plus a preview URL. */
export interface Upload {
  name: string;
  base64: string;
  preview: string;
}

export interface GeneratePayload {
  mode: Mode;
  brief: string;
  spec?: BannerSpec | null;
  overrides: Partial<BannerSpec>;
  reference_image?: string | null;
  person_image?: string | null;
  background_image?: string | null;
  reference_instruction?: string | null;
  quality: Quality;
}
