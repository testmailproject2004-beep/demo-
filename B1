    emp_section_content = employee_section if employee_section else "\n  (Employee names and achievements are listed with their placeholder positions below)"

    num_employees = len([n for n in employee_names[:4] if n.strip()])
    placeholder_description = _describe_slots_as_percentages(slots, canvas_w, canvas_h, employee_names)

    prompt = f"""You are a world-class professional banner designer. Your task is to generate a COMPLETE
professional sales/recognition banner background and layout. NO photos of people are provided
to you — your job is to design everything EXCEPT the employee photos themselves, which will be
inserted afterward by a separate process into the exact placeholder positions given below.

