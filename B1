"""Gemini image generation and editing.

Handles three call shapes with the same code path, because Gemini's image
models take images as ordinary inputs:
  create     -> [prompt]
  reference  -> [prompt, reference_image, person_image?]
  edit       -> [prompt, current_banner_visual]

When no API key is present the module returns a locally rendered gradient so
the rest of the pipeline (composition, fonts, logo placement) stays testable.
"""

import base64
import io
from typing import List, Optional, Tuple

from PIL import Image, ImageDraw, ImageFilter

from config import CANVAS_SIZES, COLORS, GEMINI_API_KEY, IMAGE_MODELS


class ImageGenError(RuntimeError):
    pass


def _client():
    if not GEMINI_API_KEY:
        return None
    from google import genai

    return genai.Client(api_key=GEMINI_API_KEY)


def _decode(b64: str) -> bytes:
    if "," in b64[:64] and b64.strip().startswith("data:"):
        b64 = b64.split(",", 1)[1]
    return base64.b64decode(b64)


def _placeholder(size: Tuple[int, int], seed_text: str) -> bytes:
    """Brand-coloured stand-in so the composer can be developed offline."""
    width, height = size
    base = Image.new("RGB", (width, height), COLORS["navy"])
    draw = ImageDraw.Draw(base)
    for i in range(0, width, 4):
        ratio = i / width
        blend = tuple(
            round(COLORS["navy"][c] * (1 - ratio) + COLORS["ink"][c] * ratio)
            for c in range(3)
        )
        draw.line([(i, 0), (i, height)], fill=blend, width=4)
    glow = Image.new("RGB", (width, height), (0, 0, 0))
    gdraw = ImageDraw.Draw(glow)
    gdraw.ellipse(
        [width * 0.55, -height * 0.2, width * 1.15, height * 1.1],
        fill=COLORS["crimson"],
    )
    glow = glow.filter(ImageFilter.GaussianBlur(width // 8))
    base = Image.blend(base, glow, 0.28)
    buffer = io.BytesIO()
    base.save(buffer, format="PNG")
    return buffer.getvalue()


def _parts_from_response(response) -> Optional[bytes]:
    for candidate in getattr(response, "candidates", []) or []:
        content = getattr(candidate, "content", None)
        for part in getattr(content, "parts", []) or []:
            inline = getattr(part, "inline_data", None)
            if inline and getattr(inline, "data", None):
                data = inline.data
                return data if isinstance(data, bytes) else base64.b64decode(data)
    return None


def generate(
    prompt: str,
    aspect_ratio: str = "16:9",
    quality: str = "standard",
    images_b64: Optional[List[str]] = None,
) -> bytes:
    """Return PNG/JPEG bytes for the banner artwork."""
    size = CANVAS_SIZES.get(aspect_ratio, CANVAS_SIZES["16:9"])
    client = _client()
    if client is None:
        return _placeholder(size, prompt)

    from google.genai import types

    contents: list = [prompt]
    for raw in images_b64 or []:
        if not raw:
            continue
        contents.append(
            types.Part.from_bytes(data=_decode(raw), mime_type="image/png")
        )

    try:
        response = client.models.generate_content(
            model=IMAGE_MODELS.get(quality, IMAGE_MODELS["standard"]),
            contents=contents,
            config=types.GenerateContentConfig(
                response_modalities=["IMAGE"],
                image_config=types.ImageConfig(aspect_ratio=aspect_ratio),
            ),
        )
    except Exception as exc:
        raise ImageGenError(f"Image model call failed: {exc}") from exc

    data = _parts_from_response(response)
    if not data:
        raise ImageGenError("Image model returned no image. Check safety blocks and quota.")
    return data


def edit(prompt: str, current_b64: str, quality: str = "standard") -> bytes:
    return generate(prompt, quality=quality, images_b64=[current_b64])

