# =====================================================================
# GENERATION FLOW — ZERO-FACE-TOUCH GUARANTEE
# =====================================================================
# 1. The LLM receives NO employee photos as image input, ever. It only
#    receives text: title, description, theme, template, background
#    style, employee names/achievements, and the pixel/percentage
#    coordinates of neutral placeholder zones to leave empty.
#    Because the model is never given a face, it structurally cannot
#    copy, blend, regenerate, or otherwise alter one — this is
#    guaranteed by what data is sent, not by instructions alone.
# 2. The LLM generates the complete background, layout, title, and
#    employee name/achievement text around those placeholder zones.
# 3. Python then computes the exact same placeholder zones (single
#    source of truth: compute_employee_slots) and pastes the original,
#    unmodified uploaded photos directly into the finished banner.
#    The pixels of every employee photo are never processed by the
#    model — only cropped/resized by Python — so identity can never
#    be altered.
# =====================================================================


def compute_employee_slots(canvas_w: int, canvas_h: int, count: int) -> List[Dict[str, int]]:
    """
    Deterministically compute placeholder regions (in pixels) for employee
    photos on the banner canvas.

    This SAME function is used both to describe placeholder zones to the
    LLM (so it leaves them visually empty) and, after generation, to
    composite the real uploaded photos into the banner. Because both
    steps share one formula, photo placement never depends on anything
    the model actually drew.
    """
    count = max(1, min(4, count))
    orientation = (
        "portrait" if canvas_h > canvas_w * 1.15
        else "landscape" if canvas_w > canvas_h * 1.15
        else "square"
    )

    columns = count if (orientation != "portrait" or count <= 2) else 2
    rows = math.ceil(count / columns)

    band_top = 0.24 * canvas_h
    band_bottom = 0.80 * canvas_h
    band_height = band_bottom - band_top

    side_margin = 0.07 * canvas_w
    band_left = side_margin
    band_width = canvas_w - 2 * side_margin

    col_gap = 0.03 * canvas_w
    row_gap = 0.03 * canvas_h

    cell_w = (band_width - col_gap * (columns - 1)) / columns
    cell_h = (band_height - row_gap * (rows - 1)) / rows

    photo_w = cell_w * 0.82
    photo_h = cell_h * 0.62

    slots: List[Dict[str, int]] = []
    for i in range(count):
        col = i % columns
        row = i // columns
        items_in_row = min(columns, count - row * columns)
        row_offset = ((columns - items_in_row) * (cell_w + col_gap)) / 2

        cell_x = band_left + row_offset + col * (cell_w + col_gap)
        cell_y = band_top + row * (cell_h + row_gap)

        photo_x = cell_x + (cell_w - photo_w) / 2
        photo_y = cell_y

        slots.append({
            "index": i,
            "x": round(photo_x),
            "y": round(photo_y),
            "w": round(photo_w),
            "h": round(photo_h),
            "text_y": round(cell_y + photo_h + 0.02 * canvas_h),
            "text_h": round(cell_h - photo_h - 0.02 * canvas_h),
        })
    return slots


def _describe_slots_as_percentages(slots: List[Dict[str, int]], canvas_w: int, canvas_h: int, names: List[str]) -> str:
    lines = []
    for slot in slots:
        idx = slot["index"]
        name = names[idx] if idx < len(names) and names[idx].strip() else f"Employee {idx + 1}"
        x_pct = slot["x"] / canvas_w * 100
        y_pct = slot["y"] / canvas_h * 100
        w_pct = slot["w"] / canvas_w * 100
        h_pct = slot["h"] / canvas_h * 100
        lines.append(
            f"  Placeholder {idx + 1} — \"{name}\": a soft neutral rounded rectangle card, "
            f"positioned at {x_pct:.0f}% from the left and {y_pct:.0f}% from the top of the canvas, "
            f"sized {w_pct:.0f}% of the canvas width by {h_pct:.0f}% of the canvas height. "
            f"Directly beneath this card, render the name \"{name}\" and their achievement text."
        )
    return "\n".join(lines)


def composite_employee_photos(
    banner_bytes: bytes,
    employee_photos_b64: List[Optional[str]],
    slots: List[Dict[str, int]],
) -> bytes:
    """
    Paste the ORIGINAL uploaded employee photos directly into the
    generated banner at the precomputed placeholder positions.

    The only operations applied to each uploaded photo are a cover-fit
    crop/resize and a rounded-corner mask for visual polish — the pixel
    content of each person's face is never generated, blended, or
    otherwise altered.
    """
    banner = Image.open(io.BytesIO(banner_bytes)).convert("RGBA")

    for slot in slots:
        idx = slot["index"]
        if idx >= len(employee_photos_b64) or not employee_photos_b64[idx]:
            continue

        try:
            photo_bytes = base64.b64decode(employee_photos_b64[idx])
            photo = Image.open(io.BytesIO(photo_bytes)).convert("RGB")
        except Exception as e:
            logging.exception(f"Failed to load employee photo {idx + 1} for compositing: {e}")
            continue

        target_w, target_h = slot["w"], slot["h"]
        if target_w <= 0 or target_h <= 0:
            continue

        # Cover-fit crop to the slot size — resizes/crops only, never
        # regenerates or alters the photo's pixel content.
        fitted = ImageOps.fit(photo, (target_w, target_h), Image.LANCZOS)

        radius = max(4, int(min(target_w, target_h) * 0.08))

        # Soft drop shadow behind the photo card
        shadow = Image.new("RGBA", (target_w + 24, target_h + 24), (0, 0, 0, 0))
        shadow_draw = ImageDraw.Draw(shadow)
        shadow_draw.rounded_rectangle(
            [12, 14, 12 + target_w, 14 + target_h], radius=radius, fill=(0, 0, 0, 90)
        )
        shadow = shadow.filter(ImageFilter.GaussianBlur(10))
        banner.alpha_composite(shadow, (slot["x"] - 12, slot["y"] - 12))

        # Rounded-rect mask for the photo itself
        mask = Image.new("L", (target_w, target_h), 0)
        mask_draw = ImageDraw.Draw(mask)
        mask_draw.rounded_rectangle([0, 0, target_w, target_h], radius=radius, fill=255)

        photo_rgba = Image.new("RGBA", (target_w, target_h))
        photo_rgba.paste(fitted, (0, 0))
        photo_rgba.putalpha(mask)

        banner.alpha_composite(photo_rgba, (slot["x"], slot["y"]))

        # Thin white border/frame around the photo for a polished card look
        border = Image.new("RGBA", (target_w, target_h), (0, 0, 0, 0))
        border_draw = ImageDraw.Draw(border)
        border_draw.rounded_rectangle(
            [0, 0, target_w - 1, target_h - 1], radius=radius, outline=(255, 255, 255, 230), width=4
        )
        banner.alpha_composite(border, (slot["x"], slot["y"]))

    output = io.BytesIO()
    banner.convert("RGB").save(output, format="PNG")
    return output.getvalue()


def generate_comprehensive_banner_prompt(
    title: str,
    description: str,
    template_id: str,
    theme: str,
    background_style: str,
    employee_names: List[str],
    employee_achievements: List[str],
    aspect_ratio: str,
    slots: List[Dict[str, int]],
    canvas_w: int,
    canvas_h: int,
) -> str:
    """
    Generate a COMPREHENSIVE text-only prompt. The LLM receives NO employee
    photos — it never sees a face, so it cannot alter one. It generates the
    background, layout, title, and name/achievement text, leaving neutral
    placeholder cards at the exact positions Python will later use to paste
    in the real, unmodified employee photos.
    """

    if employee_achievements is None:
        employee_achievements = []

    employee_section = ""
    for idx, name in enumerate(employee_names[:4]):
        if name.strip():
            employee_section += f"\n  • {name}"
            if idx < len(employee_achievements) and employee_achievements[idx].strip():
                employee_section += f": {employee_achievements[idx].strip()}"

    canvas_spec = f"{canvas_w}x{canvas_h}px"

    layout_info = SALES_TEMPLATE_LAYOUTS.get(template_id, SALES_TEMPLATE_LAYOUTS["employee-recognition"])
