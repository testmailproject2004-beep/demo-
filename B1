async def generate_sales_banner_background(
    prompt: str,
    db: AsyncSession,
) -> bytes:
    """
    Call the image LLM with the text-only prompt. CRITICAL: no employee
    photo, reference image, or background image is ever passed here — the
    model receives no image input at all, so it has no face data it could
    possibly copy, blend, or alter.
    """

    print("\n" + "=" * 70)
    print("🎨 BANNER BACKGROUND GENERATION - TEXT ONLY, NO FACE INPUT")
    print("=" * 70)
    print(f"📝 Prompt length: {len(prompt)} characters")
    print("📷 Employee photos sent to model: 0 (by design)")
    print("=" * 70 + "\n")

    result = await image_llm_aexecute(
        prompt=prompt,
        db=db,
        image_bytes=None,
        image_mime=None,
        additional_images=None,
    )

    if result.get("status_code") != 200:
        error_msg = result.get("message") or result.get("error") or "Image generation failed"
        logging.error(f"LLM error: {error_msg}")
        raise ValueError(error_msg)

    image_data = result.get("image_bytes")
    if not image_data:
        raise ValueError("No image bytes returned from the image generation model")

    print(f"\n✅ BANNER BACKGROUND GENERATED: {len(image_data)} bytes\n")
    return image_data


async def sales_banner_generate_handler(request: Request, db: AsyncSession):
    """
    Banner generation handler.

    - No reference image, no uploaded/prompted background — background is
      chosen via a fixed dropdown (background_style) and generated fresh.
    - ALL inputs (title, description, theme, template, background style,
      aspect ratio, employee names/photos/achievements) are sent to the LLM.
    - Employee photos are sent as image inputs but the prompt strictly
      forbids the model from regenerating or altering them.
    """
    try:
        payload = await request.json()

        # Extract and validate ALL inputs
        title = (payload.get("title") or "").strip()
        description = (payload.get("description") or payload.get("subtitle") or "").strip()
        template = payload.get("template") or payload.get("template_id") or "employee-recognition"
        theme = (payload.get("theme") or "Professional Recognition").strip()
        aspect_ratio = payload.get("aspect_ratio", "16:9")
        background_style = payload.get("background_style") or DEFAULT_BACKGROUND_STYLE
        if background_style not in BACKGROUND_STYLE_PRESETS:
            background_style = DEFAULT_BACKGROUND_STYLE

        # Employee information
        employees_list = payload.get("employees", [])
        number_of_employees = payload.get("number_of_employees", 0)

        names = []
        images = []
        achievements = []

        if employees_list and number_of_employees > 0:
            for emp in employees_list[:number_of_employees]:
                names.append(emp.get("name", "").strip() or "")
                images.append(emp.get("photo", ""))
                achievements.append(emp.get("achievement", "").strip() or "")
        else:
            # Fallback to legacy format
            names = [n.strip() if isinstance(n, str) else "" for n in (payload.get("names") or [])]
            images = payload.get("images") or []
            achievements = [a.strip() if isinstance(a, str) else "" for a in (payload.get("achievements") or [])]

        # VALIDATION
        if not title:
            return JSONResponse({"success": False, "error": "Banner title is required."}, status_code=400)
        if not description:
            return JSONResponse({"success": False, "error": "Banner description is required."}, status_code=400)

        if not names or not images or len(names) == 0 or len(images) == 0:
            return JSONResponse({
                "success": False,
                "error": "At least one employee name and photo is required."
            }, status_code=400)

        if len(images) > 4:
            return JSONResponse({
                "success": False,
                "error": "Maximum 4 employee photos allowed."
            }, status_code=400)

        for idx in range(len(names)):
            if not names[idx].strip():
                return JSONResponse({
                    "success": False,
                    "error": f"Recipient {idx + 1} name is required."
                }, status_code=400)
            if idx >= len(images) or not images[idx]:
                return JSONResponse({
                    "success": False,
                    "error": f"Recipient {idx + 1} photo is required."
                }, status_code=400)

        # Log the complete API payload (for verification that ALL inputs are being used)
        print("\n" + "=" * 70)
        print("📋 SALES BANNER API PAYLOAD (ALL INPUTS)")
        print("=" * 70)
        print(f"Title: {title}")
        print(f"Description: {description[:80]}...")
        print(f"Theme: {theme}")
        print(f"Template: {template}")
        print(f"Background Style: {background_style}")
        print(f"Aspect Ratio: {aspect_ratio}")
        print(f"Employees: {len(names)} ({', '.join(names[:4])})")
        print(f"Achievements: {len(achievements)}")
        print("=" * 70 + "\n")

        # Create working directory
        transaction_uuid = str(uuid.uuid4())
        uuid_path = os.path.join(hls_uploads_path, transaction_uuid)
        output_folder = os.path.join(uuid_path, "output_folder")
        os.makedirs(output_folder, exist_ok=True)

        # Process employee photos into raw base64 (strip data URL headers)
        employee_photos_b64 = []
        for idx, photo_data in enumerate(images[:4]):
            if photo_data:
                try:
                    if "," in photo_data:
                        header, encoded = photo_data.split(",", 1)
                        employee_photos_b64.append(encoded)
                    else:
                        employee_photos_b64.append(photo_data)
                    print(f"✅ Employee photo {idx + 1} ({names[idx]}): {len(employee_photos_b64[-1])} chars (base64)")
                except Exception as e:
                    logging.exception(f"Failed to process employee photo {idx + 1}: {e}")
                    employee_photos_b64.append(None)
            else:
                employee_photos_b64.append(None)

        # Ensure we have employee photos
        if not any(employee_photos_b64):
            return JSONResponse({
                "success": False,
                "error": "Failed to process employee photos. Please try again."
            }, status_code=400)

        # Compute deterministic placeholder positions — the single source of
        # truth shared by the prompt (so the model leaves them empty) and the
        # later compositing step (so the real photos land in the same spot).
        canvas_w, canvas_h = ASPECT_CANVAS_DIMENSIONS.get(aspect_ratio, ASPECT_CANVAS_DIMENSIONS["16:9"])
        slots = compute_employee_slots(canvas_w, canvas_h, len(names))

        # Generate comprehensive TEXT-ONLY prompt — no employee photo is ever
        # attached to this request, so the model cannot touch a face.
        print("\n🧠 Generating comprehensive banner prompt (text only, no face input)...\n")

        prompt = generate_comprehensive_banner_prompt(
            title=title,
            description=description,
            template_id=template,
            theme=theme,
            background_style=background_style,
            employee_names=names[:4],
            employee_achievements=achievements[:4],
            aspect_ratio=aspect_ratio,
            slots=slots,
            canvas_w=canvas_w,
            canvas_h=canvas_h,
        )

        print(f"✅ Prompt generated ({len(prompt)} characters)\n")

        # Call the image LLM to generate the background/layout ONLY
        print("🎨 Sending to image model for background + layout generation...\n")

        banner_background_bytes = await generate_sales_banner_background(
            prompt=prompt,
            db=db,
        )

        if not banner_background_bytes:
            raise ValueError("Image model returned no image data")

        # Recompute slots against the ACTUAL returned image dimensions (the
        # model may not return the exact requested pixel size) so photos are
        # still placed proportionally correctly, then composite the real,
        # unmodified employee photos into the banner.
        with Image.open(io.BytesIO(banner_background_bytes)) as bg_probe:
            actual_w, actual_h = bg_probe.size
        actual_slots = compute_employee_slots(actual_w, actual_h, len(names))

        print(f"\n🖼️  Compositing {len([p for p in employee_photos_b64 if p])} original employee photo(s) into banner (pixels untouched by model)...\n")

        banner_image_bytes = composite_employee_photos(
            banner_bytes=banner_background_bytes,
            employee_photos_b64=employee_photos_b64[:4],
            slots=actual_slots,
        )

        if not banner_image_bytes:
            raise ValueError("Failed to composite employee photos into banner")

        # Save generated banner
        ratio_tag = aspect_ratio.replace(':', 'x')
        base_filename = f"sales_banner_{template}_{ratio_tag}"

        counter = 1
        file_name = f"{base_filename}.png"
        file_path = os.path.join(output_folder, file_name)

        while os.path.exists(file_path):
            counter += 1
            file_name = f"{base_filename}_{counter}.png"
            file_path = os.path.join(output_folder, file_name)

        with open(file_path, 'wb') as f:
            f.write(banner_image_bytes)

        print(f"\n✅ Complete banner saved: {file_path}")
        print(f"   File size: {len(banner_image_bytes)} bytes\n")

        # Return as base64 JSON
        encoded = base64.b64encode(banner_image_bytes).decode("utf-8")

        return JSONResponse({
            "success": True,
            "filename": f"{re.sub(r'[^a-zA-Z0-9]+', '_', title).strip('_').lower() or 'sales_banner'}.png",
            "image_base64": encoded,
            "mime_type": "image/png",
            "template": template,
            "download_url": None,
        }, status_code=200)

    except ValueError as ve:
        logging.exception(f"Validation error: {ve}")
        return JSONResponse({
            "success": False,
            "error": str(ve)
        }, status_code=400)

    except Exception as exc:
        logging.exception(f"Banner generation failed: {exc}")
        return JSONResponse({
            "success": False,
            "error": f"Banner generation failed: {str(exc)}"
        }, status_code=500)


