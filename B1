"""Zensar Banner Studio — API.

Pipeline:
    brief -> planner (Gemini text) -> BannerSpec
          -> image model (Gemini image) -> artwork
          -> composer (Pillow) -> locked logos + type -> final PNG
"""

import base64
import json
import uuid
from pathlib import Path

from fastapi import FastAPI, HTTPException, UploadFile, File
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from fastapi.staticfiles import StaticFiles

from config import (
    ALLOWED_ORIGINS,
    BRAND,
    BRAND_DIR,
    CANVAS_SIZES,
    GEMINI_API_KEY,
    OUTPUT_DIR,
)
from models import (
    BannerSpec,
    EditRequest,
    GenerateRequest,
    GenerateResponse,
    TemplateInfo,
)
from services import composer, image_gen, prompt_engine, templates

app = FastAPI(title="Zensar Banner Studio", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=ALLOWED_ORIGINS,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.mount("/media", StaticFiles(directory=OUTPUT_DIR), name="media")


def _save(banner_id: str, suffix: str, data: bytes) -> str:
    path = OUTPUT_DIR / f"{banner_id}-{suffix}.png"
    path.write_bytes(data)
    return f"/media/{path.name}"


def _record(banner_id: str, spec: BannerSpec) -> None:
    (OUTPUT_DIR / f"{banner_id}-spec.json").write_text(spec.model_dump_json(indent=2))


def _load_spec(banner_id: str) -> BannerSpec:
    path = OUTPUT_DIR / f"{banner_id}-spec.json"
    if not path.exists():
        raise HTTPException(404, f"No banner found with id {banner_id}")
    return BannerSpec(**json.loads(path.read_text()))


@app.get("/api/health")
def health():
    missing = [
        name
        for name in (BRAND["logo_dark"], BRAND["logo_light"], BRAND["footer_dark"])
        if not (BRAND_DIR / name).exists()
    ]
    return {
        "status": "ok",
        "brand": BRAND["name"],
        "planner_ready": bool(GEMINI_API_KEY),
        "image_model_ready": bool(GEMINI_API_KEY),
        "missing_brand_assets": missing,
        "aspect_ratios": list(CANVAS_SIZES),
    }


@app.get("/api/templates", response_model=list[TemplateInfo])
def list_templates():
    return templates.listing()


@app.post("/api/plan")
def plan_only(payload: GenerateRequest):
    """Interpret a brief without spending an image generation."""
    spec, warnings = prompt_engine.plan(payload.brief, payload.overrides)
    return {"spec": spec, "warnings": warnings}


@app.post("/api/brand-asset")
async def upload_brand_asset(slot: str, file: UploadFile = File(...)):
    """Install a logo. slot is one of logo_dark, logo_light, footer_dark, footer_light."""
    if slot not in ("logo_dark", "logo_light", "footer_dark", "footer_light"):
        raise HTTPException(400, "Unknown brand slot.")
    if not (file.content_type or "").startswith("image/"):
        raise HTTPException(400, "Brand assets must be PNG or SVG-exported PNG.")
    target = BRAND_DIR / BRAND[slot]
    target.write_bytes(await file.read())
    return {"slot": slot, "stored_as": target.name}


@app.post("/api/generate", response_model=GenerateResponse)
def generate_banner(payload: GenerateRequest):
    warnings: list[str] = []

    if payload.spec is not None:
        spec = payload.spec
        if payload.overrides:
            clean = {k: v for k, v in payload.overrides.items() if v not in (None, "")}
            spec = spec.model_copy(update=clean)
    else:
        if not payload.brief.strip() and payload.mode == "create":
            raise HTTPException(400, "Describe the banner you want, or send a spec.")
        spec, warnings = prompt_engine.plan(payload.brief, payload.overrides)

    inputs: list[str] = []
    if payload.mode == "reference" and payload.reference_image:
        inputs.append(payload.reference_image)
    if payload.background_image:
        inputs.append(payload.background_image)
    if payload.person_image:
        inputs.append(payload.person_image)

    prompt = prompt_engine.visual_prompt(spec, has_person=bool(payload.person_image))
    if payload.mode == "reference":
        instruction = payload.reference_instruction or (
            "Match the composition, lighting and visual style of the reference image."
        )
        prompt = (
            f"{prompt} Reference handling: {instruction} "
            f"Copy layout and style from the reference, not its text or logos."
        )

    try:
        visual = image_gen.generate(
            prompt,
            aspect_ratio=spec.aspect_ratio,
            quality=payload.quality,
            images_b64=inputs,
        )
    except image_gen.ImageGenError as exc:
        raise HTTPException(502, str(exc)) from exc

    banner_id = uuid.uuid4().hex[:12]
    final, compose_warnings = composer.compose(visual, spec, BRAND_DIR)

    visual_url = _save(banner_id, "visual", visual)
    image_url = _save(banner_id, "banner", final)
    _record(banner_id, spec)

    return GenerateResponse(
        banner_id=banner_id,
        image_url=image_url,
        visual_url=visual_url,
        spec=spec,
        template=spec.template,
        warnings=warnings + compose_warnings,
    )


@app.post("/api/edit", response_model=GenerateResponse)
def edit_banner(payload: EditRequest):
    """Re-run only the artwork through the image model, then recompose."""
    spec = _load_spec(payload.banner_id)
    source = OUTPUT_DIR / f"{payload.banner_id}-visual.png"
    if not source.exists():
        raise HTTPException(404, "Original artwork is gone — generate the banner again.")

    encoded = base64.b64encode(source.read_bytes()).decode()
    try:
        visual = image_gen.edit(
            prompt_engine.edit_prompt(payload.instruction, payload.keep_text), encoded
        )
    except image_gen.ImageGenError as exc:
        raise HTTPException(502, str(exc)) from exc

    banner_id = uuid.uuid4().hex[:12]
    final, warnings = composer.compose(visual, spec, BRAND_DIR)
    visual_url = _save(banner_id, "visual", visual)
    image_url = _save(banner_id, "banner", final)
    _record(banner_id, spec)

    return GenerateResponse(
        banner_id=banner_id,
        image_url=image_url,
        visual_url=visual_url,
        spec=spec,
        template=spec.template,
        warnings=warnings,
    )


@app.post("/api/recompose", response_model=GenerateResponse)
def recompose(payload: EditRequest):
    """Change text or template without re-generating artwork — instant and free."""
    spec = _load_spec(payload.banner_id)
    source = OUTPUT_DIR / f"{payload.banner_id}-visual.png"
    if not source.exists():
        raise HTTPException(404, "Original artwork is gone — generate the banner again.")
    updates = json.loads(payload.instruction) if payload.instruction.strip().startswith("{") else {}
    spec = spec.model_copy(update={k: v for k, v in updates.items() if v not in (None, "")})

    banner_id = uuid.uuid4().hex[:12]
    final, warnings = composer.compose(source.read_bytes(), spec, BRAND_DIR)
    _save(banner_id, "visual", source.read_bytes())
    image_url = _save(banner_id, "banner", final)
    _record(banner_id, spec)
    return GenerateResponse(
        banner_id=banner_id,
        image_url=image_url,
        visual_url=f"/media/{banner_id}-visual.png",
        spec=spec,
        template=spec.template,
        warnings=warnings,
    )


@app.exception_handler(Exception)
def unhandled(request, exc):  # keeps the UI's error surface predictable
    return JSONResponse(status_code=500, content={"detail": f"{type(exc).__name__}: {exc}"})

