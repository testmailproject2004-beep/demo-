"""Deterministic banner composition.

The AI supplies artwork. This module supplies everything that must be exact:
type, spacing, the accent rule, and the two logo positions. Same spec in,
same pixels out.
"""

import io
from pathlib import Path
from typing import Optional, Tuple

from PIL import Image, ImageDraw, ImageFont

from config import BRAND, CANVAS_SIZES, COLORS, FONT_DIR, FONTS
from models import BannerSpec
from services import templates
from services.templates import FOOTER_ZONE, LOGO_ZONE

_FALLBACKS = {
    "display": [
        # Linux
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        # Windows
        "C:/Windows/Fonts/segoeuib.ttf",
        "C:/Windows/Fonts/arialbd.ttf",
        # macOS
        "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
        "/Library/Fonts/Arial Bold.ttf",
    ],
    "body": [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "C:/Windows/Fonts/segoeui.ttf",
        "C:/Windows/Fonts/arial.ttf",
        "/System/Library/Fonts/Supplemental/Arial.ttf",
        "/Library/Fonts/Arial.ttf",
    ],
    "label": [
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
        "C:/Windows/Fonts/consolab.ttf",
        "C:/Windows/Fonts/consola.ttf",
        "/System/Library/Fonts/Supplemental/Courier New Bold.ttf",
        "/Library/Fonts/Courier New Bold.ttf",
    ],
}


def _font(role: str, size: int) -> ImageFont.FreeTypeFont:
    """Use the brand font if installed in assets/fonts, else a system fallback
    of the right weight for the role.

    IMPORTANT: if none of these paths resolve, Pillow's bitmap default font
    is used, which ignores `size` entirely and always renders tiny — that is
    almost always the cause of banner text looking shrunk. Install a real
    .ttf in assets/fonts (see FONTS in config.py) to guarantee this never
    happens, regardless of the host OS.
    """
    candidate = FONT_DIR / FONTS.get(role, "")
    fallbacks = _FALLBACKS.get(role, _FALLBACKS["body"])
    paths = [candidate] + [Path(p) for p in fallbacks]
    for path in paths:
        try:
            font = ImageFont.truetype(str(path), size)
            # Variable fonts (e.g. IBM Plex Sans) default to whatever
            # instance the file ships with. Pin body text to Regular
            # explicitly so it can't silently render bold or light.
            if role == "body":
                try:
                    if b"Regular" in font.get_variation_names():
                        font.set_variation_by_name("Regular")
                except Exception:
                    pass
            return font
        except Exception:
            continue
    try:
        # Pillow >= 10.1 can scale its bundled default font to `size`.
        # Better than the fixed-size bitmap fallback, but still not the
        # brand font — this path should be rare once a real .ttf is found.
        return ImageFont.load_default(size=size)
    except TypeError:
        return ImageFont.load_default()


def _cover(image: Image.Image, size: Tuple[int, int]) -> Image.Image:
    """Scale and crop to fill the canvas without distortion."""
    target_w, target_h = size
    scale = max(target_w / image.width, target_h / image.height)
    resized = image.resize(
        (max(1, round(image.width * scale)), max(1, round(image.height * scale))),
        Image.LANCZOS,
    )
    left = (resized.width - target_w) // 2
    top = (resized.height - target_h) // 2
    return resized.crop((left, top, left + target_w, top + target_h))


def _scrim(canvas: Image.Image, layout: dict, text_side: str) -> Image.Image:
    """Darken the type side so text always meets contrast, whatever the artwork."""
    config = layout.get("scrim") or {}
    if not config:
        return canvas
    width, height = canvas.size
    overlay = Image.new("RGBA", (width, height), (0, 0, 0, 0))
    side = config["side"]
    peak = int(255 * config.get("opacity", 0.8))
    ink = COLORS["ink"]

    if side == "panel":
        panel_w = round(config["width"] * width)
        overlay.paste((*COLORS["navy"], 255), (0, 0, panel_w, height))
    elif side == "full":
        overlay.paste((*ink, peak), (0, 0, width, height))
    else:
        span = round(config["width"] * width)
        gradient = Image.new("L", (span, 1))
        for x in range(span):
            fade = 1 - (x / span) ** 1.4
            gradient.putpixel((x, 0), int(peak * fade))
        gradient = gradient.resize((span, height))
        if side == "right":
            gradient = gradient.transpose(Image.FLIP_LEFT_RIGHT)
            box = (width - span, 0)
        else:
            box = (0, 0)
        tint = Image.new("RGBA", (span, height), (*ink, 255))
        tint.putalpha(gradient)
        overlay.alpha_composite(tint, box)

    return Image.alpha_composite(canvas.convert("RGBA"), overlay)


def _wrap(draw, text: str, font, max_width: int) -> list[str]:
    lines, current = [], ""
    for word in text.split():
        trial = f"{current} {word}".strip()
        if draw.textlength(trial, font=font) <= max_width or not current:
            current = trial
        else:
            lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines


def _fit_text(draw, text: str, role: str, box, start_size: int, min_size: int):
    """Shrink until the wrapped block fits the box. Returns (font, lines)."""
    _, _, box_w, box_h = box
    size = start_size
    while size > min_size:
        font = _font(role, size)
        lines = _wrap(draw, text, font, box_w)
        line_h = size * 1.18
        if len(lines) * line_h <= box_h:
            return font, lines
        size -= 2
    font = _font(role, min_size)
    return font, _wrap(draw, text, font, box_w)


def _draw_block(draw, text, role, box, size, color, align="left", min_size=14):
    if not text:
        return 0
    x, y, box_w, _ = box
    font, lines = _fit_text(draw, text, role, box, size, min_size)
    line_h = round(font.size * 1.18)
    for index, line in enumerate(lines):
        offset = 0
        if align == "center":
            offset = (box_w - draw.textlength(line, font=font)) / 2
        elif align == "right":
            offset = box_w - draw.textlength(line, font=font)
        draw.text((x + offset, y + index * line_h), line, font=font, fill=color)
    return len(lines) * line_h


def _place_logo(canvas: Image.Image, filename: str, zone, brand_dir: Path) -> bool:
    """Paste a brand asset inside a fixed zone, preserving its aspect ratio."""
    path = brand_dir / filename
    if not path.exists():
        return False
    logo = Image.open(path).convert("RGBA")
    width, height = canvas.size
    zx, zy, zw, zh = templates.px(zone, width, height)
    scale = min(zw / logo.width, zh / logo.height)
    logo = logo.resize((max(1, round(logo.width * scale)), max(1, round(logo.height * scale))), Image.LANCZOS)
    # Right-aligned, vertically centred within the zone.
    x = zx + zw - logo.width
    y = zy + (zh - logo.height) // 2
    canvas.alpha_composite(logo, (x, y))
    return True


def _logo_fallback(draw, canvas, zone, text: str, on_dark: bool):
    width, height = canvas.size
    zx, zy, zw, zh = templates.px(zone, width, height)
    font = _font("display", max(18, round(zh * 0.62)))
    color = COLORS["paper"] if on_dark else COLORS["ink"]
    text_w = draw.textlength(text, font=font)
    draw.text((zx + zw - text_w, zy + (zh - font.size) / 2), text, font=font, fill=color)


def _is_dark(canvas: Image.Image, zone) -> bool:
    width, height = canvas.size
    zx, zy, zw, zh = templates.px(zone, width, height)
    patch = canvas.convert("RGB").crop((zx, zy, zx + zw, zy + zh)).resize((8, 8))
    pixels = list(patch.getdata())
    luma = sum(0.2126 * r + 0.7152 * g + 0.0722 * b for r, g, b in pixels) / len(pixels)
    return luma < 128


def compose(visual: bytes, spec: BannerSpec, brand_dir: Path) -> Tuple[bytes, list[str]]:
    """Render the final banner. Returns PNG bytes and warnings."""
    warnings: list[str] = []
    layout = templates.get(spec.template)
    size = CANVAS_SIZES.get(spec.aspect_ratio, CANVAS_SIZES["16:9"])
    width, height = size

    artwork = Image.open(io.BytesIO(visual)).convert("RGB")
    canvas = _cover(artwork, size)
    canvas = _scrim(canvas, layout, spec.text_position).convert("RGBA")
    draw = ImageDraw.Draw(canvas)

    align = "center" if spec.text_position == "center" else "left"
    title_box = templates.px(layout["title_box"], width, height)
    body_box = templates.px(layout["body_box"], width, height)
    cta_box = templates.px(layout["cta_box"], width, height)

    # Accent rule: a short crimson bar above the headline.
    if layout.get("accent_rule"):
        rx, ry, rw, _ = title_box
        bar_w, bar_h = round(width * 0.048), max(4, round(height * 0.007))
        bar_x = rx + (rw - bar_w) / 2 if align == "center" else rx
        draw.rectangle(
            [bar_x, ry - bar_h * 4, bar_x + bar_w, ry - bar_h * 3],
            fill=COLORS["crimson"],
        )

    _draw_block(
        draw, spec.title, "display", title_box,
        round(height * layout["title_size"]), COLORS["paper"], align, min_size=28,
    )
    _draw_block(
        draw, spec.description, "body", body_box,
        round(height * layout["body_size"]), (214, 216, 220), align, min_size=16,
    )

    if spec.cta:
        cx, cy, cw, ch = cta_box
        font = _font("label", round(height * 0.022))
        pad_x, pad_y = round(width * 0.018), round(height * 0.016)
        text_w = draw.textlength(spec.cta.upper(), font=font)
        button_w = min(cw, text_w + pad_x * 2)
        button_h = min(ch, font.size + pad_y * 2)
        bx = cx + (cw - button_w) / 2 if align == "center" else cx
        draw.rectangle([bx, cy, bx + button_w, cy + button_h], fill=COLORS["crimson"])
        draw.text(
            (bx + (button_w - text_w) / 2, cy + (button_h - font.size) / 2 - 2),
            spec.cta.upper(), font=font, fill=COLORS["paper"],
        )

    # Locked brand marks. Identical coordinates on every banner.
    for zone, light, dark, label in (
        (LOGO_ZONE, BRAND["logo_light"], BRAND["logo_dark"], BRAND["name"]),
        (FOOTER_ZONE, BRAND["footer_light"], BRAND["footer_dark"], BRAND["name"]),
    ):
        on_dark = _is_dark(canvas, zone)
        filename = light if on_dark else dark
        if not _place_logo(canvas, filename, zone, brand_dir):
            if not _place_logo(canvas, light if on_dark else dark, zone, brand_dir):
                _logo_fallback(draw, canvas, zone, label, on_dark)
                warnings.append(
                    f"Brand asset '{filename}' not found in assets/brand — drew a text mark instead."
                )

    buffer = io.BytesIO()
    canvas.convert("RGB").save(buffer, format="PNG", optimize=True)
    return buffer.getvalue(), warnings





"""Configuration. Everything model-related is env-overridable on purpose:
Google renames image models often, so nothing is hard-coded in the pipeline."""

import os
from pathlib import Path

from dotenv import load_dotenv

BASE_DIR = Path(__file__).resolve().parent

# Load backend/.env before anything below reads os.getenv(). Uvicorn does not
# do this automatically — without it, GEMINI_API_KEY is always empty even
# when the .env file is filled in correctly.
load_dotenv(BASE_DIR / ".env")

ASSET_DIR = BASE_DIR / "assets"
BRAND_DIR = ASSET_DIR / "brand"
FONT_DIR = ASSET_DIR / "fonts"
OUTPUT_DIR = BASE_DIR / "outputs"

for _d in (BRAND_DIR, FONT_DIR, OUTPUT_DIR):
    _d.mkdir(parents=True, exist_ok=True)

