import type { TemplateInfo } from "../types";

interface Props {
  templates: TemplateInfo[];
  value: string;
  onChange: (id: string) => void;
}

/** A miniature of the layout, drawn from the template's own positions. */
function Wireframe({ text, subject }: { text: string; subject: string }) {
  const textX = text === "left" ? 6 : text === "center" ? 20 : 34;
  const subjectX = subject === "left" ? 4 : subject === "center" ? 24 : 44;
  return (
    <svg className="tpl__wire" viewBox="0 0 72 40" aria-hidden="true">
      <rect x="0.5" y="0.5" width="71" height="39" className="tpl__frame" />
      {subject !== "none" && (
        <rect x={subjectX} y="6" width="24" height="28" className="tpl__subject" />
      )}
      <rect x={textX} y="14" width="26" height="4" className="tpl__title" />
      <rect x={textX} y="21" width="20" height="2.5" className="tpl__body" />
      <rect x={textX} y="25.5" width="16" height="2.5" className="tpl__body" />
      <rect x="54" y="4" width="14" height="4" className="tpl__logo" />
      <rect x="52" y="32" width="16" height="4" className="tpl__logo" />
    </svg>
  );
}

export default function TemplatePicker({ templates, value, onChange }: Props) {
  return (
    <div className="field">
      <label className="field__label">Layout</label>
      <div className="tpl__grid">
        {templates.map((template) => (
          <button
            key={template.id}
            className={`tpl ${value === template.id ? "is-active" : ""}`}
            onClick={() => onChange(template.id)}
            title={template.description}
          >
            <Wireframe
              text={template.text_position}
              subject={template.subject_position}
            />
            <span className="tpl__name">{template.name}</span>
          </button>
        ))}
      </div>
    </div>
  );
}

