    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    
@sales_content_factory_router.post('/sales/presentation_plus/generate')
async def sales_generate_presentation_plus(request: Request, background_tasks: BackgroundTasks, db: AsyncSession = Depends(get_session)):
    try:
        data = await request.json()
        domain = request.query_params.get("domain")

        user_id = data.get('userId') or data.get('user_id')
        user_name = data.get('userName') or data.get('user_name', 'Unknown User')

        # fallback user_id from token
        if not user_id or not str(user_id).isdigit() or str(user_id) in ["null", "unknown_user", "None"]:
            auth_header = request.headers.get('Authorization')
            if auth_header and auth_header.startswith('Bearer '):
                token = auth_header.split(' ', 1)[1]
                import jwt as pyjwt
                try:
                    jwt_secret_key = settings.jwt.secret_key
                    decoded = pyjwt.decode(token, jwt_secret_key, algorithms=["HS256"])
                    sub = decoded.get('sub')

                    if sub:
                        q = text("SELECT id, name FROM user_entity WHERE email = :email")
                        result = await db.execute(q, {"email": sub})
                        r = result.mappings().first()

                        if r:
                            user_id = str(r["id"])
                            if user_name == "Unknown User":
                                user_name = r["name"]

                except Exception as e:
                    print("Token decode failed:", e)

        transaction_uuid = data.get('transaction_uuid')
        output_folder = data.get('output_folder')
        format_type = data.get('format_type', 'presentation +')
        downloaded_files = data.get('downloaded_files')
        input_folder = data.get('input_folder')
        presentation_options = data.get('presentation_options', {})

        # Always create a new UUID for Presentation + to avoid clashing with normal presentation
        transaction_uuid = str(uuid.uuid4())

        uuid_path = os.path.join(hls_uploads_path, transaction_uuid)

        if not input_folder:
            input_folder = os.path.join(uuid_path, "input_folder")
            os.makedirs(input_folder, exist_ok=True)

        if not output_folder:
            output_folder = os.path.join(uuid_path, "output_folder")
            os.makedirs(output_folder, exist_ok=True)

        veeva_file_ids = data.get('veeva_file_ids', [])
        combined_content = data.get('combined_content', '')

        if not combined_content and veeva_file_ids:
            from ..hls_platform.connectors import connector_factory
            from ..hls_platform.connectors.connector_factory import get_connector

            connector = get_connector(connector_factory.get_connector_name_by_domain(domain))
            downloaded_files, combined_content = await connector.download_all_files(db, veeva_file_ids, input_folder)

        status_file = os.path.join(uuid_path, "status.json")

        async def update_step(msg):
            try:
                if os.path.exists(status_file):
                    with open(status_file, "r") as f:
                        data = json.load(f)
                    data["step"] = msg
                    with open(status_file, "w") as f:
                        json.dump(data, f)
            except:
                pass

        async def background_task():
            try:
                with open(status_file, "w") as f:
                    json.dump({
                        "status": "processing",
                        "transaction_uuid": transaction_uuid,
                        "step": "Initializing... (Please wait)"
                    }, f)

                resp = await handle_sales_presentation_plus(
                    db=db,
                    combined_content=combined_content,
                    format_type=format_type,
                    output_folder=output_folder,
                    downloaded_files=downloaded_files,
                    domain=domain,
                    user_id=user_id,
                    user_name=user_name,
                    transaction_uuid=transaction_uuid,
                    input_folder=input_folder,
                    presentation_options=presentation_options,
                    status_callback=update_step
                )

                if resp.status_code == 200:
                    res_data = json.loads(resp.body.decode("utf-8"))
                    with open(status_file, "w") as f:
                        json.dump({
                            "status": "completed",
                            "response_json": res_data,
                            "filepath": res_data.get("filepath"),
                            "filename": res_data.get("filename"),
                            "inputTokens": resp.headers.get('X-Input-Tokens', 0),
                            "outputTokens": resp.headers.get('X-Output-Tokens', 0),
                            "totalCost": resp.headers.get('X-Total-Cost', 0)
                        }, f)
                else:
                    with open(status_file, "w") as f:
                        json.dump({
                            "status": "error",
                            "message": "Failed to generate Presentation+"
                        }, f)

            except Exception as e:
                traceback.print_exc()
                with open(status_file, "w") as f:
                    json.dump({
                        "status": "error",
                        "message": str(e)
                    }, f)

        # run background
        background_tasks.add_task(background_task)

        return JSONResponse(
            status_code=202,
            content={
                "status": "processing",
                "transaction_uuid": transaction_uuid
            }
        )

    except Exception as e:
        traceback.print_exc()
        raise HTTPException(status_code=500, detail=str(e))    


@sales_content_factory_router.post('/content_feedback')
async def sales_submit_content_feedback(request: Request, db: AsyncSession = Depends(get_session)):
    """Store user star-rating and/or text feedback for a Sales CF generated content item.
    Both fields are optional; if the user skips, both will be stored as NULL.
    """
    try:
        data = await request.json() or {}
        domain = request.query_params.get("domain")
        
        transaction_uuid = data.get("transaction_uuid")
        result = await db.execute(
            select(SalesCFeedback).where(
                SalesCFeedback.transaction_uuid == transaction_uuid
            )
        )
        existing = result.scalars().first()


        if existing:
            if data.get('star_rating') is not None:
                existing.star_rating = data.get('star_rating')
            if data.get('feedback_text') is not None:
                existing.feedback_text = data.get('feedback_text')
            feedback_id = existing.id
        else:
            feedback = SalesCFeedback(
                transaction_uuid=transaction_uuid,
                format_type=data.get('format_type'),
                domain=data.get('domain', 'sales'),
                star_rating=data.get('star_rating'),
                feedback_text=data.get('feedback_text'),
                user_id=str(data.get('user_id')) if data.get('user_id') else None,
                user_name=data.get('user_name'),
            )

            db.add(feedback)
            await db.flush()  # To get auto-generated id

            feedback_id = feedback.id
            
        await db.commit()

        return JSONResponse(content={"status": "success", "id": feedback_id}, status_code=200)
    except Exception as e:
        import traceback
        traceback.print_exc()
        return JSONResponse(content={"error": str(e)}, status_code=500)


@sales_content_factory_router.get('/sales-feedback/{transaction_uuid}')
async def sales_get_content_feedback(
    transaction_uuid: str,
    db: AsyncSession = Depends(get_session)
):

    try:
        result = await db.execute(
            select(SalesCFeedback)
            .where(SalesCFeedback.transaction_uuid == transaction_uuid)
            .order_by(SalesCFeedback.created_at.asc())
        )

        records = result.scalars().all()


        if not records:
            raise HTTPException(status_code=404, detail="No feedback found")

        merged_star = None
        merged_text = None
        latest_id = None
        latest_format = None
        latest_created_at = None

        for record in records:
            if record.star_rating is not None:
                merged_star = record.star_rating
            if record.feedback_text is not None:
                merged_text = record.feedback_text
            latest_id = record.id
            latest_format = record.format_type
            latest_created_at = record.created_at

        return {
            "id": latest_id,
            "transaction_uuid": transaction_uuid,
            "format_type": latest_format,
            "star_rating": merged_star,
            "feedback_text": merged_text,
            "created_at": latest_created_at.isoformat() if latest_created_at else None,
        }

    except Exception as e:
        import traceback
        traceback.print_exc()
        raise HTTPException(status_code=500, detail=str(e))        
