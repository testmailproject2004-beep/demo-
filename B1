"""Request/response schemas for the banner studio API."""

from typing import List, Literal, Optional

from pydantic import BaseModel, Field

Mode = Literal["create", "reference", "edit"]
AspectRatio = Literal["16:9", "4:3", "1:1", "4:5", "9:16"]


class BannerSpec(BaseModel):
    """The structured plan Gemini produces from a free-text brief.

    Everything the image model and the composer need lives here, so the
    pipeline stays inspectable: you can log a spec, diff two specs, or let
    the user hand-edit one before rendering.
    """

    title: str = ""
    description: str = ""
    cta: Optional[str] = None
    template: str = "corporate-executive"
    theme: str = "corporate"
    style: str = "premium enterprise technology"
    background: str = "modern technology environment, soft light"
    subject: Optional[str] = "business executive"
    subject_position: Literal["left", "right", "center", "none"] = "right"
    text_position: Literal["left", "right", "center"] = "left"
    color_palette: str = "deep navy, warm white, crimson accent"
    aspect_ratio: AspectRatio = "16:9"
    negative: str = "no text, no logos, no watermarks, no lettering"


class GenerateRequest(BaseModel):
    mode: Mode = "create"
    brief: str = Field("", description="Free-text description of the banner.")
    spec: Optional[BannerSpec] = Field(
        None, description="Skip interpretation and render this spec directly."
    )
    # Advanced-mode overrides applied on top of the interpreted spec.
    overrides: dict = Field(default_factory=dict)
    # Base64 data (no data: prefix) for uploaded assets.
    reference_image: Optional[str] = None
    person_image: Optional[str] = None
    background_image: Optional[str] = None
    reference_instruction: Optional[str] = None
    quality: Literal["fast", "standard", "pro"] = "standard"


class EditRequest(BaseModel):
    banner_id: str
    instruction: str
    keep_text: bool = True


class GenerateResponse(BaseModel):
    banner_id: str
    image_url: str
    visual_url: str
    spec: BannerSpec
    template: str
    warnings: List[str] = Field(default_factory=list)


class TemplateInfo(BaseModel):
    id: str
    name: str
    description: str
    text_position: str
    subject_position: str
    aspect_ratios: List[str]

