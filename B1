"""Configuration. Everything model-related is env-overridable on purpose:
Google renames image models often, so nothing is hard-coded in the pipeline."""

import os
from pathlib import Path

from dotenv import load_dotenv

BASE_DIR = Path(__file__).resolve().parent

# Load backend/.env before anything below reads os.getenv(). Uvicorn does not
# do this automatically — without it, GEMINI_API_KEY is always empty even
# when the .env file is filled in correctly.
load_dotenv(BASE_DIR / ".env")

ASSET_DIR = BASE_DIR / "assets"
BRAND_DIR = ASSET_DIR / "brand"
FONT_DIR = ASSET_DIR / "fonts"
OUTPUT_DIR = BASE_DIR / "outputs"

for _d in (BRAND_DIR, FONT_DIR, OUTPUT_DIR):
    _d.mkdir(parents=True, exist_ok=True)

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY", "")

# Text model that turns a brief into a BannerSpec.
PLANNER_MODEL = os.getenv("PLANNER_MODEL", "gemini-2.5-flash")

# Image models by quality tier. Verify names against the current
# Gemini image-generation docs before deploying.
IMAGE_MODELS = {
    "fast": os.getenv("IMAGE_MODEL_FAST", "gemini-2.5-flash-image"),
    "standard": os.getenv("IMAGE_MODEL_STANDARD", "gemini-3.1-flash-image"),
    "pro": os.getenv("IMAGE_MODEL_PRO", "gemini-3-pro-image"),
}

# Render sizes per aspect ratio. The AI visual is generated at the closest
# supported ratio, then cover-fitted to these exact pixels.
CANVAS_SIZES = {
    "16:9": (1920, 1080),
    "4:3": (1600, 1200),
    "1:1": (1200, 1200),
    "4:5": (1080, 1350),
    "9:16": (1080, 1920),
}

# Brand assets. Drop the client's files in backend/assets/brand/.
BRAND = {
    "name": os.getenv("BRAND_NAME", "Zensar"),
    "logo_light": "logo-white.png",   # for dark backgrounds
    "logo_dark": "logo-black.png",    # for light backgrounds
    "footer_light": "footer-white.png",
    "footer_dark": "footer-black.png",
}

# Locked brand palette. The composer never asks the model for these.
COLORS = {
    "ink": (16, 20, 24),
    "paper": (233, 231, 226),
    "crimson": (214, 0, 46),
    "navy": (22, 38, 61),
    "steel": (107, 116, 128),
}

FONTS = {
    "display": os.getenv("FONT_DISPLAY", "Archivo-Bold.ttf"),
    "body": os.getenv("FONT_BODY", "IBMPlexSans-Regular.ttf"),
    "label": os.getenv("FONT_LABEL", "IBMPlexMono-Medium.ttf"),
}

ALLOWED_ORIGINS = os.getenv(
    "ALLOWED_ORIGINS", "http://localhost:5173,http://127.0.0.1:5173"
).split(",")





