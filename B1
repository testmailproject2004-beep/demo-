DEFAULT_TEMPLATE = "corporate-executive"


def get(template_id: str) -> dict:
    return TEMPLATES.get(template_id, TEMPLATES[DEFAULT_TEMPLATE])


def listing() -> List[dict]:
    return [
        {
            "id": key,
            "name": value["name"],
            "description": value["description"],
            "text_position": value["text_position"],
            "subject_position": value["subject_position"],
            "aspect_ratios": value["aspect_ratios"],
        }
        for key, value in TEMPLATES.items()
    ]


def px(rect, width: int, height: int):
    """Fractional rect -> pixel box (x, y, w, h)."""
    x, y, w, h = rect
    return (round(x * width), round(y * height), round(w * width), round(h * height))
