async def handle_sales_presentation_plus(
    db: AsyncSession,
    combined_content,
    format_type,
    output_folder,
    downloaded_files,
    domain,
    user_id=None,
    user_name=None,
    transaction_uuid=None,
    input_folder=None,
    presentation_options=None,
    workflow_meta=None,
    status_callback=None
):
    try:
        print(f"\n[Presentation +] 🚀 Starting generation for user_id={user_id}, format={format_type}")
        llm = await initialize_llm(db, domain)
        if not llm:
            return JSONResponse(
                content={"error": "Failed to initialize LLM"},
                status_code=500
            )

        opts = presentation_options or {}
        slide_count = opts.get("slide_count", "8-10")

        # Determine Color Strategy
        color_strategy = opts.get("color_strategy", "ai")
        # Legacy fallback if they haven't refreshed frontend
        if color_strategy == "ai" and opts.get("ai_theme") is False:
            color_strategy = "palette"

        design_vibe = opts.get("design_vibe", "Sleek, modern tech presentation with high contrast")
        palette_name = opts.get("palette", "Corporate Slate")

        logo_base64 = opts.get("logo_base64")
        logo_opacity = int(opts.get("logo_opacity", 100))
        logo_position = opts.get("logo_position", "top-right")
        footer_text = opts.get("footer_text", "").strip()

        logo_bytes = None
        if logo_base64:
            try:
                import base64
                from io import BytesIO
                from PIL import Image

                if "," in logo_base64:
                    logo_base64 = logo_base64.split(",")[1]

                img_data = base64.b64decode(logo_base64)
                img = Image.open(BytesIO(img_data)).convert("RGBA")

                if logo_opacity < 100:
                    alpha = img.split()[3]
                    alpha = alpha.point(lambda p: p * (logo_opacity / 100.0))
                    img.putalpha(alpha)

                buffer = BytesIO()
                img.save(buffer, format="PNG")
                logo_bytes = buffer
            except Exception as e:
                print(f"[Presentation +] Failed to process logo: {e}")

        input_tokens = 0
        output_tokens = 0

        # 1. Design Strategy
        if status_callback:
            await status_callback("🎨 Generating design strategy & layout...")

        print(f"[Presentation +] Generating Design Strategy (color_strategy={color_strategy})...")
        if color_strategy in ["ai", "custom", "vibe"]:
            if color_strategy == "ai":
                vibe_prompt = "Create the optimal colors based on the context of this presentation."
            else:
                vibe_prompt = f"Story/Vibe Instructions: {design_vibe}\nBase Palette Guidance: {palette_name}"

            design_data, dt_in, dt_out = run_design_director(llm, combined_content, vibe_prompt)
            input_tokens += dt_in
            output_tokens += dt_out
        else:
            design_data = {
                "theme": get_palette(palette_name),
                "design_strategy": f"Selected palette: {palette_name}"
            }
            print(f"[Presentation +] Using legacy palette: {palette_name}")

        # 2. Content Generation
        if status_callback:
            await status_callback("📝 Crafting presentation narrative...")

        print(f"[Presentation +] Generating Slide Content ({slide_count} slides)...")
        content_data, ct_in, ct_out = run_content_generator(llm, combined_content, design_data, slide_count)
        input_tokens += ct_in
        output_tokens += ct_out

        # Calculate cost for gpt-4o-mini: $0.150/1M input, $0.600/1M output
        total_cost = (input_tokens / 1000000.0) * 0.150 + (output_tokens / 1000000.0) * 0.600

        # Inject styling metadata
        design_data["logo_bytes"] = logo_bytes
        design_data["logo_position"] = logo_position
        design_data["footer_text"] = footer_text

        # 3. Create PPTX using the new engine
        if status_callback:
            await status_callback("⚙️ Rendering PPTX file (this may take a few moments)...")

        print(f"[Presentation +] Rendering PPTX file with {len(content_data.get('slides', []))} slides...")
        prs = create_dynamic_pptx(content_data, design_data)

        # 4. Save and return
        if not transaction_uuid:
            transaction_uuid = str(uuid.uuid4())

        if not output_folder:
            output_folder = tempfile.gettempdir()

        import re
        raw_title = content_data.get("presentation_metadata", {}).get("title", "Dynamic_Presentation")
        clean_title = "".join([c if c.isalnum() else "_" for c in raw_title]).strip("_")
        clean_title = re.sub(r'_+', '_', clean_title)
        clean_title = clean_title[:30] if clean_title else "Dynamic_Presentation"

        out_filename = f"{clean_title}_{transaction_uuid[:8]}.pptx"
        os.makedirs(output_folder, exist_ok=True)
        out_path = os.path.join(output_folder, out_filename)
        prs.save(out_path)
        print(f"[Presentation +] Saved PPTX to: {out_path}")

        safe_design_data = {k: v for k, v in design_data.items() if k != "logo_bytes"}
        res_data = {
            "slides": content_data.get("slides", []),
            "metadata": content_data.get("presentation_metadata", {}),
            "design_strategy": safe_design_data,
            "filename": out_filename,
            "filepath": out_path,
            "transaction_uuid": transaction_uuid
        }

        # Track Transaction
        await upsert_hls_sales_presentation_plus_transaction(
            db=db,
            transaction_uuid=transaction_uuid,
            format_type=format_type,
            out_path=out_path,
            out_filename=out_filename,
            user_id=user_id,
            user_name=user_name,
            domain=domain,
            input_tokens=input_tokens,
            output_tokens=output_tokens,
            total_cost=total_cost,
        )

        # Update user budget metrics
        await update_user_budget_and_log(
            db,
            user_id,
            total_cost,
            model_name="gpt-4o-mini",
            prompt_tokens=input_tokens,
            completion_tokens=output_tokens
        )

        headers = {
            "X-Transaction-UUID": transaction_uuid,
            "X-Input-Tokens": str(input_tokens),
            "X-Output-Tokens": str(output_tokens),
            "X-Total-Cost": str(total_cost),
            "Access-Control-Expose-Headers": "X-Transaction-UUID, X-Input-Tokens, X-Output-Tokens, X-Total-Cost",
        }

        print(f"[Presentation +] 🎉 Successfully completed! Cost: ${total_cost:.4f}, Total Tokens: {input_tokens + output_tokens}\n")

        return JSONResponse(
            content=res_data,
            status_code=200,
            headers=headers
        )

    except Exception as e:
        print(f"❌ handle_sales_presentation_plus error: {e}")
        import traceback
        traceback.print_exc()

        return JSONResponse(
            content={"error": str(e)},
            status_code=500
        )



