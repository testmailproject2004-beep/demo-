    _txt(slide, Inches(11.9), FOOTER_Y + Inches(0.10), Inches(1.1), Inches(0.26), f"{num} / {total}", 10, color, align=PP_ALIGN.RIGHT, wrap=False, font=theme["font"])

def _title_row(slide, theme, text, slide_type="light"):
    color = theme["text_l"] if slide_type == "dark" else theme["primary"]
    _txt(slide, ML, TITLE_Y, BODY_W, TITLE_H, text, 34, color, bold=True, font=theme["font"])


