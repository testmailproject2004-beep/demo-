async def fetch_hls_workflow_runs_by_domain(
    db: AsyncSession,
    domain: str,
) -> List[HLSWorkflowRun]:
    query = select(HLSWorkflowRun)

    if domain != "all":
        domain_list = [d.strip() for d in domain.split(',')]
        filters = [HLSWorkflowRun.domain == d for d in domain_list]
        if domain not in domain_list:
            filters.append(HLSWorkflowRun.domain == domain)
        query = query.where(or_(*filters))

    query = query.order_by(HLSWorkflowRun.started_at.desc())

    result = await db.execute(query)
    return result.scalars().all()


async def fetch_hls_workflow_steps_by_run_ids(
    db: AsyncSession,
    workflow_run_ids: list,
) -> List[HLSWorkflowStep]:
    if not workflow_run_ids:
        return []

    result = await db.execute(
        select(HLSWorkflowStep)
        .where(HLSWorkflowStep.workflow_run_id.in_(workflow_run_ids))
        .order_by(
            HLSWorkflowStep.workflow_run_id.asc(),
            HLSWorkflowStep.step_order.asc(),
        )
    )
    return result.scalars().all()


async def fetch_hls_transactions_by_workflow_run_ids(
    db: AsyncSession,
    workflow_run_ids: list,
) -> List[HLSTransaction]:
    if not workflow_run_ids:
        return []

    result = await db.execute(
        select(HLSTransaction)
        .where(HLSTransaction.workflow_run_id.in_(workflow_run_ids))
        .order_by(HLSTransaction.created_at.asc())
    )
    return result.scalars().all()
