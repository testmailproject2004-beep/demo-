    try:
        query = select(HLSVeevaDocMicrosites).where(
            HLSVeevaDocMicrosites.document_unique_id.in_(doc_ids)
        )

        if domain:
            query = query.where(HLSVeevaDocMicrosites.domain == domain)

        result = await db.execute(query)
        records = result.scalars().all()

        for rec in records:
            sources.append({
                "id": rec.id,
                "document_id": rec.document_unique_id,
                "filename": rec.filename__v or rec.name__v or "",
                "document_path": rec.document_path or "",
                "microsite_path": rec.microsite_path or "",
            })

    except Exception as e:
        print(f"Error fetching sources from DB: {e}")

    return sources


