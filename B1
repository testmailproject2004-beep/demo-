/// <reference types="vite/client" />
// The line above is what makes `import.meta.glob` below type-check. It
// works per-file, independent of whatever's in the project's tsconfig
// "types" array — so this resolves "Property 'glob' does not exist on
// type 'ImportMeta'" without needing any project-wide config change.
import { useEffect, useMemo, useRef, useState } from 'react';
import {
  AlertCircle,
  Check,
  Download,
  ImagePlus,
  Loader,
  Sparkles,
  Wand2,
  X,
} from 'lucide-react';
import { middleware_url } from '../../utils/constants';

// ---------------------------------------------------------------------------
// Template library
// ---------------------------------------------------------------------------
//
// Templates are discovered from src/hls_src/assets/Templates/ automatically
// — no filename or extension needs to be known ahead of time. Drop a new
// image in that folder (any of .jpg/.jpeg/.png/.webp) and it appears in the
// picker on the next build/reload; delete one and it disappears. This
// replaced an earlier version with 11 hardcoded imports, which broke the
// moment a real filename or extension didn't match what had been guessed
// from a photo of the folder.
//
// IMPORTANT: the backend (batch_process/.../hls_platform/assets/Templates)
// keeps its own copy of the same images, used for the actual edit. The id
// derived below (the filename without its extension, e.g. "template-6")
// must exist as a same-stem file on the backend too — extension can differ
// there, the backend searches .jpg/.jpeg/.png/.webp for a given id.
//
// Display names default to a prettified version of the filename. Override
// any of them here without renaming the actual file:
const TEMPLATE_NAME_OVERRIDES: Record<string, string> = {
  // 'template-3': 'Sales Champion',
};

const templateModules = import.meta.glob<{ default: string }>(
  '../assets/Templates/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);

interface BannerTemplate {
  id: string;
  name: string;
  image: string;
}

function idFromPath(path: string): string {
  const filename = path.split('/').pop() ?? path;
  return filename.replace(/\.[^./]+$/, '');
}

function prettify(id: string): string {
  const match = id.match(/^template-(\d+)$/i);
  if (match) return `Template ${match[1]}`;
  return id
    .replace(/[_-]+/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function naturalCompare(a: string, b: string): number {
  return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
}

const TEMPLATE_LIBRARY: BannerTemplate[] = Object.entries(templateModules)
  .map(([path, mod]) => {
    const id = idFromPath(path);
    return {
      id,
      name: TEMPLATE_NAME_OVERRIDES[id] ?? prettify(id),
      image: mod.default,
    };
  })
  .sort((a, b) => naturalCompare(a.id, b.id));

// Matches BANNER_SIZES in banner.py — Gemini's full supported ratio set,
// not a narrower guess of my own. Keeping these two lists in the same
// order/values as that dict means a template's detected native ratio can
// never point at a value the dropdown doesn't actually offer.
const COMMON_RATIOS: Record<string, number> = {
  '1:1': 1,
  '3:2': 3 / 2,
  '2:3': 2 / 3,
  '3:4': 3 / 4,
  '4:3': 4 / 3,
  '4:5': 4 / 5,
  '5:4': 5 / 4,
  '9:16': 9 / 16,
  '16:9': 16 / 9,
  '21:9': 21 / 9,
};

function nearestAspectRatio(width: number, height: number): string {
  const actual = width / height;
  let best = '16:9';
  let bestDelta = Infinity;
  for (const [label, ratio] of Object.entries(COMMON_RATIOS)) {
    const delta = Math.abs(ratio - actual);
    if (delta < bestDelta) {
      best = label;
      bestDelta = delta;
    }
  }
  return best;
}

const aspectRatioOptions = [
  { value: '1:1', label: '1:1 · Square' },
  { value: '3:2', label: '3:2 · Standard landscape' },
  { value: '2:3', label: '2:3 · Standard portrait' },
  { value: '3:4', label: '3:4 · Portrait' },
  { value: '4:3', label: '4:3 · Landscape' },
  { value: '4:5', label: '4:5 · Tall square' },
  { value: '5:4', label: '5:4 · Wide square' },
  { value: '9:16', label: '9:16 · Story / skyscraper' },
  { value: '16:9', label: '16:9 · Widescreen' },
  { value: '21:9', label: '21:9 · Ultra widescreen' },
] as const;

interface HistoryItem {
  title: string;
  time: string;
  image: string;
}

interface SalesBannerGeneratorProps {
  /** Called when the modal is dismissed (X, Cancel). Either prop works. */
  onClose?: () => void;
  onBack?: () => void;
  /**
   * Set to false if you render this inside an existing modal/dialog wrapper,
   * so it doesn't add a second full-screen overlay of its own.
   */
  overlay?: boolean;
}

const labelClass = 'mb-1 block text-[11px] font-semibold uppercase tracking-wider text-slate-500';

const inputClass =
  'w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 transition focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600';

function readFileAsDataUrl(file: File): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(typeof reader.result === 'string' ? reader.result : '');
    reader.onerror = () => reject(new Error('Failed to read image file'));
    reader.readAsDataURL(file);
  });
}

export function SalesBannerGenerator({ onClose, onBack, overlay = true }: SalesBannerGeneratorProps) {
  const handleClose = onClose ?? onBack ?? (() => {});

  // Template list is bundled locally (see TEMPLATE_LIBRARY above) — the
  // picker renders immediately, nothing to fetch or wait on.
  const templates = TEMPLATE_LIBRARY;
  const [selectedTemplateId, setSelectedTemplateId] = useState<string | null>(
    templates[0]?.id ?? null,
  );

  // Core banner fields
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [aspectRatio, setAspectRatio] = useState<string>('16:9');
  const [aspectTouched, setAspectTouched] = useState(false);
  const [prompt, setPrompt] = useState('');

  // Optional photo — if left empty, the backend keeps the person already
  // baked into the template.
  const [photo, setPhoto] = useState<string | null>(null);
  const [photoError, setPhotoError] = useState<string | null>(null);

  // UI state
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [previewUrl, setPreviewUrl] = useState<string | null>(null);
  const [history, setHistory] = useState<HistoryItem[]>([]);
  // Captured from the X-Transaction-UUID response header. Not used yet —
  // your banner.py already has a refine-by-feedback flow keyed on this
  // (handle_banner_refine); if you want the "Anything else to change?"
  // field to hit that instead of a full regenerate, this is what a
  // /banner/refine call would need.
  const [lastTransactionId, setLastTransactionId] = useState<string | null>(null);

  // Object URLs from generated blobs need explicit cleanup, but history
  // thumbnails reference the same URLs as past previews — revoking on
  // every previewUrl change would break old history entries the moment a
  // second banner is generated. Track everything created this session and
  // revoke it only when the modal itself unmounts.
  const objectUrlsRef = useRef<string[]>([]);
  useEffect(() => {
    return () => {
      objectUrlsRef.current.forEach((url) => URL.revokeObjectURL(url));
    };
  }, []);

  // Native aspect ratio per template, probed client-side by loading each
  // image once. Populates progressively; a template selected before its
  // probe resolves just keeps the current aspect ratio until it does.
  const [nativeRatios, setNativeRatios] = useState<Record<string, string>>({});

  useEffect(() => {
    let cancelled = false;
    templates.forEach((template) => {
      const img = new Image();
      img.onload = () => {
        if (cancelled) return;
        const ratio = nearestAspectRatio(img.naturalWidth, img.naturalHeight);
        setNativeRatios((prev) => ({ ...prev, [template.id]: ratio }));
      };
      img.src = template.image;
    });
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const selectedTemplate = useMemo(
    () => templates.find((t) => t.id === selectedTemplateId) ?? null,
    [templates, selectedTemplateId],
  );

  // Once a template's native ratio resolves, adopt it as the default —
  // unless the user already deliberately picked a different one.
  useEffect(() => {
    if (!selectedTemplateId || aspectTouched) return;
    const ratio = nativeRatios[selectedTemplateId];
    if (ratio) setAspectRatio(ratio);
  }, [selectedTemplateId, nativeRatios, aspectTouched]);

  function selectTemplate(template: BannerTemplate) {
    setSelectedTemplateId(template.id);
    if (!aspectTouched && nativeRatios[template.id]) {
      setAspectRatio(nativeRatios[template.id]);
    }
  }

  async function handlePhotoUpload(file: File | null) {
    if (!file) return;
    if (!['image/png', 'image/jpeg', 'image/jpg', 'image/webp'].includes(file.type)) {
      setPhotoError('Only PNG, JPG, or WEBP files are supported');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      setPhotoError('Image size must be under 10MB');
      return;
    }
    try {
      setPhoto(await readFileAsDataUrl(file));
      setPhotoError(null);
    } catch {
      setPhotoError('Failed to read image file');
    }
  }

  async function generateBanner() {
    if (!selectedTemplateId) {
      setError('Pick a template first');
      return;
    }
    if (!title.trim() && !description.trim() && !prompt.trim()) {
      setError('Add a title, description, or instruction so there is something to change');
      return;
    }

    setLoading(true);
    setError(null);

    try {
      const token = localStorage.getItem('token');
      const payload = {
        template_id: selectedTemplateId,
        title: title.trim(),
        description: description.trim(),
        prompt: prompt.trim(),
        aspect_ratio: aspectRatio,
        photo, // null keeps the person already in the template
      };

      const response = await fetch(
        `${middleware_url}/batch_process/sales_platform/banner/generate`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(payload),
        },
      );

      if (!response.ok) {
        // Error responses are JSON ({"success": false, "error": "..."}),
        // even though a successful response is raw image bytes.
        let message = 'Banner generation failed';
        try {
          const errBody = await response.json();
          message = errBody.detail || errBody.error || errBody.message || message;
        } catch {
          /* response wasn't JSON either — keep the generic message */
        }
        throw new Error(message);
      }

      const blob = await response.blob();
      if (blob.size === 0) throw new Error('No banner image returned by the server');

      const bannerImage = URL.createObjectURL(blob);
      objectUrlsRef.current.push(bannerImage);
      const transactionId = response.headers.get('X-Transaction-UUID');
      setPreviewUrl(bannerImage);
      setLastTransactionId(transactionId);

      setHistory((prev) =>
        [
          {
            title: title.trim() || selectedTemplate?.name || 'Banner',
            time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            image: bannerImage,
          },
          ...prev,
        ].slice(0, 6),
      );
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to generate banner');
    } finally {
      setLoading(false);
    }
  }

  function downloadBanner() {
    if (!previewUrl) return;
    const link = document.createElement('a');
    link.href = previewUrl;
    link.download = `sales-banner-${Date.now()}.png`;
    link.click();
  }

  const card = (
    <div className="flex max-h-[94vh] w-full max-w-3xl flex-col overflow-hidden rounded-xl bg-white text-sm text-slate-900 antialiased shadow-2xl">
      {/* ===== Header ===== */}
      <div className="flex items-center justify-between px-5 py-3">
        <div>
          <div className="text-lg font-bold leading-tight text-slate-900">Banner Generator</div>
          <div className="mt-0.5 text-xs leading-tight text-slate-500">
            Edits one of the approved templates — layout and logo stay locked
          </div>
        </div>
        <button
          type="button"
          onClick={handleClose}
          aria-label="Close"
          className="rounded-md p-1 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
        >
          <X size={18} />
        </button>
      </div>
      <div className="border-b border-blue-100" />

      {/* ===== Scrollable body ===== */}
      <div className="flex-1 space-y-5 overflow-y-auto px-5 py-4">
        {/* Template picker */}
        <section>
          <div className="mb-2 text-sm font-semibold leading-tight text-slate-900">
            Choose a template
          </div>

          <div className="grid grid-cols-3 gap-2.5 sm:grid-cols-4">
            {templates.map((template) => {
              const active = template.id === selectedTemplateId;
              return (
                <button
                  key={template.id}
                  type="button"
                  onClick={() => selectTemplate(template)}
                  className={`group relative overflow-hidden rounded-lg border-2 text-left transition ${
                    active
                      ? 'border-blue-600 ring-2 ring-blue-100'
                      : 'border-slate-200 hover:border-blue-300'
                  }`}
                >
                  <img
                    src={template.image}
                    alt={template.name}
                    className="aspect-[4/3] w-full object-cover"
                    loading="lazy"
                  />
                  {active && (
                    <span className="absolute right-1 top-1 rounded-full bg-blue-600 p-0.5 text-white">
                      <Check size={11} />
                    </span>
                  )}
                  <span className="block truncate bg-white px-1.5 py-1 text-[10.5px] font-medium text-slate-700">
                    {template.name}
                  </span>
                </button>
              );
            })}
          </div>
        </section>

        <br />

        {/* Banner content */}
        <section>
          <div className="mb-2 text-sm font-semibold leading-tight text-slate-900">
            Banner content
          </div>
          <div className="space-y-3">
            <div>
              <label className={labelClass}>Title</label>
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="e.g., Q3 Sales Champion"
                className={inputClass}
              />
            </div>
            <div>
              <label className={labelClass}>Description</label>
              <textarea
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                placeholder="e.g., Congratulations on closing the year with record numbers"
                className={`${inputClass} min-h-[48px] resize-none`}
              />
            </div>
          </div>
        </section>

        <br />

        {/* Photo + aspect ratio */}
        <section>
          <div className="mb-2 text-sm font-semibold leading-tight text-slate-900">
            Person &amp; format
          </div>
          <div className="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
            <div>
              <label className={labelClass}>Photo</label>
              {photo ? (
                <div className="flex items-center gap-2.5">
                  <img
                    src={photo}
                    alt="Uploaded"
                    className="h-11 w-11 rounded-md border border-slate-200 object-cover"
                  />
                  <span className="text-xs text-slate-500">Will replace the template's photo</span>
                  <button
                    type="button"
                    onClick={() => setPhoto(null)}
                    className="ml-auto rounded-md border border-slate-300 bg-white px-2 py-1 text-[11px] font-medium text-slate-600 transition hover:border-red-400 hover:text-red-600"
                  >
                    Remove
                  </button>
                </div>
              ) : (
                <label className="flex cursor-pointer items-center gap-2.5">
                  <span className="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:border-blue-500 hover:text-blue-700">
                    <ImagePlus size={13} />
                    Choose file
                  </span>
                  <input
                    type="file"
                    accept="image/*"
                    className="sr-only"
                    onChange={(e) => void handlePhotoUpload(e.target.files?.[0] || null)}
                  />
                </label>
              )}
              <p className="mt-1 text-[11px] leading-snug text-slate-500">
                Optional — leave empty to keep the person already in the template.
              </p>
              {photoError && <p className="mt-1 text-[11px] text-red-600">{photoError}</p>}
            </div>

            <div>
              <label className={labelClass}>Aspect ratio</label>
              <div className="relative">
                <select
                  value={aspectRatio}
                  onChange={(e) => {
                    setAspectRatio(e.target.value);
                    setAspectTouched(true);
                  }}
                  className="w-full cursor-pointer appearance-none rounded-md border border-slate-300 bg-white px-2.5 py-1.5 pr-8 text-sm text-slate-900 transition focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600"
                >
                  {aspectRatioOptions.map((opt) => (
                    <option key={opt.value} value={opt.value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              </div>
              {selectedTemplateId && nativeRatios[selectedTemplateId] && (
                <p className="mt-1 text-[11px] leading-snug text-slate-500">
                  Template's native ratio is {nativeRatios[selectedTemplateId]}.
                </p>
              )}
            </div>
          </div>
        </section>

        <br />

        {/* Prompt */}
        <section>
          <div className="mb-2 flex items-center gap-1.5 text-sm font-semibold leading-tight text-slate-900">
            <Wand2 size={15} className="text-blue-600" />
            Anything else to change?
          </div>
          <textarea
            value={prompt}
            onChange={(e) => setPrompt(e.target.value)}
            placeholder="Optional — e.g., make the confetti more subtle, use a cooler colour tone"
            className={`${inputClass} min-h-[48px] resize-none`}
          />
          <p className="mt-1 text-[11px] leading-snug text-slate-500">
            Everything else in the template — logo, layout, colours — stays exactly as designed
            unless you mention it here.
          </p>
        </section>

        {/* Preview */}
        {previewUrl && (
          <section>
            <div className="mb-2 flex items-center justify-between">
              <div className="text-sm font-semibold leading-tight text-slate-900">Preview</div>
              <button
                type="button"
                onClick={downloadBanner}
                className="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50"
              >
                <Download size={13} />
                Download PNG
              </button>
            </div>
            <div className="rounded-lg border border-slate-200 bg-slate-50 p-2">
              <img
                src={previewUrl}
                alt="Generated banner"
                className="mx-auto max-h-[280px] w-full rounded-md object-contain shadow-sm"
              />
              {lastTransactionId && (
                <p className="mt-1.5 text-center text-[10px] text-slate-400">
                  Ref {lastTransactionId.slice(0, 8)}
                </p>
              )}
            </div>

            {history.length > 0 && (
              <div className="mt-3">
                <p className="mb-1.5 text-xs text-slate-600">Recent banners</p>
                <div className="grid grid-cols-3 gap-2">
                  {history.map((item, idx) => (
                    <button
                      key={idx}
                      type="button"
                      onClick={() => setPreviewUrl(item.image)}
                      className="group relative overflow-hidden rounded-md border border-slate-200 transition hover:border-blue-500"
                    >
                      <img src={item.image} alt={item.title} className="h-14 w-full object-cover" />
                      <div className="absolute inset-0 flex items-end bg-black/0 p-1.5 transition group-hover:bg-black/30">
                        <span className="truncate text-[10px] font-semibold text-white opacity-0 transition group-hover:opacity-100">
                          {item.title}
                        </span>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </section>
        )}

        {error && (
          <div className="flex items-start gap-2 rounded-md border border-red-200 bg-red-50 p-2.5">
            <AlertCircle size={15} className="mt-0.5 flex-shrink-0 text-red-600" />
            <p className="text-xs font-medium text-red-900">{error}</p>
          </div>
        )}
      </div>

      {/* ===== Footer ===== */}
      <div className="flex items-center justify-between border-t border-slate-200 px-5 py-2.5">
        <button
          type="button"
          onClick={handleClose}
          className="rounded-md px-2.5 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
        >
          Cancel
        </button>
        <button
          type="button"
          onClick={generateBanner}
          disabled={loading || !selectedTemplateId}
          className="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-indigo-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow transition hover:shadow-md disabled:cursor-not-allowed disabled:opacity-60"
        >
          {loading ? (
            <>
              <Loader size={14} className="animate-spin" />
              Generating…
            </>
          ) : (
            <>
              <Sparkles size={14} />
              Generate Banner
            </>
          )}
        </button>
      </div>
    </div>
  );

  if (!overlay) {
    return card;
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3">
      {card}
    </div>
  );
}

