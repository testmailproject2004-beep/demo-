async def append_micro_drama_edited_path_repo(
    db: AsyncSession,
    original_file_path: str,
    edited_file_path: str
):
    try:
        result = await db.execute(
            select(HLSTransaction).where(
                HLSTransaction.output_file_path == original_file_path
            )
        )

        txn = result.scalars().first()

        if not txn:
            return None

        existing = json.loads(txn.edited_file_paths) if txn.edited_file_paths else []
        existing.append(edited_file_path)

        txn.edited_file_paths = json.dumps(existing)

        await db.commit()
        await db.refresh(txn)

        return txn

    except Exception:
        await db.rollback()
        raise


