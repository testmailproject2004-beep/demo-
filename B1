import { useEffect, useRef, useState } from "react";
import BannerStage from "./components/BannerStage";
import ControlDeck from "./components/ControlDeck";
import SpecInspector from "./components/SpecInspector";
import {
  editBanner,
  generateBanner,
  getHealth,
  getTemplates,
  recomposeBanner,
  uploadBrandAsset,
} from "./api";
import type {
  BannerResult,
  BannerSpec,
  Health,
  Mode,
  Quality,
  TemplateInfo,
  Upload,
} from "./types";

export default function App() {
  const [health, setHealth] = useState<Health | null>(null);
  const [templates, setTemplates] = useState<TemplateInfo[]>([]);
  const [mode, setMode] = useState<Mode>("create");
  const [advanced, setAdvanced] = useState(false);
  const [brief, setBrief] = useState("");
  const [overrides, setOverrides] = useState<Partial<BannerSpec>>({});
  const [quality, setQuality] = useState<Quality>("standard");
  const [reference, setReference] = useState<Upload | null>(null);
  const [person, setPerson] = useState<Upload | null>(null);
  const [background, setBackground] = useState<Upload | null>(null);
  const [referenceInstruction, setReferenceInstruction] = useState("");
  const [result, setResult] = useState<BannerResult | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const logoInput = useRef<HTMLInputElement>(null);

  useEffect(() => {
    getHealth().then(setHealth).catch(() => setHealth(null));
    getTemplates().then(setTemplates).catch(() => setTemplates([]));
  }, []);

  function setOverride<K extends keyof BannerSpec>(key: K, value: BannerSpec[K]) {
    setOverrides((current) => ({ ...current, [key]: value }));
  }

  async function run(action: () => Promise<BannerResult>) {
    setBusy(true);
    setError(null);
    try {
      setResult(await action());
    } catch (exception) {
      setError(exception instanceof Error ? exception.message : "Generation failed.");
    } finally {
      setBusy(false);
    }
  }

  const generate = () => {
    if (!brief.trim() && !overrides.title) {
      setError("Add a brief or a headline first.");
      return;
    }
    void run(() =>
      generateBanner({
        mode,
        brief,
        overrides,
        quality,
        reference_image: reference?.base64 ?? null,
        person_image: person?.base64 ?? null,
        background_image: background?.base64 ?? null,
        reference_instruction: referenceInstruction || null,
      }),
    );
  };

  const applyEdit = (instruction: string) => {
    if (!result) return;
    void run(() => editBanner(result.banner_id, instruction));
  };

  const recompose = (updates: Partial<BannerSpec>) => {
    if (!result) return;
    void run(() => recomposeBanner(result.banner_id, updates));
  };

  async function installLogo(file: File | undefined) {
    if (!file) return;
    setError(null);
    try {
      await uploadBrandAsset("logo_dark", file);
      await uploadBrandAsset("footer_dark", file);
      setHealth(await getHealth());
    } catch (exception) {
      setError(exception instanceof Error ? exception.message : "Could not install the logo.");
    }
  }

  const brandGap = (health?.missing_brand_assets.length ?? 0) > 0;

  return (
    <div className="app">
      <header className="masthead">
        <div className="masthead__id">
          <span className="masthead__brand">{health?.brand ?? "Zensar"}</span>
          <span className="masthead__product">Banner Studio</span>
        </div>
        <div className="masthead__status">
          <span className={`dot ${health?.planner_ready ? "dot--live" : "dot--offline"}`} />
          <span className="masthead__statustext">
            {health?.planner_ready ? "Gemini connected" : "Gemini key not set — placeholder artwork"}
          </span>
        </div>
      </header>

      {brandGap && (
        <div className="notice">
          <p className="notice__text">
            The brand marks are not installed yet, so banners carry a text mark in the two locked
            corners. Add the logo once and every banner uses it.
          </p>
          <button className="btn btn--primary" onClick={() => logoInput.current?.click()}>
            Install logo
          </button>
          <input
            ref={logoInput}
            type="file"
            accept="image/png,image/svg+xml"
            hidden
            onChange={(event) => void installLogo(event.target.files?.[0])}
          />
        </div>
      )}

      <main className="workbench">
        <ControlDeck
          mode={mode}
          setMode={setMode}
          advanced={advanced}
          setAdvanced={setAdvanced}
          brief={brief}
          setBrief={setBrief}
          overrides={overrides}
          setOverride={setOverride}
          templates={templates}
          quality={quality}
          setQuality={setQuality}
          reference={reference}
          setReference={setReference}
          person={person}
          setPerson={setPerson}
          background={background}
          setBackground={setBackground}
          referenceInstruction={referenceInstruction}
          setReferenceInstruction={setReferenceInstruction}
          busy={busy}
          onGenerate={generate}
        />

        <div className="workbench__right">
          <BannerStage
            result={result}
            busy={busy}
            error={error}
            onEdit={applyEdit}
            onRegenerate={generate}
          />
          <SpecInspector spec={result?.spec ?? null} busy={busy} onRecompose={recompose} />
        </div>
      </main>
    </div>
  );
}

