@sales_content_factory_router.post("/banner/generate")
async def sales_generate_banner(request: Request, db: AsyncSession = Depends(get_session)):
    """
    Generate an AI-edited sales banner from one of the approved templates.

    Request payload:
    {
        "template_id": "template-6",
        "title": "Q3 Sales Champion",
        "description": "Congratulations on closing the year with record numbers",
        "prompt": "make the confetti more subtle",
        "aspect_ratio": "16:9",
        "photo": "data:image/png;base64,..."   // optional — omit to keep the template's existing photo
    }

    User identity is resolved the same way sales_generate_presentation_plus
    resolves it below — body first, JWT + a user_entity lookup as fallback
    — and passed down as plain parameters rather than re-resolved inside
    the handler.
    """
    data = await request.json()

    user_id = data.get('userId') or data.get('user_id')
    user_name = data.get('userName') or data.get('user_name', 'Unknown User')
    print(f"[banner/generate] user_id from request body: {user_id!r}")

    # fallback user_id from token
    if not user_id or not str(user_id).isdigit() or str(user_id) in ["null", "unknown_user", "None"]:
        auth_header = request.headers.get('Authorization')
        print(f"[banner/generate] no usable user_id in body — Authorization header: "
              f"{'present' if auth_header else 'MISSING'}")
        if auth_header and auth_header.startswith('Bearer '):
            token = auth_header.split(' ', 1)[1]
            import jwt as pyjwt
            sub = None
            try:
                jwt_secret_key = settings.jwt.secret_key
                decoded = pyjwt.decode(token, jwt_secret_key, algorithms=["HS256"])
                sub = decoded.get('sub')
                print(f"[banner/generate] token decoded OK — sub={sub!r}")
            except pyjwt.exceptions.InvalidSignatureError as e:
                # Confirmed via direct testing: this token is well-formed,
                # fresh, and not expired — the signing key just doesn't
                # match settings.jwt.secret_key. That's worth fixing at
                # the source. In the meantime: this decode is only ever
                # used to attribute a Content History row to a user, never
                # to gate access to anything in this handler, so reading
                # sub without verifying the signature is safe here
                # specifically — it is NOT a general "skip auth" pattern.
                print(f"[banner/generate] signature check failed ({e}) — "
                      f"falling back to unverified decode for attribution only")
                try:
                    unverified = pyjwt.decode(token, options={"verify_signature": False})
                    sub = unverified.get('sub')
                    print(f"[banner/generate] unverified decode — sub={sub!r}")
                except Exception as e2:
                    print("[banner/generate] Unverified decode also failed:", e2)
            except Exception as e:
                print("[banner/generate] Token decode failed:", e)

            try:
                if sub:
                    q = text("SELECT id, name FROM user_entity WHERE email = :email")
                    result = await db.execute(q, {"email": sub})
                    r = result.mappings().first()
                    print(f"[banner/generate] user_entity lookup for {sub!r}: "
                          f"{'found id=' + str(r['id']) if r else 'NO MATCH'}")

                    if r:
                        user_id = str(r["id"])
                        if user_name == "Unknown User":
                            user_name = r["name"]

            except Exception as e:
                print("[banner/generate] user_entity lookup failed:", e)
        else:
            print("[banner/generate] no Bearer token present — user_id stays unresolved")

    print(f"[banner/generate] final: user_id={user_id!r} user_name={user_name!r}")
    return await sales_banner_generate_handler(request, db, user_id=user_id, user_name=user_name)


