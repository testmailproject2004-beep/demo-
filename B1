# Content History integration
# ---------------------------------------------------------------------------
#
# ContentHistory.tsx reads from HLSTransaction rows (via
# /batch_process/hls_platform/content_history) — that's what "No history
# yet" means for banners specifically: nothing has ever inserted a row for
# them. It already has a 'banner' case wired up (HeroBannerPreview +
# BannerRefinePanel), built for handle_banner's hero-banner flow — reusing
# format_type="banner" here means zero changes needed on the frontend side.
#
# user_id/user_name are NOT resolved in this file. sales_generate_banner in
# sales_content_factory_routes.py resolves them the same way
# sales_generate_presentation_plus does — request body first, JWT + a
# user_entity lookup as fallback — and passes the result down as plain
# parameters, matching how that route calls handle_sales_presentation_plus.
# This handler just receives whatever the router already resolved.


async def _save_transaction(
    db: AsyncSession,
    transaction_uuid: str,
    template_path: Path,
    output_file_path: Path,
    user_id: Optional[str],
    user_name: str,
) -> None:
    """Insert an HLSTransaction row so this banner shows up in Content
    History. Uses create_hls_transaction from zenseai_content_factory_repo
    — the same generic insert helper other save_*_transaction functions in
    that file ultimately rely on — rather than hand-rolling add/commit,
    so this gets db.refresh() and the same rollback-and-raise behavior for
    free. Best-effort and non-fatal by design: the person is still waiting
    on their actual banner image; a history-save hiccup must never turn
    that into a failed request."""
    if not user_id:
        logger.info(
            f"[{transaction_uuid}] Content History save skipped — no user_id "
            f"passed in from the router."
        )
        print(f"⚠️  [{transaction_uuid}] Content History save skipped — no user_id from router")
        return

    try:
        from ..repository.zenseai_content_factory_repo import create_hls_transaction

        await create_hls_transaction(
            db,
            {
                "uuid": transaction_uuid,
                "format_type": "banner",
                "input_file_paths": json.dumps([str(template_path)]),
                "output_file_path": str(output_file_path),
                "created_by": str(user_id),
                "created_person": str(user_name),
                "domain": "sales",
            },
        )
        logger.info(f"[{transaction_uuid}] Saved to Content History (user_id={user_id})")
        print(f"✅ [{transaction_uuid}] Saved to Content History (user_id={user_id})")
    except Exception as exc:
        # create_hls_transaction already rolls back internally before
        # re-raising, so there's nothing left to clean up here — just log
        # and swallow it, since a history-save failure must not fail the
        # banner response itself.
        logger.warning(f"[{transaction_uuid}] Content History save failed: {exc}")
        print(f"⚠️  [{transaction_uuid}] Content History save failed (banner still generated OK): {exc}")


