async def fetch_hls_content_history_transactions(
    db: AsyncSession,
    domain: str,
) -> List[HLSTransaction]:
    query = select(HLSTransaction).where(
        (HLSTransaction.is_workflow == False)
        | (HLSTransaction.is_workflow == None)
    )

    domain_list = [d.strip() for d in domain.split(',')] if domain != "all" else []

    if domain != "all":
        filters = [HLSTransaction.domain == d for d in domain_list]
        if domain not in domain_list:
            filters.append(HLSTransaction.domain == domain)
        query = query.where(or_(*filters))

    result = await db.execute(query)
    return result.scalars().all()


