def parse_llm_json(resp, log_msg=""):
    text = resp.content.strip()
    if "```json" in text:
        text = text.split("```json")[1].split("```")[0].strip()
    elif "```" in text:
        text = text.split("```")[1].split("```")[0].strip()
    try:
        return json.loads(text), text
    except json.JSONDecodeError as e:
        print(f"JSON Parsing Error {log_msg}: {text}")
        raise ValueError(f"LLM returned invalid JSON {log_msg}: {e}")

def run_design_director(llm, file_content, user_vibe):
