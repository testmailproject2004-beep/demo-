# ══════════════════════════════════════════════════════════════════
#  LAYOUT GRID  (Widescreen 16:9 → 13.333″ × 7.5″)
# ══════════════════════════════════════════════════════════════════
W  = Inches(13.333)   
H  = Inches(7.5)      

ML = Inches(0.8)      
MR = Inches(0.8)      
MT = Inches(0.6)      

FOOTER_H   = Inches(0.4)    
FOOTER_Y   = H - FOOTER_H   

TITLE_Y    = Inches(0.5)    
TITLE_H    = Inches(0.9)    
BODY_Y     = TITLE_Y + TITLE_H + Inches(0.1)
BODY_H     = FOOTER_Y - BODY_Y - Inches(0.2)
BODY_W     = W - ML - MR

# ══════════════════════════════════════════════════════════════════
#  COLOR PARSER
# ══════════════════════════════════════════════════════════════════
def hex_to_rgb(hex_str: str) -> RGBColor:
    """Convert #RRGGBB to RGBColor. Fallback to grey if invalid."""
    try:
        hex_str = hex_str.lstrip('#')
        r = int(hex_str[0:2], 16)
        g = int(hex_str[2:4], 16)
        b = int(hex_str[4:6], 16)
        return RGBColor(r, g, b)
    except Exception:
        return RGBColor(128, 128, 128)

# ══════════════════════════════════════════════════════════════════
#  PRIMITIVE SHAPE / TEXT HELPERS
# ══════════════════════════════════════════════════════════════════

def _rect(slide, left, top, width, height, color, border_color=None):
    sh = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, int(left), int(top), int(width), int(height))
    sh.fill.solid()
    sh.fill.fore_color.rgb = color
    if border_color:
        sh.line.color.rgb = border_color
        sh.line.width = Pt(0.75)
    else:
        sh.line.fill.background()
    return sh

def _txt(slide, left, top, width, height, text, size, color, bold=False, font="Segoe UI", align=PP_ALIGN.LEFT, wrap=True):
    txb = slide.shapes.add_textbox(int(left), int(top), int(width), int(height))
    tf = txb.text_frame
    tf.word_wrap = wrap
    tf.margin_left = tf.margin_right = tf.margin_top = tf.margin_bottom = 0
    p = tf.paragraphs[0]
    p.alignment = align
    run = p.add_run()
    run.text = text
    run.font.name = font
    run.font.size = Pt(size)
    run.font.bold = bold
    run.font.color.rgb = color
    return txb

def _notes(slide, slide_data):
    txt = slide_data.get("speaker_notes", "")
    if txt:
        slide.notes_slide.notes_text_frame.text = txt


# ══════════════════════════════════════════════════════════════════
#  COMMON STRUCTURAL LAYERS
# ══════════════════════════════════════════════════════════════════

def _draw_base(slide, theme, slide_type="light"):
    if slide_type == "dark":
        _rect(slide, 0, 0, W, H, theme["primary"])
        _rect(slide, 0, 0, W, Inches(0.15), theme["accent"])
        _rect(slide, 0, FOOTER_Y, W, FOOTER_H, theme["primary_l"])
    else:
        _rect(slide, 0, 0, W, H, theme["bg_alt"])
        _rect(slide, 0, 0, W, Inches(0.15), theme["accent"])
        _rect(slide, 0, FOOTER_Y, W, FOOTER_H, theme["bg_card"])

def _slide_num(slide, theme, num, total, slide_type="light"):
    color = theme["text_l"] if slide_type == "dark" else theme["text_m"]
    _txt(slide, Inches(11.9), FOOTER_Y + Inches(0.10), Inches(1.1), Inches(0.26), f"{num} / {total}", 10, color, align=PP_ALIGN.RIGHT, wrap=False, font=theme["font"])

def _title_row(slide, theme, text, slide_type="light"):
    color = theme["text_l"] if slide_type == "dark" else theme["primary"]
    _txt(slide, ML, TITLE_Y, BODY_W, TITLE_H, text, 34, color, bold=True, font=theme["font"])


# ══════════════════════════════════════════════════════════════════
#  DYNAMIC LAYOUT BUILDERS
# ══════════════════════════════════════════════════════════════════

def _build_title(prs, sd, theme, total):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    _draw_base(slide, theme, "dark")

    _txt(slide, ML, Inches(2.05), Inches(10.0), Inches(2.1), sd.get("title", "Presentation"), 46, theme["text_l"], bold=True, font=theme["font"])
    _rect(slide, ML, Inches(4.28), Inches(3.2), Inches(0.055), theme["accent"])
    
    sub = sd.get("subtitle", "")
    if sub:
        _txt(slide, ML, Inches(4.42), Inches(10.0), Inches(1.1), sub, 21, theme["accent"], font=theme["font"])

    _notes(slide, sd)


def _build_standard_bullets(prs, sd, theme, total):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    _draw_base(slide, theme, "light")
    _title_row(slide, theme, sd.get("title", ""), "light")
    _slide_num(slide, theme, sd.get("slide_number", 0), total, "light")
    
    bullets = sd.get("bullet_points", sd.get("content", sd.get("bullets", [])))[:6]
    if not bullets:
        _notes(slide, sd)
        return
        
    card = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, int(ML), int(BODY_Y), int(BODY_W), int(BODY_H))
    card.fill.solid()
    card.fill.fore_color.rgb = theme["bg_card"]
    card.line.fill.background()
    
    tf = card.text_frame
    tf.word_wrap = True
    tf.margin_left = tf.margin_right = Inches(0.6)
    tf.margin_top = Inches(0.5)
    
    for i, pt in enumerate(bullets):
        p = tf.add_paragraph() if i > 0 else tf.paragraphs[0]
        p.text = f"•  {pt}"
        p.space_before = Pt(16)
        p.font.name = theme["font"]
        p.font.size = Pt(20)
        p.font.color.rgb = theme["text_d"]
        p.alignment = PP_ALIGN.LEFT
        
    _notes(slide, sd)


def _build_process_flowchart(prs, sd, theme, total):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    _draw_base(slide, theme, "light")
    _title_row(slide, theme, sd.get("title", ""), "light")
    _slide_num(slide, theme, sd.get("slide_number", 0), total, "light")
    
    nodes = sd.get("nodes", sd.get("steps", sd.get("content", [])))[:5]
    if not nodes:
        _notes(slide, sd)
        return
        
    n = len(nodes)
    gap = Inches(0.4)
    box_w = int((BODY_W - (gap * (n - 1))) / max(n, 1))
    box_h = Inches(1.8)
    cy = int(BODY_Y + (BODY_H - box_h) / 2)
    
    for i, node_text in enumerate(nodes):
        cx = int(ML + i * (box_w + gap))
        
        shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, cx, cy, box_w, box_h)
        shape.fill.solid()
        shape.fill.fore_color.rgb = theme["primary"]
        shape.line.fill.background()
        
        tf = shape.text_frame
        tf.word_wrap = True
        p = tf.paragraphs[0]
        p.text = f"STEP {i+1}"
        p.font.size = Pt(12)
        p.font.color.rgb = theme["accent"]
        p.font.bold = True
        p.font.name = theme["font"]
        p.alignment = PP_ALIGN.CENTER
        
        p2 = tf.add_paragraph()
        p2.text = node_text
        p2.font.size = Pt(16)
        p2.font.color.rgb = theme["text_l"]
        p2.font.name = theme["font"]
        p2.space_before = Pt(8)
        p2.alignment = PP_ALIGN.CENTER
        
        if i < n - 1:
            arr_x = cx + box_w + Inches(0.05)
            arr_y = cy + int(box_h / 2) - Inches(0.1)
            arr = slide.shapes.add_shape(MSO_SHAPE.RIGHT_ARROW, int(arr_x), int(arr_y), int(gap - Inches(0.1)), int(Inches(0.2)))
            arr.fill.solid()
            arr.fill.fore_color.rgb = theme["accent"]
            arr.line.fill.background()
            
    _notes(slide, sd)


def _build_comparison_table(prs, sd, theme, total):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    _draw_base(slide, theme, "light")
    _title_row(slide, theme, sd.get("title", ""), "light")
    _slide_num(slide, theme, sd.get("slide_number", 0), total, "light")
    
    headers = sd.get("table_headers", sd.get("headers", []))
    rows = sd.get("table_rows", sd.get("rows", []))
    if not headers or not rows:
        # Fallback if LLM just outputs "content"
        content = sd.get("content", [])
        if len(content) > 1:
            headers = content[0]
            rows = content[1:]
        else:
            _notes(slide, sd)
            return
        
    cols = len(headers)
    num_rows = len(rows) + 1
    
    shape = slide.shapes.add_table(num_rows, cols, int(ML), int(BODY_Y), int(BODY_W), int(BODY_H))
    table = shape.table
    
    for i, h in enumerate(headers):
        cell = table.cell(0, i)
        cell.text = str(h)
        cell.fill.solid()
        cell.fill.fore_color.rgb = theme["primary"]
        for p in cell.text_frame.paragraphs:
            p.font.color.rgb = theme["text_l"]
            p.font.size = Pt(16)
            p.font.bold = True
            p.font.name = theme["font"]
            
    for r_idx, r_data in enumerate(rows):
        for c_idx, cell_val in enumerate(r_data):
            if c_idx < cols:
                cell = table.cell(r_idx + 1, c_idx)
                cell.text = str(cell_val)
                cell.fill.solid()
                cell.fill.fore_color.rgb = theme["bg_alt"] if r_idx % 2 == 0 else theme["bg_card"]
                for p in cell.text_frame.paragraphs:
                    p.font.color.rgb = theme["text_d"]
                    p.font.size = Pt(15)
                    p.font.name = theme["font"]
                    
    _notes(slide, sd)


def _build_architecture_diagram(prs, sd, theme, total):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    _draw_base(slide, theme, "light")
    _title_row(slide, theme, sd.get("title", ""), "light")
    _slide_num(slide, theme, sd.get("slide_number", 0), total, "light")
    
    layers = sd.get("layers", [])[:4]
    if not layers:
        _notes(slide, sd)
        return
        
    n = len(layers)
    gap = Inches(0.4)
    layer_h = int((BODY_H - (gap * (n - 1))) / max(n, 1))
    
    for i, layer_text in enumerate(layers):
        ly = int(BODY_Y + i * (layer_h + gap))
        
        shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, int(ML), ly, int(BODY_W), layer_h)
        shape.fill.solid()
        shape.fill.fore_color.rgb = theme["primary_l"]
        shape.line.fill.background()
        
        tf = shape.text_frame
        tf.word_wrap = True
        p = tf.paragraphs[0]
        p.text = layer_text
        p.font.size = Pt(22)
        p.font.color.rgb = theme["text_l"]
        p.font.bold = True
        p.font.name = theme["font"]
        p.alignment = PP_ALIGN.CENTER

    _notes(slide, sd)


def _build_closing(prs, sd, theme, total):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    _draw_base(slide, theme, "dark")

    _txt(slide, ML, int(H * 0.35), BODY_W, Inches(1), sd.get("title", "Thank You"), 48, theme["text_l"], bold=True, font=theme["font"], align=PP_ALIGN.CENTER)
    
    cta = sd.get("cta", "")
    if cta:
        _txt(slide, ML, int(H * 0.55), BODY_W, Inches(0.5), cta, 24, theme["accent"], font=theme["font"], align=PP_ALIGN.CENTER)

    _notes(slide, sd)


