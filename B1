# =====================================================================
# GENERATION FLOW — SINGLE PASS, ALL PHOTOS GUARANTEED VISIBLE
# =====================================================================
# Problem this solves: when photos were sent only via additional_images,
# some model backends silently dropped everything after the first image,
# so recipients 2-4 came back with AI-generated faces.
#
# Fix: ALL recipient photos are combined into ONE labeled REFERENCE
# SHEET ("PHOTO 1: <name>", "PHOTO 2: <name>", ...) which is sent as
# the PRIMARY image input. The model therefore always sees every real
# face in a single image, no matter how many photos there are. The
# individual photos are still attached via additional_images as a
# bonus for backends that support multiple image inputs.
#
# The prompt strictly instructs the model that every recipient's face
# in the banner must be the exact real person from their numbered
# photo — extract, scale, crop-to-fit and frame only; never redraw,
# retouch, stylize, or substitute a generated face.
# =====================================================================


def _decode_employee_photo(photo_data: str) -> Tuple[bytes, str]:
    """
    Decode a base64 / data-URL employee photo into (raw_bytes, mime_type).
    Validates that the bytes are a real image by opening them with PIL.
    Raises ValueError if the photo cannot be decoded.
    """
    mime = "image/jpeg"
    encoded = photo_data

    if photo_data.strip().lower().startswith("data:") and "," in photo_data:
        header, encoded = photo_data.split(",", 1)
        match = re.match(r"data:([^;]+);", header)
        if match:
            mime = match.group(1).strip().lower()

    raw = base64.b64decode(encoded)

    # Sniff magic bytes (more reliable than the data-URL header)
    if raw[:8] == b"\x89PNG\r\n\x1a\n":
        mime = "image/png"
    elif raw[:3] == b"\xff\xd8\xff":
        mime = "image/jpeg"

    # Validate it's a readable image
    with Image.open(io.BytesIO(raw)) as probe:
        probe.verify()

    return raw, mime


# Reference sheet layout constants
_SHEET_CELL_W = 512
_SHEET_CELL_H = 560
_SHEET_LABEL_H = 64
_SHEET_PAD = 28


def build_recipient_reference_sheet(
    photo_blobs: List[Tuple[bytes, str]],
    names: List[str],
) -> Tuple[bytes, str]:
    """
    Combine ALL recipient photos into one labeled reference sheet image.

    Each photo is placed unmodified (contain-fit, no face cropping) in its
    own bordered cell with a "PHOTO n: <name>" label underneath. This sheet
    is sent as the PRIMARY image to the model, guaranteeing it sees every
    real face even if the backend ignores additional image inputs.
    """
    count = len(photo_blobs)
    sheet_w = _SHEET_PAD + count * (_SHEET_CELL_W + _SHEET_PAD)
    sheet_h = _SHEET_PAD + _SHEET_CELL_H + _SHEET_LABEL_H + _SHEET_PAD

    sheet = Image.new("RGB", (sheet_w, sheet_h), (255, 255, 255))
    draw = ImageDraw.Draw(sheet)

    try:
        font = ImageFont.truetype(
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 32
        )
    except Exception:
        font = ImageFont.load_default()

    for i, (raw, _mime) in enumerate(photo_blobs):
        name = names[i].strip() if i < len(names) and names[i].strip() else f"Recipient {i + 1}"

        photo = Image.open(io.BytesIO(raw)).convert("RGB")
        # Contain-fit: scales down to fit the cell WITHOUT cropping the face
        fitted = ImageOps.contain(photo, (_SHEET_CELL_W, _SHEET_CELL_H))

        cell_x = _SHEET_PAD + i * (_SHEET_CELL_W + _SHEET_PAD)
        cell_y = _SHEET_PAD

        # Center the photo inside its cell
        offset_x = cell_x + (_SHEET_CELL_W - fitted.width) // 2
        offset_y = cell_y + (_SHEET_CELL_H - fitted.height) // 2
        sheet.paste(fitted, (offset_x, offset_y))

        # Cell border
        draw.rectangle(
            [cell_x, cell_y, cell_x + _SHEET_CELL_W, cell_y + _SHEET_CELL_H],
            outline=(20, 20, 20),
            width=4,
        )

        # Label under the cell: "PHOTO n: Name"
        label = f"PHOTO {i + 1}: {name}"
        draw.text(
            (cell_x + _SHEET_CELL_W / 2, cell_y + _SHEET_CELL_H + _SHEET_LABEL_H / 2),
            label,
            fill=(0, 0, 0),
            font=font,
            anchor="mm",
        )

    output = io.BytesIO()
    sheet.save(output, format="PNG")
    return output.getvalue(), "image/png"


def generate_full_banner_prompt(
    title: str,
    description: str,
    template_id: str,
    theme: str,
    background_style: str,
    employee_names: List[str],
    employee_achievements: List[str],
    aspect_ratio: str,
    canvas_w: int,
    canvas_h: int,
) -> str:
    """
    Build ONE comprehensive prompt containing every input: banner content,
    banner settings, and the recipient names mapped (in order) to the
    labeled photos on the attached reference sheet — with strict rules that
    every recipient's face must be their real photo, never a generated one.
    """
    if employee_achievements is None:
        employee_achievements = []

    layout_info = SALES_TEMPLATE_LAYOUTS.get(
        template_id, SALES_TEMPLATE_LAYOUTS["employee-recognition"]
    )
    background_description = BACKGROUND_STYLE_PRESETS.get(
        background_style, BACKGROUND_STYLE_PRESETS[DEFAULT_BACKGROUND_STYLE]
    )
    ratio_hint = SALES_ASPECT_RATIO_HINTS.get(aspect_ratio, "balanced canvas")

    names = [n.strip() for n in employee_names[:4] if n.strip()]
    num_employees = len(names)

    # Map each labeled sheet photo to its recipient
    recipient_lines = []
    for idx, name in enumerate(names):
        achievement = ""
        if idx < len(employee_achievements) and employee_achievements[idx].strip():
            achievement = employee_achievements[idx].strip()
        line = f'  PHOTO {idx + 1} on the reference sheet → Name: "{name}"'
        if achievement:
            line += f'  |  Achievement: "{achievement}"'
        recipient_lines.append(line)
    recipients_block = "\n".join(recipient_lines)

    prompt = f"""You are a world-class professional banner designer. Create ONE complete, polished,
professional sales/recognition banner using ALL of the inputs below.

RECIPIENT PHOTO INPUTS:
=======================
• The FIRST attached image is a REFERENCE SHEET containing the REAL photo of
  every one of the {num_employees} recipient(s), side by side, each labeled
  "PHOTO 1: <name>", "PHOTO 2: <name>", and so on.
• The same photos may also be attached individually after the sheet, in the
  same order. They are identical to the sheet photos.
• The reference sheet is INPUT ONLY — never reproduce the sheet itself, its
  white background, its black cell borders, or its label text in the banner.

🚨 STRICT PHOTO RULES — THE MOST IMPORTANT INSTRUCTIONS IN THIS TASK 🚨
=========================================================================
• EVERY recipient's face in the final banner MUST be the exact real person
  from their numbered photo: recipient 1 from PHOTO 1, recipient 2 from
  PHOTO 2, recipient 3 from PHOTO 3, recipient 4 from PHOTO 4. NO exceptions.
• NEVER generate, invent, imagine, substitute, or "improve" a face. If ANY
  recipient appears with a face that is not pixel-faithful to their real
  photo, the banner is WRONG and useless.
• Extract each photo cleanly from the reference sheet (exclude the sheet's
  white margins, borders, and label text), keeping the person photorealistic
  and identical to the original.
• The ONLY operations allowed on each photo: scale it, crop it to fit its
  slot, and add a clean border/frame and soft shadow AROUND it (never on top
  of it, never overlapping the person).
• Do NOT redraw, regenerate, repaint, retouch, beautify, stylize, cartoonify,
  or AI-re-render any photo or any person. Do NOT change any person's face,
  identity, skin tone, hair, expression, age, body, clothing, or accessories.
  Do NOT apply artistic filters, color grading, or effects to the photos.
• Each recipient's photo must appear EXACTLY ONCE — none skipped, none
  duplicated, and no extra people, faces, or portraits anywhere on the banner.
• If any rule above conflicts with any design goal below, the photo rules win.

BANNER CONTENT:
===============
Title: {title}
Description: {description}

BANNER SETTINGS:
================
Theme: {theme}
Template: {template_id} — {layout_info['description']}
Visual Style: {layout_info['visual_style']}
Background Style: {background_description}
Aspect Ratio: {aspect_ratio} ({canvas_w}x{canvas_h}px) — {ratio_hint}

RECIPIENTS ({num_employees}) — EACH SHEET PHOTO MAPPED TO ITS NAME:
===================================================================
{recipients_block}

RECIPIENT PRESENTATION:
=======================
• Place each recipient's real photo prominently, framed like a clean photo card.
• Directly under each photo, render that recipient's name EXACTLY ONCE, and
  their achievement (if given) EXACTLY ONCE under the name.
• Keep every name/achievement visually attached to its own photo — never swap
  names between photos, never duplicate text.

DESIGN REQUIREMENTS — PROFESSIONAL QUALITY:
===========================================
1. LAYOUT: polished corporate banner following the template style, with the
   title dominant at the top, the description as a clear subtitle, and the
   recipient photo(s) arranged per the aspect-ratio guidance above with even
   spacing and consistent margins.
2. TYPOGRAPHY: bold legible title, clean professional hierarchy, all text
   perfectly readable against the background, no spelling errors.
3. BACKGROUND: generate the background fresh following the Background Style
   description; it must complement the theme ({theme}) and give strong
   contrast behind photos and text.
4. BRANDING: Zensar logo in the top-right corner, OneRPG logo in the
   bottom-right corner — mandatory on all banners.
5. BALANCE: nothing cramped or overcrowded; adequate breathing room; every
   element intentional, cohesive, and corporate-presentation ready.

OUTPUT:
=======
One single, complete, professional recognition banner at {aspect_ratio}
({canvas_w}x{canvas_h}px), containing the title, description, background,
logos, and every recipient's REAL, UNALTERED photo with their name and
achievement below it. All {num_employees} recipient(s) must be present with
their true faces from the reference sheet.

Start generating the banner now."""

    return prompt


async def generate_sales_banner(
    prompt: str,
    photo_blobs: List[Tuple[bytes, str]],
    names: List[str],
    db: AsyncSession,
) -> bytes:
    """
    Call the image LLM ONCE with the full prompt plus ALL recipient photos.

    The labeled reference sheet (all photos combined) is the PRIMARY image,
    so the model is guaranteed to see every real face even if the backend
    ignores extra image inputs. The individual photos are also attached via
    additional_images for backends that support multiple images.
    """
    sheet_bytes, sheet_mime = build_recipient_reference_sheet(photo_blobs, names)

    print("\n" + "=" * 70)
    print("🎨 BANNER GENERATION — ALL INPUTS SENT TO MODEL IN ONE PASS")
    print("=" * 70)
    print(f"📝 Prompt length: {len(prompt)} characters")
    print(f"🖼️  Primary image: reference sheet with {len(photo_blobs)} labeled photo(s) "
          f"({len(sheet_bytes)} bytes)")
    print(f"📷 Individual photos also attached: {len(photo_blobs)}")
    print("=" * 70 + "\n")

    # NOTE: adjust the additional_images structure here if your
    # image_llm_aexecute util expects a different shape (e.g. tuples or
    # plain bytes) — this passes the same keys as the primary image.
    additional_images = [
        {"image_bytes": img_bytes, "image_mime": img_mime}
        for img_bytes, img_mime in photo_blobs
    ] or None

    result = await image_llm_aexecute(
        prompt=prompt,
        db=db,
        image_bytes=sheet_bytes,
        image_mime=sheet_mime,
        additional_images=additional_images,
    )

    if result.get("status_code") != 200:
        error_msg = result.get("message") or result.get("error") or "Image generation failed"
        logging.error(f"LLM error: {error_msg}")
        raise ValueError(error_msg)

    image_data = result.get("image_bytes")
    if not image_data:
        raise ValueError("No image bytes returned from the image generation model")

    print(f"\n✅ BANNER GENERATED: {len(image_data)} bytes\n")
    return image_data


async def sales_banner_generate_handler(request: Request, db: AsyncSession):
    """
    Banner generation handler — single-pass flow.

    ALL inputs are sent to the image LLM together:
      • Banner Content  (title, description)
      • Banner Settings (template, theme, background style, aspect ratio)
      • Recipients      (names + achievements as text; ALL photos combined
                         into one labeled reference sheet as the primary
                         image, plus attached individually)

    The prompt STRICTLY instructs the model that every recipient's face must
    be the exact real person from their numbered photo — extract, scale,
    crop-to-fit and frame only; never redraw, retouch, or substitute a
    generated face.
    """
    try:
        payload = await request.json()

        # Extract and validate ALL inputs
        title = (payload.get("title") or "").strip()
        description = (payload.get("description") or payload.get("subtitle") or "").strip()
        template = payload.get("template") or payload.get("template_id") or "employee-recognition"
        theme = (payload.get("theme") or "Professional Recognition").strip()
        aspect_ratio = payload.get("aspect_ratio", "16:9")
        background_style = payload.get("background_style") or DEFAULT_BACKGROUND_STYLE
        if background_style not in BACKGROUND_STYLE_PRESETS:
            background_style = DEFAULT_BACKGROUND_STYLE

        # Employee information
        employees_list = payload.get("employees", [])
        number_of_employees = payload.get("number_of_employees", 0)

        names = []
        images = []
        achievements = []

        if employees_list and number_of_employees > 0:
            for emp in employees_list[:number_of_employees]:
                names.append(emp.get("name", "").strip() or "")
                images.append(emp.get("photo", ""))
                achievements.append(emp.get("achievement", "").strip() or "")
        else:
            # Fallback to legacy format
            names = [n.strip() if isinstance(n, str) else "" for n in (payload.get("names") or [])]
            images = payload.get("images") or []
            achievements = [a.strip() if isinstance(a, str) else "" for a in (payload.get("achievements") or [])]

        # VALIDATION
        if not title:
            return JSONResponse({"success": False, "error": "Banner title is required."}, status_code=400)
        if not description:
            return JSONResponse({"success": False, "error": "Banner description is required."}, status_code=400)

        if not names or not images or len(names) == 0 or len(images) == 0:
            return JSONResponse({
                "success": False,
                "error": "At least one employee name and photo is required."
            }, status_code=400)

        if len(images) > 4:
            return JSONResponse({
                "success": False,
                "error": "Maximum 4 employee photos allowed."
            }, status_code=400)

        for idx in range(len(names)):
            if not names[idx].strip():
                return JSONResponse({
                    "success": False,
                    "error": f"Recipient {idx + 1} name is required."
                }, status_code=400)
            if idx >= len(images) or not images[idx]:
                return JSONResponse({
                    "success": False,
                    "error": f"Recipient {idx + 1} photo is required."
                }, status_code=400)

        # Log the complete API payload (for verification that ALL inputs are being used)
        print("\n" + "=" * 70)
        print("📋 SALES BANNER API PAYLOAD (ALL INPUTS)")
        print("=" * 70)
        print(f"Title: {title}")
        print(f"Description: {description[:80]}...")
        print(f"Theme: {theme}")
        print(f"Template: {template}")
        print(f"Background Style: {background_style}")
        print(f"Aspect Ratio: {aspect_ratio}")
        print(f"Employees: {len(names)} ({', '.join(names[:4])})")
        print(f"Achievements: {len(achievements)}")
        print("=" * 70 + "\n")

        # Create working directory
        transaction_uuid = str(uuid.uuid4())
        uuid_path = os.path.join(hls_uploads_path, transaction_uuid)
        output_folder = os.path.join(uuid_path, "output_folder")
        os.makedirs(output_folder, exist_ok=True)

        # Decode ALL employee photos into raw bytes + mime
        photo_blobs: List[Tuple[bytes, str]] = []
        for idx, photo_data in enumerate(images[:4]):
            try:
                raw, mime = _decode_employee_photo(photo_data)
                photo_blobs.append((raw, mime))
                print(f"✅ Employee photo {idx + 1} ({names[idx]}): {len(raw)} bytes ({mime})")
            except Exception as e:
                logging.exception(f"Failed to process employee photo {idx + 1}: {e}")
                return JSONResponse({
                    "success": False,
                    "error": f"Recipient {idx + 1} photo could not be read. Please re-upload it."
                }, status_code=400)

        if not photo_blobs:
            return JSONResponse({
                "success": False,
                "error": "Failed to process employee photos. Please try again."
            }, status_code=400)

        canvas_w, canvas_h = ASPECT_CANVAS_DIMENSIONS.get(
            aspect_ratio, ASPECT_CANVAS_DIMENSIONS["16:9"]
        )

        # Build the single comprehensive prompt (banner content + settings +
        # recipient names mapped to the labeled sheet photos, with strict
        # do-not-alter / no-generated-faces rules).
        print("\n🧠 Generating comprehensive banner prompt (all inputs)...\n")

        prompt = generate_full_banner_prompt(
            title=title,
            description=description,
            template_id=template,
            theme=theme,
            background_style=background_style,
            employee_names=names[:4],
            employee_achievements=achievements[:4],
            aspect_ratio=aspect_ratio,
            canvas_w=canvas_w,
            canvas_h=canvas_h,
        )

        print(f"✅ Prompt generated ({len(prompt)} characters)\n")

        # ONE call to the image LLM with prompt + reference sheet + photos
        print("🎨 Sending prompt + labeled reference sheet to image model...\n")

        banner_image_bytes = await generate_sales_banner(
            prompt=prompt,
            photo_blobs=photo_blobs,
            names=names[:4],
            db=db,
        )

        if not banner_image_bytes:
            raise ValueError("Image model returned no image data")

        # Save generated banner
        ratio_tag = aspect_ratio.replace(':', 'x')
        base_filename = f"sales_banner_{template}_{ratio_tag}"

        counter = 1
        file_name = f"{base_filename}.png"
        file_path = os.path.join(output_folder, file_name)

        while os.path.exists(file_path):
            counter += 1
            file_name = f"{base_filename}_{counter}.png"
            file_path = os.path.join(output_folder, file_name)

        with open(file_path, 'wb') as f:
            f.write(banner_image_bytes)

        print(f"\n✅ Complete banner saved: {file_path}")
        print(f"   File size: {len(banner_image_bytes)} bytes\n")

        # Return as base64 JSON
        encoded = base64.b64encode(banner_image_bytes).decode("utf-8")

        return JSONResponse({
            "success": True,
            "filename": f"{re.sub(r'[^a-zA-Z0-9]+', '_', title).strip('_').lower() or 'sales_banner'}.png",
            "image_base64": encoded,
            "mime_type": "image/png",
            "template": template,
            "download_url": None,
        }, status_code=200)

    except ValueError as ve:
        logging.exception(f"Validation error: {ve}")
        return JSONResponse({
            "success": False,
            "error": str(ve)
        }, status_code=400)

    except Exception as exc:
        logging.exception(f"Banner generation failed: {exc}")
        return JSONResponse({
            "success": False,
            "error": f"Banner generation failed: {str(exc)}"
        }, status_code=500)

