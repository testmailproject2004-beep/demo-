              </h2>

              <div className="space-y-4">
                <div>
                  <label className="mb-2 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">Template</label>
                  <select
                    value={selectedTemplate}
                    onChange={(e) => setSelectedTemplate(e.target.value as any)}
                    className="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm focus:border-[#005AC3] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#005AC3]"
                  >
                    {bannerTemplates.map((template) => (
                      <option key={template.id} value={template.id}>
                        {template.emoji} {template.name}
                      </option>
                    ))}
                  </select>
                  <p className="mt-1 text-xs text-slate-500">{activeTemplate.summary}</p>
                </div>

                <div>
                  <label className="mb-2 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">Theme / Category</label>
                  <select
                    value={theme}
                    onChange={(e) => setTheme(e.target.value as any)}
                    className="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm focus:border-[#005AC3] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#005AC3]"
                  >
