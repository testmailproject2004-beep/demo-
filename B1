async def upsert_hls_sales_presentation_plus_transaction(
    db: AsyncSession,
    transaction_uuid: str,
    format_type: str,
    out_path: str,
    out_filename: str,
    user_id=None,
    user_name=None,
    domain=None,
    input_tokens: int = 0,
    output_tokens: int = 0,
    total_cost: float = 0.0,
):
    result = await db.execute(
        select(HLSTransaction).where(HLSTransaction.uuid == transaction_uuid)
    )
    tx = result.scalar_one_or_none()

    if tx:
        tx.output_file_path = out_path
        tx.format_type = format_type
        tx.input_file_paths = json.dumps([out_filename])
        tx.input_tokens = input_tokens
        tx.output_tokens = output_tokens
        tx.total_cost = total_cost
    else:
        tx = HLSTransaction(
            uuid=transaction_uuid,
            format_type=format_type,
            output_file_path=out_path,
            input_file_paths=json.dumps([out_filename]),
            created_by=user_id,
            created_person=user_name,
            domain=domain,
            input_tokens=input_tokens,
            output_tokens=output_tokens,
            total_cost=total_cost,
        )
        db.add(tx)

    await db.commit()
    return tx
