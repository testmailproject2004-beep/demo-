logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

BASE_DIR = Path(__file__).resolve().parent
TEMPLATES_DIR = BASE_DIR / "assets" / "Templates"
ALLOWED_EXT = {".png", ".jpg", ".jpeg", ".webp"}

IMAGE_MODEL = os.getenv("SALES_BANNER_IMAGE_MODEL", "gemini-3-pro-image")


def _hls_uploads_root() -> Path:
    """Same platform-aware path retail_workflow_banner uses."""
    sys_type, _ = getOSpecifiers()
    if sys_type == "linux":
        return Path("/apps/ebuddy/hls_uploads")
    return Path.cwd() / "src" / "hls_uploads"


# ---------------------------------------------------------------------------
# Request schema — validated manually inside the handler, since the router
# hands us the raw Request rather than triggering FastAPI's auto-parsing.
# ---------------------------------------------------------------------------


class SalesBannerGenerateRequest(BaseModel):
    template_id: str
    title: str = ""
    description: str = ""
    prompt: str = ""
    aspect_ratio: str = "16:9"
    photo: Optional[str] = None  # data URL or raw base64, or None to keep the template's photo


# ---------------------------------------------------------------------------
# Template lookup
# ---------------------------------------------------------------------------


def _mime_for(path: Path) -> str:
    return {
        "png": "image/png",
        "jpg": "image/jpeg",
        "jpeg": "image/jpeg",
        "webp": "image/webp",
    }.get(path.suffix.lower().lstrip("."), "image/png")


def _find_template_file(template_id: str) -> Optional[Path]:
    if not template_id or len(template_id) > 128:
        return None  # filesystem stat() can raise OSError on names this long, not just return False
    if not re.fullmatch(r"[A-Za-z0-9_\-]+", template_id):
        return None  # rejects path traversal before touching the filesystem
    for ext in ALLOWED_EXT:
        candidate = TEMPLATES_DIR / f"{template_id}{ext}"
        try:
            if candidate.exists():
                return candidate
        except OSError:
            continue  # permission errors, etc. — treat as "not found", don't crash the request
    return None


def _decode_data_url(value: str) -> bytes:
    if value.strip().startswith("data:") and "," in value[:80]:
        value = value.split(",", 1)[1]
    return base64.b64decode(value)


def _build_prompt(title: str, description: str, custom_prompt: str, has_photo: bool) -> str:
    parts = [
        "You are editing an existing marketing banner image, not creating a "
        "new one. Preserve the banner's exact layout, background, "
        "decorative shapes, colour palette, logo, and the logo's position "
        "pixel-for-pixel. Do not redesign, restyle, or move anything that "
        "is not explicitly called out below."
    ]
    if title:
        parts.append(f'Replace the main headline text with: "{title}".')
    if description:
        parts.append(f'Replace the supporting body text with: "{description}".')
    if has_photo:
        parts.append(
            "Replace the person currently shown in the banner with the "
            "person in the second supplied image. Match the original "
            "person's pose, framing, crop, and lighting as closely as "
            "possible so the new person sits naturally in the same spot — "
            "do not change where the person is positioned in the frame."
        )
    else:
        parts.append("Keep the existing person in the banner exactly as they are.")
    if custom_prompt:
        parts.append(f"Additional instruction from the user: {custom_prompt.strip()}")
    parts.append(
        "Keep all text sharp, correctly spelled, and legible. Do not add "
        "any new logos, watermarks, or text that wasn't requested."
    )
    return " ".join(parts)


def _extract_image(response) -> Optional[bytes]:
    for candidate in getattr(response, "candidates", []) or []:
        content = getattr(candidate, "content", None)
        for part in getattr(content, "parts", []) or []:
            inline = getattr(part, "inline_data", None)
            if inline and getattr(inline, "data", None):
                data = inline.data
                return data if isinstance(data, bytes) else base64.b64decode(data)
    return None


def _diagnose_missing_image(response) -> str:
    """Called when _extract_image finds nothing, to say *why* instead of
    just reporting that it happened. The response almost always carries a
    reason — a safety block, a finish_reason like NO_IMAGE, or the model
    returning plain text instead of image data — and the old code threw
    all of that away before it ever reached the error message."""
    notes: list[str] = []

    feedback = getattr(response, "prompt_feedback", None)
    block_reason = getattr(feedback, "block_reason", None) if feedback else None
    if block_reason:
        notes.append(f"prompt blocked: {block_reason}")
        block_message = getattr(feedback, "block_reason_message", None)
        if block_message:
            notes.append(f"({block_message})")

    candidates = getattr(response, "candidates", []) or []
    if not candidates:
        notes.append("response had no candidates at all")

    for i, candidate in enumerate(candidates):
        finish_reason = getattr(candidate, "finish_reason", None)
        if finish_reason and str(finish_reason).split(".")[-1] != "STOP":
            notes.append(f"candidate {i} finish_reason={finish_reason}")
        finish_message = getattr(candidate, "finish_message", None)
        if finish_message:
            notes.append(f"finish_message: {finish_message}")

        for rating in getattr(candidate, "safety_ratings", None) or []:
            probability = str(getattr(rating, "probability", "")).split(".")[-1]
            if getattr(rating, "blocked", False) or probability in ("HIGH", "MEDIUM"):
                category = getattr(rating, "category", "?")
                notes.append(f"safety flag: {category}={probability}")

        content = getattr(candidate, "content", None)
        text_parts = [
            part.text
            for part in (getattr(content, "parts", None) or [])
            if getattr(part, "text", None)
        ]
        if text_parts:
            joined = " ".join(text_parts).strip()
            if joined:
                notes.append(f'model returned text instead of an image: "{joined[:300]}"')

    if not notes:
        notes.append("no candidates, no text, no block reason — response gave no clues at all")

    return "; ".join(notes)


def _import_genai():
    """One place that imports google.genai, with an error that actually
    tells you what to do about it instead of a bare ModuleNotFoundError.
    Called from both the handler (for Part.from_bytes) and _gemini_edit."""
    try:
        from google import genai
        from google.genai import types
        return genai, types
    except ImportError as exc:
        raise RuntimeError(
            "The google-genai package isn't installed in this environment "
            "(pip install google-genai). Your banner.py has its own "
            "google.genai imports commented out, which suggests this "
            "project may have moved to image_llm_aexecute instead — if "
            "so, share that utility's signature and this handler can call "
            "it instead of needing google-genai as a separate dependency."
        ) from exc


# Finish reasons documented (and reported by other developers hitting the
# exact same "combine two images" case) as sometimes clearing on a plain
# retry — as opposed to SAFETY / PROHIBITED_CONTENT / RECITATION, which are
# the model's actual decision and won't change no matter how many times
# you ask.
_RETRYABLE_FINISH_REASONS = {"OTHER", "IMAGE_OTHER", "NO_IMAGE", "FINISH_REASON_UNSPECIFIED"}


def _is_retryable(response) -> bool:
    for candidate in getattr(response, "candidates", []) or []:
        finish_reason = getattr(candidate, "finish_reason", None)
        name = str(finish_reason).split(".")[-1] if finish_reason else ""
        if name in _RETRYABLE_FINISH_REASONS:
            return True
    return False


async def _gemini_edit(
    parts: list, aspect_ratio: str, api_key: str, template_id: str, max_attempts: int = 3
) -> bytes:
    """Direct google-genai call — see the module docstring for why this
    isn't going through image_llm_aexecute yet.

    IMAGE_OTHER (and NO_IMAGE) are widely reported as intermittent for
    exactly this kind of multi-image edit — Google's own developer forum
    has reports of it clearing on a plain retry a majority of the time.
    Retries here are scoped to those specific finish reasons only; a
    genuine safety/policy block returns immediately since retrying a
    deterministic decision just wastes calls.

    template_id is threaded through purely for logging — when some
    templates succeed and others don't, the terminal needs to say which is
    which without you having to track it by log timing."""
    genai, types = _import_genai()

    client = genai.Client(api_key=api_key)
    config_kwargs: dict = {"response_modalities": ["TEXT", "IMAGE"]}
    try:
        config_kwargs["image_config"] = types.ImageConfig(aspect_ratio=aspect_ratio or "16:9")
    except AttributeError:
        pass  # older/newer SDK without ImageConfig — edit still runs, just without the hint

    last_diagnosis = "unknown"
    for attempt in range(1, max_attempts + 1):
        suffix = f" (attempt {attempt}/{max_attempts})" if max_attempts > 1 else ""
        logger.info(f"[{template_id}] Calling Gemini image model: {IMAGE_MODEL}{suffix}")
        print(f"🖼️  [{template_id}] Calling Gemini image model: {IMAGE_MODEL}{suffix}")

        response = await client.aio.models.generate_content(
            model=IMAGE_MODEL,
            contents=parts,
            config=types.GenerateContentConfig(**config_kwargs),
        )
        image_bytes = _extract_image(response)
        if image_bytes:
            if attempt > 1:
                logger.info(f"[{template_id}] Succeeded on attempt {attempt}")
                print(f"✅ [{template_id}] Succeeded on attempt {attempt}/{max_attempts}")
            return image_bytes

        last_diagnosis = _diagnose_missing_image(response)
        logger.warning(f"[{template_id}] {IMAGE_MODEL} returned no image (attempt {attempt}): {last_diagnosis}")
        print(f"⚠️  [{template_id}] {IMAGE_MODEL} returned no image (attempt {attempt}): {last_diagnosis}")

        if attempt < max_attempts and _is_retryable(response):
            print(f"🔁 [{template_id}] Finish reason looks transient — retrying...")
            continue
        break

    raise ValueError(
        f"Model {IMAGE_MODEL} did not return an image for template '{template_id}' "
        f"after {attempt} attempt(s) — {last_diagnosis}"
    )


# ---------------------------------------------------------------------------
# Content History integration
# ---------------------------------------------------------------------------
#
# ContentHistory.tsx reads from HLSTransaction rows (via
# /batch_process/hls_platform/content_history) — that's what "No history
# yet" means for banners specifically: nothing has ever inserted a row for
# them. It already has a 'banner' case wired up (HeroBannerPreview +
# BannerRefinePanel), built for handle_banner's hero-banner flow — reusing
# format_type="banner" here means zero changes needed on the frontend side.
#
# User/domain resolution below mirrors sales_generate_presentation_plus in
# sales_content_factory_routes.py exactly — an earlier version of this
# guessed at request.state, which was the wrong place entirely: this
# codebase resolves the user from the request BODY first, falling back to
# decoding the JWT and looking up user_entity by email. domain is just a
# plain string here too ('sales'), matching SalesCFeedback's
# domain=data.get('domain', 'sales') a few lines below in that same file —
# no HLSDomainType enum involved for this particular write path.


async def _resolve_user(
    raw_body: dict, request: Request, db: AsyncSession
) -> tuple[Optional[str], str]:
    """(user_id, user_name), resolved the same way sales_generate_presentation_plus
    does it: prefer values sent directly in the request body, and only decode
    the JWT if the body didn't have a usable numeric id."""
    user_id = raw_body.get("userId") or raw_body.get("user_id")
    user_name = raw_body.get("userName") or raw_body.get("user_name", "Unknown User")

    if not user_id or not str(user_id).isdigit() or str(user_id) in ("null", "unknown_user", "None"):
        auth_header = request.headers.get("Authorization")
        if auth_header and auth_header.startswith("Bearer "):
            token = auth_header.split(" ", 1)[1]
            try:
                import jwt as pyjwt

                from ..config import settings

                jwt_secret_key = settings.jwt.secret_key
                decoded = pyjwt.decode(token, jwt_secret_key, algorithms=["HS256"])
                sub = decoded.get("sub")

                if sub:
                    q = text("SELECT id, name FROM user_entity WHERE email = :email")
                    result = await db.execute(q, {"email": sub})
                    r = result.mappings().first()

                    if r:
                        user_id = str(r["id"])
                        if user_name == "Unknown User":
                            user_name = r["name"]
            except Exception as exc:
                logger.warning(f"Token decode failed: {exc}")
                print(f"Token decode failed: {exc}")

    return user_id, user_name


async def _save_transaction(
    db: AsyncSession,
    transaction_uuid: str,
    template_path: Path,
    output_file_path: Path,
    user_id: Optional[str],
    user_name: str,
) -> None:
    """Insert an HLSTransaction row so this banner shows up in Content
    History, matching handle_banner's exact field pattern. Best-effort and
    non-fatal by design — the person is still waiting on their actual
    banner image; a history-save hiccup must never turn that into a
    failed request."""
    if not user_id:
        logger.info(
            f"[{transaction_uuid}] Content History save skipped — no user_id "
            f"resolved from the request body or the auth token."
        )
        print(f"⚠️  [{transaction_uuid}] Content History save skipped — no user_id resolved")
        return

    try:
        from common.database.models.content_factory import HLSTransaction

        db.add(
            HLSTransaction(
                uuid=transaction_uuid,
                format_type="banner",
                input_file_paths=json.dumps([str(template_path)]),
                output_file_path=str(output_file_path),
                created_by=str(user_id),
                created_person=str(user_name),
                domain="sales",
            )
        )
        await db.commit()
        logger.info(f"[{transaction_uuid}] Saved to Content History (user_id={user_id})")
        print(f"✅ [{transaction_uuid}] Saved to Content History (user_id={user_id})")
    except Exception as exc:
        logger.warning(f"[{transaction_uuid}] Content History save failed: {exc}")
        print(f"⚠️  [{transaction_uuid}] Content History save failed (banner still generated OK): {exc}")
        try:
            await db.rollback()
        except Exception:
            pass


