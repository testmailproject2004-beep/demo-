def _hex_to_rgb(value: str, default: tuple[int, int, int] = (37, 99, 235)) -> tuple[int, int, int]:
    if not value:
        return default
    v = value.strip().lstrip("#")
    if len(v) == 3:
        v = "".join(c * 2 for c in v)
    if len(v) != 6:
        return default
    try:
        return (int(v[0:2], 16), int(v[2:4], 16), int(v[4:6], 16))
    except ValueError:
        return default


def _mix(a: tuple[int, int, int], b: tuple[int, int, int], t: float) -> tuple[int, int, int]:
    return tuple(int(round(a[i] + (b[i] - a[i]) * t)) for i in range(3))  # type: ignore[return-value]


def _luminance(rgb: Sequence[float]) -> float:
    return 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]


def _region_luminance(img: Image.Image, box: tuple[int, int, int, int]) -> float:
    x0, y0, x1, y1 = box
    x0 = max(0, min(img.width - 1, int(x0)))
    y0 = max(0, min(img.height - 1, int(y0)))
    x1 = max(x0 + 1, min(img.width, int(x1)))
    y1 = max(y0 + 1, min(img.height, int(y1)))
    patch = img.convert("RGB").crop((x0, y0, x1, y1))
    return _luminance(ImageStat.Stat(patch).mean)


def _region_mean_rgb(img: Image.Image, box: tuple[int, int, int, int]) -> tuple[int, int, int]:
    x0, y0, x1, y1 = box
    x0 = max(0, min(img.width - 1, int(x0)))
    y0 = max(0, min(img.height - 1, int(y0)))
    x1 = max(x0 + 1, min(img.width, int(x1)))
    y1 = max(y0 + 1, min(img.height, int(y1)))
    patch = img.convert("RGB").crop((x0, y0, x1, y1))
    m = ImageStat.Stat(patch).mean
    return (int(m[0]), int(m[1]), int(m[2]))


def _decode_data_url(value: str | None) -> bytes | None:
    """Accept a data: URL, a bare base64 string, or None."""
    if not value or not isinstance(value, str):
        return None
    raw = value.strip()
    if raw.startswith("data:"):
        parts = raw.split(",", 1)
        if len(parts) != 2:
            return None
        raw = parts[1]
    raw = re.sub(r"\s+", "", raw)
    try:
        return base64.b64decode(raw, validate=False)
    except Exception as exc:  # noqa: BLE001
        logger.warning("Could not decode image payload: %s", exc)
        return None


def _open_rgb(data: bytes) -> Image.Image:
    img = Image.open(io.BytesIO(data))
    img.load()
    if img.mode in ("RGBA", "LA", "P"):
        bg = Image.new("RGB", img.size, (255, 255, 255))
        rgba = img.convert("RGBA")
        bg.paste(rgba, mask=rgba.split()[3])
        return bg
    return img.convert("RGB")


def _slugify(text: str, fallback: str = "banner") -> str:
    s = re.sub(r"[^\w\s-]", "", (text or "")).strip()
    s = re.sub(r"[-\s]+", "_", s)
    return s or fallback


