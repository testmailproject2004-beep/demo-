async def sales_banner_list_templates_handler() -> JSONResponse:
    return JSONResponse(content={"success": True, "templates": list_templates()})


async def sales_banner_template_image_handler(template_id: str, width: Optional[int] = None) -> Response:
    result = get_template_image_bytes(template_id, width)
    if result is None:
        return JSONResponse(
            content={"success": False, "error": f"Unknown template '{template_id}'."},
            status_code=404,
        )
    image_bytes, mime_type = result
    return Response(content=image_bytes, media_type=mime_type)


async def sales_banner_upload_template_handler(request: Request) -> JSONResponse:
    try:
        body = await request.json()
    except Exception:
        return JSONResponse(
            content={"success": False, "error": "Request body is not valid JSON."}, status_code=400
        )
    if not isinstance(body, dict):
        return JSONResponse(
            content={"success": False, "error": "Request body must be a JSON object."}, status_code=400
        )

    name = (body.get("name") or "").strip()
    image = body.get("image") or ""

    try:
        template = add_template(name, image)
    except ValueError as exc:
        return JSONResponse(content={"success": False, "error": str(exc)}, status_code=400)
    except Exception as exc:
        logger.error(f"Template upload failed: {exc}")
        traceback.print_exc()
        return JSONResponse(
