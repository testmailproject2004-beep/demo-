def parse_guardrails(guardrails_text: str) -> dict:
    """
    Parse guardrails text into structured format.
    
    Splits guardrails by "Universal:" and "Brand:" markers, then by semicolons or newlines.
    
    Args:
        guardrails_text: Guardrails as single string or newline-separated list
    
    Returns:
        Dict with 'universal' and 'brand' keys, each containing list of rules
    
    Example:
        >>> text = "Universal: No academic claims; No health claims. Brand: Avoid casual slang."
        >>> rules = parse_guardrails(text)
        >>> rules['universal']
        ['No academic claims', 'No health claims']
        >>> rules['brand']
        ['Avoid casual slang']
    """
    try:
        result = {'universal': [], 'brand': []}
        
        if not guardrails_text:
            return result
        
        # Split by "Universal:" and "Brand:" markers
        parts = guardrails_text.split('Brand:')
        
        # Extract universal guardrails
        if len(parts) > 0:
            universal_part = parts[0].replace('Universal:', '').strip()
            if universal_part:
                # Split by semicolon or newline
                rules = [r.strip() for r in universal_part.replace('\n', ';').split(';') if r.strip()]
                result['universal'] = rules
        
        # Extract brand guardrails
        if len(parts) > 1:
            brand_part = parts[1].strip()
            if brand_part:
                rules = [r.strip() for r in brand_part.replace('\n', ';').split(';') if r.strip()]
                result['brand'] = rules
        
        return result
    
    except Exception as e:
        logger.error(f"Error parsing guardrails: {e}")
        return {'universal': [], 'brand': []}


def validate_banner_guardrails(headline: str, caption: str, brand_context: dict) -> tuple:
    """
    Validate generated banner copy against brand guardrails.
    
    Checks headline and caption for potential guardrail violations using pattern matching.
    
    Args:
        headline: Generated headline text
        caption: Generated caption text
        brand_context: Brand context dict from get_brand_context()
    
    Returns:
        Tuple of (is_valid: bool, violations: List[str])
        is_valid=True if no guardrails violated
        violations: List of detected violations (empty if valid)
    
    Example:
        >>> ctx = {
        ...     'tone': 'Friendly, dependable',
        ...     'guardrails': 'No academic/grade-improvement claims on stationery'
        ... }
        >>> headline = "Get Better Grades with Classmate Notebooks"
        >>> caption = "Academic boost guaranteed"
        >>> valid, violations = validate_banner_guardrails(headline, caption, ctx)
        >>> valid
        False
        >>> 'academic' in str(violations).lower()
        True
    """
    try:
        violations = []
        combined_text = f"{headline} {caption}".lower()
        
        if not brand_context or not brand_context.get('guardrails'):
            logger.info("No guardrails defined for this brand")
            return True, []
        
        # Parse guardrails
        guardrails = parse_guardrails(brand_context.get('guardrails', ''))
        all_rules = guardrails.get('universal', []) + guardrails.get('brand', [])
        
        # Common violation patterns
        violation_patterns = {
            'academic claims': ['academic', 'grades', 'score', 'marks', 'exam', 'performance improvement'],
            'health claims': ['health', 'posture', 'orthopaedic', 'back pain', 'medical', 'cure', 'heal'],
            'superlatives': ['best', 'greatest', 'only', 'perfect', 'ultimate', 'guaranteed', 'premium only'],
            'unverified': ['proven', 'scientifically', 'research shows', 'studies show'],
        }
        
        # Check for violation patterns
        for pattern_name, keywords in violation_patterns.items():
            if any(keyword in combined_text for keyword in keywords):
                # Check if this pattern is mentioned in guardrails
                for rule in all_rules:
                    if pattern_name.lower() in rule.lower():
                        violations.append(
                            f"Potential violation: '{pattern_name}' detected. Rule: {rule}"
                        )
                        break
        
        is_valid = len(violations) == 0
        return is_valid, violations
    
    except Exception as e:
        logger.error(f"Error validating guardrails: {e}")
        return True, [f"Validation error: {str(e)}"]


def prepare_brand_tone_prompt(brand_context: dict) -> str:
    """
    Generate LLM system instructions based on brand tone and intent.
    
    Creates markdown-formatted instructions to be injected into LLM prompts.
    
    Args:
        brand_context: Brand context dict from get_brand_context()
    
    Returns:
        String with brand-specific system instructions for LLM prompt
    
    Example:
        >>> ctx = {
        ...     'name': 'Classmate',
        ...     'tone': 'Friendly, dependable, student-first',
        ...     'focus_intent': 'Everyday reliability for students',
        ...     'category': 'Stationery'
        ... }
        >>> instructions = prepare_brand_tone_prompt(ctx)
        >>> "Friendly, dependable" in instructions
        True
    """
    try:
        if not brand_context:
            return ""
        
        brand_name = brand_context.get('name', 'Brand')
        tone = brand_context.get('tone', '')
        focus_intent = brand_context.get('focus_intent', '')
        category = brand_context.get('category', '')
        guardrails = brand_context.get('guardrails', '')
        
        instructions = ""
        
        if tone:
            instructions += f"\n• Brand Tone: Write in a {tone} tone\n"
        
        if focus_intent:
            instructions += f"• Campaign Focus: Emphasize {focus_intent}\n"
        
        if category:
            instructions += f"• Product Category: {category}\n"
        
        if guardrails:
            guardrails_dict = parse_guardrails(guardrails)
            instructions += f"\n• STRICT GUARDRAILS — Do NOT violate:\n"
            
            for rule in guardrails_dict.get('universal', []):
                instructions += f"  - {rule}\n"
            
            for rule in guardrails_dict.get('brand', []):
                instructions += f"  - {rule}\n"
        
        return instructions
    
    except Exception as e:
        logger.error(f"Error preparing brand tone prompt: {e}")
        return ""


def generate_hero_banner_prompt_for_retail_with_brand(
    llm,
    content: str,
    aspect_ratio: str,
    size_label: str,
    intent: str,
    brand_context: dict | None = None,
    has_logo: bool = False
) -> tuple:
    """
    Generate a retail hero banner prompt WITH BRAND GUIDELINES (NEW).
    
    Enhanced version of generate_hero_banner_prompt_for_retail() that integrates
    brand tone, focus_intent, and guardrails into the LLM prompt.
    Validates generated copy against brand guardrails.
    
    Args:
        llm: Language model instance (e.g., initialize_5o_mini_llm())
        content: Campaign content/context
        aspect_ratio: Banner aspect ratio (e.g., "16:9", "1:1")
        size_label: Human-readable size label (e.g., "Widescreen")
        intent: Campaign intent from banner_options
        brand_context: Brand context dict from get_brand_context() [NEW PARAM]
        has_logo: Whether logo is available
    
    Returns:
        Tuple of (image_prompt: str, is_valid: bool, violations: List[str])
        - image_prompt: The generated image generation prompt for Gemini
        - is_valid: Whether generated copy passes guardrail validation
        - violations: List of guardrail violations (empty if valid)
    
    Example:
        >>> brand_data = {'data': [{'brand_name': 'Classmate', ...}]}
        >>> ctx = get_brand_context(brand_data, 'Classmate')
        >>> llm = initialize_5o_mini_llm()
        >>> prompt, valid, violations = generate_hero_banner_prompt_for_retail_with_brand(
        ...     llm, "Back to school content", "16:9", "Widescreen", "Back to School", 
        ...     brand_context=ctx, has_logo=True
        ... )
        >>> if not valid:
        ...     print(f"Review violations: {violations}")
    """
    try:
        layout_hint = LAYOUT_HINTS.get(aspect_ratio, LAYOUT_HINTS.get("16:9", "standard layout"))
        intent_line = f"• Campaign intent: {intent}" if intent else ""
        logo_line = "• Include a placeholder area for brand logo (top corner or subtle overlay)" if has_logo else ""
        
        # Build brand-aware instructions [NEW]
        brand_instructions = ""
        if brand_context:
            brand_instructions = prepare_brand_tone_prompt(brand_context)
            print(f"🏷️ Brand context loaded for: {brand_context.get('name', 'Unknown Brand')}")
        
        brand_name_display = brand_context.get('name', '') if brand_context else ""
        brand_line = f"• Brand: {brand_name_display}" if brand_name_display else ""
        
        prompt = f"""
You are an award-winning ecommerce creative director specialising in high-conversion retail promotional banners.
Your task: produce ONE highly detailed image-generation prompt for a premium retail promotional banner.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CAMPAIGN CONTEXT (use fully):
{content}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BANNER SPECS:
• Aspect ratio : {aspect_ratio} ({size_label})
• Layout       : {layout_hint}
{intent_line}
{brand_line}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BRAND-SPECIFIC GUIDELINES:
{brand_instructions if brand_instructions else "• No specific brand guidelines provided"}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RETAIL PROMOTIONAL BANNER PRINCIPLES — follow ALL strictly:

1. HEADLINE (MANDATORY)
- One bold, attention-grabbing headline (max 8–10 words)
- Must reflect campaign theme + product value
- Must align with brand tone if provided
- Placed prominently over image

2. CAPTION (MANDATORY)
- One concise supporting line reinforcing value
- Positioned directly below headline

3. BACKGROUND IMAGE (MANDATORY)
- Full-bleed, high-quality lifestyle scene
- Must reflect campaign context and brand identity

4. QUALITY & GUARDRAILS
- Ultra high-resolution, sharp ecommerce-quality output
- If humans present: Natural posture, no distortions
- All text grammatically correct and spelling error-free

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OUTPUT RULES:

• Return ONLY the final image-generation prompt
• No explanations, no markdown
• Must include: Exact headline, caption, background description, product placement, lighting, aspect ratio {aspect_ratio}
{logo_line}

Generate the hero banner prompt now.
"""
        
        response = llm.invoke(prompt)
        image_prompt = response.content.strip()
        print(f"🎨 Hero banner prompt ({aspect_ratio} — {size_label}):\n{image_prompt[:300]}...")
        
        # Extract headline and caption for validation [NEW]
        lines = image_prompt.split('\n')
        headline = ""
        caption = ""
        
        for i, line in enumerate(lines):
            if len(line) > 10 and i < len(lines)-1:
                headline = line.strip()
                caption = lines[i + 1].strip() if i + 1 < len(lines) else ""
                break
        
        # Validate against guardrails [NEW]
        is_valid = True
        violations = []
        if brand_context:
            is_valid, violations = validate_banner_guardrails(
                headline or image_prompt[:100],
                caption or image_prompt[100:200],
                brand_context
            )
            if violations:
                print(f"⚠️  Guardrail validation: {len(violations)} warning(s)")
                for v in violations[:3]:  # Print first 3
                    print(f"   - {v}")
            else:
                print(f"✅ Banner copy passes all brand guardrails")
        
        return image_prompt, is_valid, violations
    
    except Exception as e:
        logger.error(f"Error generating brand-aware banner prompt: {e}")
        print(f"❌ Error: {e}")
        import traceback
        traceback.print_exc()
        return "", False, [str(e)]
    
