@sales_content_factory_router.post("/banner/refine")
async def sales_refine_banner(request: Request, db: AsyncSession = Depends(get_session)):
    """Body: {"transaction_uuid": "...", "feedback": "remove the Q1 FY27 section"}"""
    return await sales_banner_refine_handler(request, db)


const [feedback, setFeedback] = useState('');
const [refining, setRefining] = useState(false);
const [refineError, setRefineError] = useState<string | null>(null);

async function refineBanner() {
  if (!lastTransactionId || !feedback.trim()) return;
  setRefining(true);
  setRefineError(null);
  try {
    const token = localStorage.getItem('token');
    const response = await fetch(`${middleware_url}/batch_process/sales_platform/banner/refine`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ transaction_uuid: lastTransactionId, feedback: feedback.trim() }),
    });
    if (!response.ok) {
      let message = 'Refine failed';
      try {
        const errBody = await response.json();
        message = errBody.detail || errBody.error || message;
      } catch { /* not JSON */ }
      throw new Error(message);
    }
    const blob = await response.blob();
    const refinedImage = URL.createObjectURL(blob);
    objectUrlsRef.current.push(refinedImage);
    setPreviewUrl(refinedImage);
    setHistory((prev) =>
      [{ title: `${title.trim() || 'Banner'} (refined)`, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }), image: refinedImage }, ...prev].slice(0, 6),
    );
    setFeedback('');
  } catch (err) {
    setRefineError(err instanceof Error ? err.message : 'Refine failed');
  } finally {
    setRefining(false);
  }
}

{lastTransactionId && (
  <div className="mt-3 flex gap-2">
    <input
      value={feedback}
      onChange={(e) => setFeedback(e.target.value)}
      placeholder="e.g., remove the Q1 FY27 section, make the title blue"
      className={inputClass}
    />
    <button
      type="button"
      onClick={refineBanner}
      disabled={refining || !feedback.trim()}
      className="shrink-0 rounded-md bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white disabled:opacity-60"
    >
      {refining ? 'Refining…' : 'Refine'}
    </button>
  </div>
)}
{refineError && <p className="mt-1 text-[11px] text-red-600">{refineError}</p>}

