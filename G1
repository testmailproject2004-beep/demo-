async def generate_sales_banner(
    *,
    title: str,
    description: str,
    recipients: list[dict[str, Any]],
    db: AsyncSession,
    domain: HLSDomainType | str = "sales",
    theme: str = "Award Recognition",
    template_id: str = "employee-recognition",
    background_style: str = "corporate-blue-gradient",
    aspect_ratio: str = "16:9",
    accent_color: str = "",
) -> tuple[bytes, dict[str, Any]]:
    """
    Core entry point. Returns (png_bytes, meta).

    `recipients` is a list of {"name", "photo" (data URL or base64), "achievement"}.
    Photos are decoded here and never leave this process.
    """
    recipients = (recipients or [])[:MAX_RECIPIENTS]
    if not recipients:
        raise ValueError("At least one recipient is required")

    preset = TEMPLATE_PRESETS.get(template_id, TEMPLATE_PRESETS["employee-recognition"])
    accent = _hex_to_rgb(accent_color or preset["accent"])

    width, height = _canvas_size(aspect_ratio)
    layout = _build_layout(width, height, len(recipients))

    # Decode photos up front so a bad upload fails fast and cheap.
    missing: list[str] = []
    for index, person in enumerate(recipients):
        data = _decode_data_url(person.get("photo"))
        if not data:
            missing.append(person.get("name") or f"Recipient {index + 1}")
            person["_image"] = None
            continue
        try:
            person["_image"] = _open_rgb(data)
        except Exception as exc:  # noqa: BLE001
            logger.warning("Bad photo for recipient %s: %s", index + 1, exc)
            person["_image"] = None
            missing.append(person.get("name") or f"Recipient {index + 1}")

    # 1 + 2. plate prompt, then plate
    try:
        llm = await initialize_5o_mini_llm(db=db, domain=domain)
        plate_prompt = build_plate_prompt(
            llm, title=title, description=description, theme=theme,
            template_id=template_id, background_style=background_style,
            aspect_ratio=aspect_ratio, accent_hex=accent_color or preset["accent"],
            layout=layout, count=len(recipients),
        )
    except Exception as exc:  # noqa: BLE001
        logger.warning("Plate prompt LLM failed, using static prompt: %s", exc)
        plate_prompt = (
            f"Premium corporate award banner background plate, {BACKGROUND_STYLES.get(background_style, '')}, "
            f"anchor colour {accent_color or preset['accent']}. Absolutely no people, no faces, no text, "
            f"no letters, no logos, no empty frames. Keep the top band, the horizontal centre band and the "
            f"bottom-right corner calm, low contrast and free of detail. Decorative interest only at the "
            f"edges and corners. aspect ratio {aspect_ratio}, ultra high resolution, clean, premium."
        )

    plate, used_ai = await _generate_plate(plate_prompt, db, width, height, accent, background_style)

    # 3 + 4. composite
    banner = compose_banner(
        plate, title=title, description=description, recipients=recipients,
        accent=accent, layout=layout, background_style=background_style,
        logo=_load_logo(),
    )

    buffer = io.BytesIO()
    banner.save(buffer, "PNG", optimize=True)

    meta = {
        "width": width, "height": height, "aspect_ratio": aspect_ratio,
        "ai_background": used_ai, "recipients": len(recipients),
        "photos_missing": missing, "plate_prompt": plate_prompt,
    }
    return buffer.getvalue(), meta


async def handle_sales_banner(request: Request, domain: HLSDomainType, db: AsyncSession):
    """
    FastAPI handler for POST /batch_process/sales_platform/banner/generate

    Returns the JSON shape SalesBannerGenerator.tsx already reads:
        { "success": true, "image_base64": "<...>", "transaction_uuid": "..." }
    """
    try:
        data = await request.json()

        title = (data.get("title") or "").strip()
        description = (data.get("description") or "").strip()
        recipients = data.get("employees") or data.get("recipients") or []

        if not title:
            return JSONResponse({"success": False, "error": "Banner title is required"}, status_code=400)
        if not description:
            return JSONResponse({"success": False, "error": "Description is required"}, status_code=400)
        if not recipients:
            return JSONResponse({"success": False, "error": "At least one recipient is required"}, status_code=400)

        count = int(data.get("number_of_employees") or len(recipients))
        recipients = recipients[:max(1, min(MAX_RECIPIENTS, count))]

        for index, person in enumerate(recipients):
            if not (person.get("name") or "").strip():
                return JSONResponse(
                    {"success": False, "error": f"Recipient {index + 1} name is required"}, status_code=400
                )
            if not person.get("photo"):
                return JSONResponse(
                    {"success": False, "error": f"Recipient {index + 1} photo is required"}, status_code=400
                )

        transaction_uuid = (data.get("transaction_uuid") or str(uuid_lib.uuid4())).strip()

        png_bytes, meta = await generate_sales_banner(
            title=title,
            description=description,
            recipients=recipients,
            db=db,
            domain=domain,
            theme=data.get("theme") or "Award Recognition",
            template_id=data.get("template_id") or "employee-recognition",
            background_style=data.get("background_style") or "corporate-blue-gradient",
            aspect_ratio=data.get("aspect_ratio") or "16:9",
            accent_color=data.get("accent_color") or "",
        )

        # Optional persistence — mirrors sample banner.py, safe to remove.
        output_path = None
        user_id = data.get("user_id")
        try:
            output_folder = data.get("output_folder") or os.path.join(
                os.environ.get("HLS_UPLOADS_PATH", os.path.join(os.getcwd(), "src", "hls_uploads")),
                transaction_uuid, "output_folder",
            )
            os.makedirs(output_folder, exist_ok=True)
            file_name = f"sales_banner_{_slugify(title)}_{aspect_tag(data.get('aspect_ratio') or '16:9')}.png"
            output_path = os.path.join(output_folder, file_name)
            counter = 1
            while os.path.exists(output_path):
                counter += 1
                output_path = os.path.join(output_folder, f"{os.path.splitext(file_name)[0]}_{counter}.png")
            with open(output_path, "wb") as handle:
                handle.write(png_bytes)

            if user_id:
                db.add(HLSTransaction(
                    uuid=transaction_uuid,
                    format_type="sales_banner",
                    input_file_paths=json.dumps([]),
                    output_file_path=os.path.abspath(output_path),
                    created_by=str(user_id),
                    created_person=str(data.get("user_name") or ""),
                    domain=domain,
                ))
                await db.commit()
        except Exception as exc:  # noqa: BLE001
            logger.warning("Sales banner persistence skipped: %s", exc)
            try:
                await db.rollback()
            except Exception:  # noqa: BLE001
                pass

        return JSONResponse({
            "success": True,
            "status": "success",
            "image_base64": base64.b64encode(png_bytes).decode("ascii"),
            "transaction_uuid": transaction_uuid,
            "output_file_path": output_path,
            "meta": {k: v for k, v in meta.items() if k != "plate_prompt"},
        })

    except ValueError as exc:
        return JSONResponse({"success": False, "error": str(exc)}, status_code=400)
    except Exception as exc:  # noqa: BLE001
        logger.error("Error in handle_sales_banner: %s", exc)
        import traceback
        traceback.print_exc()
        return JSONResponse({"success": False, "error": str(exc)}, status_code=500)


def aspect_tag(aspect_ratio: str) -> str:
    return (aspect_ratio or "16x9").replace(":", "x")

