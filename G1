def _alpha_paste(canvas: Image.Image, layer: Image.Image, xy: tuple[int, int]) -> None:
    """alpha_composite that tolerates negative / overflowing coordinates."""
    x, y = int(xy[0]), int(xy[1])
    cx0, cy0 = max(0, x), max(0, y)
    cx1, cy1 = min(canvas.width, x + layer.width), min(canvas.height, y + layer.height)
    if cx1 <= cx0 or cy1 <= cy0:
        return
    crop = layer.crop((cx0 - x, cy0 - y, cx1 - x, cy1 - y))
    canvas.alpha_composite(crop, (cx0, cy0))


def _circle_mask(size: int, supersample: int = 4, feather: float = 1.2) -> Image.Image:
    big = size * supersample
    mask = Image.new("L", (big, big), 0)
    ImageDraw.Draw(mask).ellipse((0, 0, big - 1, big - 1), fill=255)
    mask = mask.resize((size, size), Image.LANCZOS)
    return mask.filter(ImageFilter.GaussianBlur(feather))


def _rounded_mask(size: tuple[int, int], radius: int,
                  supersample: int = 4, feather: float = 1.0) -> Image.Image:
    w, h = size
    big = (w * supersample, h * supersample)
    mask = Image.new("L", big, 0)
    ImageDraw.Draw(mask).rounded_rectangle(
        (0, 0, big[0] - 1, big[1] - 1), radius=radius * supersample, fill=255
    )
    mask = mask.resize((w, h), Image.LANCZOS)
    return mask.filter(ImageFilter.GaussianBlur(feather))


def _paste_shadow(canvas: Image.Image, mask: Image.Image, xy: tuple[int, int],
                  blur: int = 24, offset: tuple[int, int] = (0, 14),
                  opacity: int = 120, spread: int = 8) -> None:
    """Soft drop shadow derived from an alpha mask. Grounds the element in the scene."""
    w, h = mask.size
    pad = blur * 2 + spread
    shadow_mask = Image.new("L", (w + pad * 2, h + pad * 2), 0)
    grown = mask.resize((w + spread * 2, h + spread * 2), Image.LANCZOS)
    shadow_mask.paste(grown, (pad - spread, pad - spread))
    shadow_mask = shadow_mask.filter(ImageFilter.GaussianBlur(blur))
    shadow_mask = shadow_mask.point(lambda p: int(p * opacity / 255))

    shadow = Image.new("RGBA", shadow_mask.size, (0, 0, 0, 0))
    shadow.putalpha(shadow_mask)
    _alpha_paste(canvas, shadow, (xy[0] - pad + offset[0], xy[1] - pad + offset[1]))


def _frosted_panel(canvas: Image.Image, box: tuple[int, int, int, int], radius: int,
                   tint: tuple[int, int, int], tint_alpha: int = 46,
                   blur: int = 22, border: tuple[int, int, int, int] | None = None) -> None:
    """
    Frosted-glass card: blur what is already behind the box, tint it, paste back
    through a rounded mask. This is what makes composited elements read as part
    of the generated background rather than pasted on top of it.
    """
    x0, y0, x1, y1 = (int(v) for v in box)
    x0, y0 = max(0, x0), max(0, y0)
    x1, y1 = min(canvas.width, x1), min(canvas.height, y1)
    if x1 <= x0 or y1 <= y0:
        return

    region = canvas.crop((x0, y0, x1, y1)).convert("RGB")
    region = region.filter(ImageFilter.GaussianBlur(blur))
    overlay = Image.new("RGB", region.size, tint)
    region = Image.blend(region, overlay, tint_alpha / 255.0)

    panel = region.convert("RGBA")
    if border:
        ImageDraw.Draw(panel).rounded_rectangle(
            (0, 0, panel.width - 1, panel.height - 1), radius=radius, outline=border, width=2
        )
    panel.putalpha(_rounded_mask(panel.size, radius))
    canvas.alpha_composite(panel, (x0, y0))


def _scrim(canvas: Image.Image, box: tuple[int, int, int, int],
           dark: bool, strength: float = 0.42, blur: int = 60) -> None:
    """
    Guaranteed text legibility. We never trust the image model to actually leave
    the reserved zone clean, so we darken/lighten it ourselves with a soft,
    feathered gradient before drawing text on it.
    """
    x0, y0, x1, y1 = (int(v) for v in box)
    w, h = max(1, x1 - x0), max(1, y1 - y0)
    colour = (0, 0, 0) if dark else (255, 255, 255)

    # Pad the layer by 2x the blur radius. Without this the rounded rectangle
    # touches the layer edge, the blur has nothing to fade into, and you get a
    # visible hard-edged box sitting on the background.
    pad = blur * 2
    layer = Image.new("L", (w + pad * 2, h + pad * 2), 0)
    ImageDraw.Draw(layer).rounded_rectangle(
        (pad, pad, pad + w - 1, pad + h - 1),
        radius=int(min(w, h) * 0.35), fill=int(255 * strength),
    )
    layer = layer.filter(ImageFilter.GaussianBlur(blur))

    scrim = Image.new("RGBA", layer.size, colour + (0,))
    scrim.putalpha(layer)
    _alpha_paste(canvas, scrim, (x0 - pad, y0 - pad))


def _draw_text(draw: ImageDraw.ImageDraw, xy: tuple[int, int], text: str, font,
               fill: tuple[int, int, int], anchor: str = "mm",
               shadow: tuple[int, int, int, int] | None = (0, 0, 0, 110),
               shadow_offset: tuple[int, int] = (0, 3)) -> None:
    if shadow:
        draw.text((xy[0] + shadow_offset[0], xy[1] + shadow_offset[1]),
                  text, font=font, fill=shadow, anchor=anchor)
    draw.text(xy, text, font=font, fill=fill, anchor=anchor)


