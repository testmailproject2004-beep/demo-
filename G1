async def handle_banner(
    document_content,
    format_type,
    output_folder,
    downloaded_files,
    domain: HLSDomainType,
    db: AsyncSession,
    user_id=None,
    user_name=None,
    transaction_uuid=None,
    input_folder=None,
    banner_options=None
):
    print("\n🎨 Generating Hero Banner...\n")

    try:
        banner_options = banner_options or {}

        size_str = banner_options.get("size", "16:9")
        intent = banner_options.get("intent", "")
        brand_name = banner_options.get("brand_guidelines", "")

        aspect_ratio, size_label = get_aspect_ratio(size_str)
        print(f"📐 Aspect ratio: {aspect_ratio} ({size_label})")

        # brand_name may be "Brand Name - color palette info"; extract just the name for logo lookup
        brand_name_only = brand_name.split(' - ', 1)[0].strip() if brand_name else ''

        if brand_name_only:
            logo_bytes, logo_mime = await get_brand_logo_bytes(brand_name_only, db)
        else:
            logo_bytes, logo_mime = None, ''

        if logo_bytes:
            print(f"🏷️  Brand logo loaded for '{brand_name_only}'")
        else:
            print("ℹ️  No brand logo — generating without logo")

        # Step 1: LLM generates image prompt
        llm = await initialize_5o_mini_llm(db, domain)

        image_prompt = await asyncio.to_thread(
            generate_hero_banner_prompt,
            llm,
            document_content,
            aspect_ratio,
            size_label,
            intent,
            brand_name,
            bool(logo_bytes)
        )

        # Step 2: Gemini generates image
        
        # Step 2: LiteLLM Gemini generates image

        image_data = await generate_banner_image(
            image_prompt,
            db,
            logo_bytes,
            logo_mime,
        )


        if not image_data:
            raise ValueError("No image data returned from Gemini")

        # Save file
        os.makedirs(output_folder, exist_ok=True)

        base_names = []

        for filename in downloaded_files:
            base = os.path.splitext(filename)[0]
            base = re.sub(r'[^\w\s-]', '', base)
            base = re.sub(r'[-\s]+', '_', base)
            base_names.append(base)

        ratio_tag = aspect_ratio.replace(':', 'x')
        format_part = format_type.replace(' ', '_')
        source_part = '_'.join(base_names)

        if not source_part:
            source_part = "banner"

        base_filename = f"{format_part}_{source_part}_{ratio_tag}"

        counter = 1
        file_name = f"{base_filename}.png"
        file_path = os.path.join(output_folder, file_name)

        while os.path.exists(file_path):
            counter += 1
            file_name = f"{base_filename}_{counter}.png"
            file_path = os.path.join(output_folder, file_name)

        image = Image.open(io.BytesIO(image_data))
        image.save(file_path, 'PNG')

        print(f"✅ Banner saved: {file_path}")

        # Save DB transaction
        if user_id and transaction_uuid and input_folder:
            try:
                input_file_paths_json = json.dumps([
                    os.path.abspath(os.path.join(input_folder, f))
                    for f in downloaded_files
                ])

                db.add(
                    HLSTransaction(
                        uuid=transaction_uuid,
                        format_type=format_type,
                        input_file_paths=input_file_paths_json,
                        output_file_path=os.path.abspath(file_path),
                        created_by=str(user_id),
                        created_person=str(user_name),
                        domain=domain
                    )
                )

                await db.commit()
                print(f"✅ Transaction saved: {transaction_uuid}")

            except Exception as db_error:
                print(f"⚠️  DB save failed: {db_error}")
                await db.rollback()

        with open(file_path, 'rb') as f:
            final_image_data = f.read()

        return Response(
            content=final_image_data,
            media_type="image/png",
            headers={
                "Content-Disposition": f'attachment; filename="{file_name}"',
                "X-Transaction-UUID": str(transaction_uuid),
                "Access-Control-Expose-Headers": "X-Transaction-UUID"
            }
        )

    except Exception as e:
        logger.error(f"Error in handle_banner: {e}")
        print(f"❌ Hero banner generation failed: {e}")

        import traceback
        traceback.print_exc()

        return JSONResponse(
            content={"success": False, "error": str(e)},
            status_code=500
        )


def refine_banner_image(image_bytes: bytes, image_mime: str, feedback: str) -> bytes:
    """Send the existing banner image + user feedback directly to Gemini for refinement.
    No intermediate LLM prompt step — Gemini edits the image based on the instruction.
    """
    print(f"✏️  Refining banner image with feedback: {feedback[:120]}...")

    refinement_prompt = f"""You are a professional banner image editor. You have been given an existing hero banner image.

YOUR ONLY JOB: Apply EXACTLY the changes described in the USER REQUEST below — nothing else.

USER REQUEST:
{feedback}

STRICT RULES — you MUST follow all of these without exception:
1. ONLY change what the user explicitly asked for. Every other element must remain pixel-perfect identical.
2. PRESERVE the exact aspect ratio and canvas dimensions of the original image — do NOT crop, letterbox, or resize.
3. PRESERVE all text — headlines, captions, body copy — exactly as they appear: same wording, same font style, same size, same position, same color, unless the user explicitly asked to change text.
4. PRESERVE the brand logo — same position, same size, same appearance. Never move, resize, recolor, or remove it.
5. PRESERVE the overall layout and composition — element positions, alignment zones, and spacing must stay the same.
6. PRESERVE image resolution and output quality — match the original sharpness, detail level, and file quality.
7. PRESERVE the color palette for all unchanged elements — do not drift or reinterpret colors elsewhere in the image.
8. PRESERVE typography hierarchy — font weights, sizes, and styles must not change unless explicitly requested.
9. Do NOT add new elements, decorations, watermarks, or design features that were not in the original.
10. Do NOT reinterpret the overall design — this is a surgical edit, not a redesign.

Apply only the requested change now and return the edited image."""

    contents = [
        types.Part.from_bytes(data=image_bytes, mime_type=image_mime),
        refinement_prompt,
    ]

    response = client.models.generate_content(
        model="gemini-3-pro-image-preview",
        contents=contents,
    )

    print(f"🔍 Gemini refine response parts: {len(response.parts)}")
    for i, part in enumerate(response.parts):
        has_data = bool(part.inline_data)
        text_prev = repr(part.text[:80]) if hasattr(part, 'text') and part.text else None
        print(f"  Part {i}: inline_data={has_data}, text={text_prev}")
        if has_data:
            print(f"  → {part.inline_data.mime_type}, {len(part.inline_data.data)} bytes")
            return part.inline_data.data

    raise ValueError(
        f"No image data returned by Gemini during refinement. Parts: {len(response.parts)}."
    )


async def handle_banner_refine(
    request: Request,
    domain: HLSDomainType,
    db: AsyncSession
):
    """Refine an existing banner under the same transaction UUID."""

    try:
        data = await request.json()

        transaction_uuid = data.get('transaction_uuid', '').strip()
        feedback = data.get('feedback', '').strip()
        user_id = data.get('user_id', '')
        user_name = data.get('user_name', '')

        if not transaction_uuid:
            return JSONResponse(
                content={"success": False, "error": "Missing transaction_uuid"},
                status_code=400
            )

        if not feedback:
            return JSONResponse(
                content={"success": False, "error": "Missing feedback"},
                status_code=400
            )

        # Look up the transaction to find the current image path
        result = await db.execute(
            select(HLSTransaction).where(
                HLSTransaction.uuid == transaction_uuid
            )
        )
        transaction = result.scalars().first()

        if not transaction:
            return JSONResponse(
                content={"success": False, "error": "Transaction not found"},
                status_code=404
            )

        existing_edits = (
            json.loads(transaction.edited_file_paths)
            if transaction.edited_file_paths
            else []
        )

        # Resolve which version to refine from.
        # source_version_idx: 0 = original, 1 = first edit, 2 = second edit, ...
        source_version_idx = data.get('source_version_idx')

        if source_version_idx is None:
            current_image_path = (
                existing_edits[-1]
                if existing_edits
                else transaction.output_file_path
            )
        else:
            
            try:
                source_version_idx = int(source_version_idx)
            except (TypeError, ValueError):
                return JSONResponse(
                    content={"success": False, "error": "Invalid source_version_idx"},
                    status_code=400
                )


            if source_version_idx == 0:
                current_image_path = transaction.output_file_path
            else:
                edit_idx = source_version_idx - 1

                if edit_idx >= len(existing_edits):
                    return JSONResponse(
                        content={
                            "success": False,
                            "error": f"Version {source_version_idx} not found "
                                     f"(only {len(existing_edits)} edits exist)"
                        },
                        status_code=404
                    )

                current_image_path = existing_edits[edit_idx]

        if not current_image_path or not os.path.exists(current_image_path):
            return JSONResponse(
                content={
                    "success": False,
                    "error": "Current banner image not found on disk"
                },
                status_code=404
            )

        with open(current_image_path, 'rb') as f:
            current_image_bytes = f.read()

        ext = os.path.splitext(current_image_path)[1].lower()
        image_mime = {
            '.png': 'image/png',
            '.jpg': 'image/jpeg',
            '.jpeg': 'image/jpeg'
        }.get(ext, 'image/png')

        print(
            f"🖼️  Refining banner from disk: "
            f"{current_image_path} ({len(current_image_bytes)} bytes)"
        )

        # Send image + feedback directly to Gemini
        api_key = await get_constant("gemini_api_key", db)

        image_data = await asyncio.to_thread(
            refine_banner_image,
            current_image_bytes,
            image_mime,
            feedback,
            api_key
        )


        if not image_data:
            raise ValueError("No image data returned from Gemini")

        # Save into the same transaction output folder
        output_folder = os.path.dirname(transaction.output_file_path)
        os.makedirs(output_folder, exist_ok=True)

        # Version number = how many edited files already exist + 2
        version_num = len(existing_edits) + 2

        base = os.path.splitext(os.path.basename(transaction.output_file_path))[0]
        file_name = f"{base}_v{version_num}.png"
        file_path = os.path.join(output_folder, file_name)

        # Ensure unique filename
        counter = version_num

        while os.path.exists(file_path):
            counter += 1
            file_name = f"{base}_v{counter}.png"
            file_path = os.path.join(output_folder, file_name)

        image = Image.open(io.BytesIO(image_data))
        image.save(file_path, 'PNG')

        print(f"✅ Refined banner saved: {file_path}")

        # Append to edited_file_paths in DB
        existing_edits.append(os.path.abspath(file_path))
        transaction.edited_file_paths = json.dumps(existing_edits)

        await db.commit()

        print(f"✅ edited_file_paths updated ({len(existing_edits)} edits)")

        with open(file_path, 'rb') as rf:
            final_refined_data = rf.read()

        return Response(
            content=final_refined_data,
            media_type="image/png",
            headers={
                "Content-Disposition": f'attachment; filename="{file_name}"',
                "X-Transaction-UUID": str(transaction_uuid),
                "X-Version-Number": str(version_num),
                "Access-Control-Expose-Headers": "X-Transaction-UUID, X-Version-Number"
            }
        )

    except Exception as e:
        await db.rollback()

        logger.error(f"Error in handle_banner_refine: {e}")

        import traceback
        traceback.print_exc()

        return JSONResponse(
            content={"success": False, "error": str(e)},
            status_code=500
        )
