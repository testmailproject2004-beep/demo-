def compose_banner(plate: Image.Image, *, title: str, description: str,
                   recipients: list[dict[str, Any]], accent: tuple[int, int, int],
                   layout: dict[str, Any], background_style: str,
                   logo: Image.Image | None) -> Image.Image:
    """Draw everything on top of the plate. Pure, deterministic, no network."""
    canvas = plate.convert("RGBA")
    width, height = layout["width"], layout["height"]

    light_plate = _region_luminance(canvas, (0, 0, width, height)) > 145
    ink = (17, 22, 34) if light_plate else (255, 255, 255)
    sub_ink = _mix(ink, (128, 132, 142), 0.42)

    # ---- 1. TITLE -----------------------------------------------------------
    draw = ImageDraw.Draw(canvas)
    tb = layout["title_box"]
    _scrim(canvas, (tb[0] - 40, tb[1] - 30, tb[2] + 40, layout["desc_box"][3] + 30),
           dark=not light_plate, strength=0.40, blur=70)

    draw = ImageDraw.Draw(canvas)
    title_max_w = tb[2] - tb[0]
    title_h = tb[3] - tb[1]
    title_font = _fit_font(draw, title.upper(), "black", title_max_w, int(title_h * 0.82))
    title_cx = (tb[0] + tb[2]) // 2
    title_cy = (tb[1] + tb[3]) // 2
    _draw_text(draw, (title_cx, title_cy), title.upper(), title_font, ink,
               shadow=(0, 0, 0, 130) if not light_plate else (255, 255, 255, 120))

    # accent underline
    rule_w = int(min(title_max_w * 0.9, _text_size(draw, title.upper(), title_font)[0] * 0.5))
    rule_y = tb[3] + int(height * 0.008)
    draw.rounded_rectangle(
        (title_cx - rule_w // 2, rule_y, title_cx + rule_w // 2, rule_y + max(3, int(height * 0.005))),
        radius=height // 200, fill=accent + (255,),
    )

    # ---- 2. DESCRIPTION -----------------------------------------------------
    # Shrink until it fits in at most two lines inside its own band. The old
    # failure mode was a fixed font size overflowing down into the card row.
    db_ = layout["desc_box"]
    desc_w = db_[2] - db_[0]
    desc_h = db_[3] - db_[1]
    desc_font = _font("medium", int(height * 0.034))
    desc_lines: list[str] = []
    size = int(height * 0.034)
    while size > 10:
        desc_font = _font("medium", size)
        desc_lines = _wrap(draw, description, desc_font, desc_w)
        line_h = int(size * 1.34)
        if len(desc_lines) <= 2 and len(desc_lines) * line_h <= desc_h:
            break
        size = int(size * 0.92) - 1
    desc_lines = desc_lines[:2]

    line_h = int(size * 1.34)
    dy = db_[1] + (desc_h - len(desc_lines) * line_h) // 2 + line_h // 2
    for line in desc_lines:
        _draw_text(draw, ((db_[0] + db_[2]) // 2, dy), line, desc_font, sub_ink,
                   shadow=(0, 0, 0, 90) if not light_plate else None)
        dy += line_h

    # ---- 3. RECIPIENT CARDS -------------------------------------------------
    for card, person in zip(layout["cards"], recipients):
        x, y, cw, ch = card["x"], card["y"], card["w"], card["h"]
        disc = card["disc"]

        ambient = _region_mean_rgb(canvas, (x, y, x + cw, y + ch))
        panel_tint = _mix(ambient, (255, 255, 255) if light_plate else (0, 0, 0), 0.35)

        _frosted_panel(
            canvas, (x, y, x + cw, y + ch), radius=int(cw * 0.09),
            tint=panel_tint, tint_alpha=64, blur=26,
            border=(_mix(ink, ambient, 0.55) + (70,)),
        )

        photo = person.get("_image")
        dx, dy_ = card["disc_x"], card["disc_y"]
        if photo is not None:
            local_ambient = _region_mean_rgb(canvas, (dx, dy_, dx + disc, dy_ + disc))
            ring = _mix(accent, (255, 255, 255), 0.15)
            hero, mask = _render_photo_disc(photo, disc, local_ambient, accent, ring)
            # A heavy shadow reads as a grey halo on light plates, so weight it
            # to the plate rather than using one fixed value.
            _paste_shadow(canvas, mask, (dx, dy_),
                          blur=int(disc * 0.085), offset=(0, int(disc * 0.055)),
                          opacity=90 if light_plate else 130,
                          spread=int(disc * 0.004))
            canvas.alpha_composite(hero, (dx, dy_))
        else:
            ph = Image.new("RGBA", (disc, disc), _mix(ambient, ink, 0.25) + (200,))
            ph.putalpha(_circle_mask(disc))
            canvas.alpha_composite(ph, (dx, dy_))

        draw = ImageDraw.Draw(canvas)
        text_cx = x + cw // 2
        name_y = dy_ + disc + int(ch * 0.095)

        name = (person.get("name") or "").strip()
        name_font = _fit_font(draw, name, "bold", int(cw * 0.88), int(disc * 0.155))
        _draw_text(draw, (text_cx, name_y), name, name_font, ink,
                   shadow=(0, 0, 0, 110) if not light_plate else None)

        achievement = (person.get("achievement") or "").strip()
        if achievement:
            ach_font = _fit_font(draw, achievement, "medium", int(cw * 0.86), int(disc * 0.100))
            # Clearance must exceed the name's descender depth, or the pill
            # crops the tails of letters like g, y and p.
            ach_y = name_y + int(disc * 0.215)
            pill_w = _text_size(draw, achievement, ach_font)[0] + int(disc * 0.16)
            pill_h = int(disc * 0.170)
            draw.rounded_rectangle(
                (text_cx - pill_w // 2, ach_y - pill_h // 2,
                 text_cx + pill_w // 2, ach_y + pill_h // 2),
                radius=pill_h // 2, fill=accent + (215,),
            )
            _draw_text(draw, (text_cx, ach_y), achievement, ach_font, (255, 255, 255), shadow=None)

    # ---- 4. LOGO ------------------------------------------------------------
    _place_logo(canvas, logo, layout["logo_h"],
                layout["logo_margin_x"], layout["logo_margin_y"], position="bottom-right")

    return canvas.convert("RGB")


