_font_cache: dict[tuple[str, int], ImageFont.FreeTypeFont] = {}


def _font(weight: str, size: int) -> ImageFont.FreeTypeFont:
    size = max(8, int(size))
    key = (weight, size)
    if key in _font_cache:
        return _font_cache[key]

    for candidate in _FONT_CANDIDATES.get(weight, _FONT_CANDIDATES["regular"]):
        path = candidate if os.path.isabs(candidate) else os.path.join(FONT_DIR, candidate)
        if os.path.exists(path):
            try:
                f = ImageFont.truetype(path, size)
                _font_cache[key] = f
                return f
            except Exception:  # noqa: BLE001
                continue

    f = ImageFont.load_default()
    _font_cache[key] = f  # type: ignore[assignment]
    return f  # type: ignore[return-value]


def _text_size(draw: ImageDraw.ImageDraw, text: str, font) -> tuple[int, int]:
    box = draw.textbbox((0, 0), text, font=font)
    return box[2] - box[0], box[3] - box[1]


def _fit_font(draw: ImageDraw.ImageDraw, text: str, weight: str,
              max_width: int, start: int, minimum: int = 12) -> ImageFont.FreeTypeFont:
    """Shrink until the string fits max_width. Never lets text overflow the canvas."""
    size = start
    while size > minimum:
        f = _font(weight, size)
        if _text_size(draw, text, f)[0] <= max_width:
            return f
        size = int(size * 0.94) - 1
    return _font(weight, minimum)


def _wrap(draw: ImageDraw.ImageDraw, text: str, font, max_width: int) -> list[str]:
    words = (text or "").split()
    if not words:
        return []
    lines: list[str] = []
    current = words[0]
    for word in words[1:]:
        trial = f"{current} {word}"
        if _text_size(draw, trial, font)[0] <= max_width:
            current = trial
        else:
            lines.append(current)
            current = word
    lines.append(current)
    return lines


