def _smart_crop(img: Image.Image, target_w: int, target_h: int) -> Image.Image:
    """
    Cover-crop biased toward the upper third so heads do not get cut off.
    Uses OpenCV face detection when available, otherwise the rule-of-thirds bias.
    """
    src_w, src_h = img.size
    scale = max(target_w / src_w, target_h / src_h)
    new_w, new_h = max(target_w, int(src_w * scale)), max(target_h, int(src_h * scale))
    resized = img.resize((new_w, new_h), Image.LANCZOS)

    focus_x, focus_y = new_w / 2, new_h * 0.40  # default: upper-middle

    try:  # optional, silently skipped if cv2 is not installed
        import cv2  # type: ignore
        import numpy as np  # type: ignore

        gray = cv2.cvtColor(np.array(resized), cv2.COLOR_RGB2GRAY)
        cascade = cv2.CascadeClassifier(
            cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
        )
        faces = cascade.detectMultiScale(gray, scaleFactor=1.15, minNeighbors=5)
        if len(faces):
            xs = [x + w / 2 for (x, y, w, h) in faces]
            ys = [y + h / 2 for (x, y, w, h) in faces]
            focus_x = sum(xs) / len(xs)
            focus_y = sum(ys) / len(ys) + min(h for (_, _, _, h) in faces) * 0.15
    except Exception:  # noqa: BLE001
        pass

    left = int(max(0, min(new_w - target_w, focus_x - target_w / 2)))
    top = int(max(0, min(new_h - target_h, focus_y - target_h / 2)))
    return resized.crop((left, top, left + target_w, top + target_h))


def _harmonise(photo: Image.Image, ambient: tuple[int, int, int],
               strength: float = 0.16) -> Image.Image:
    """
    Make a real photograph sit inside a generated scene.

    Real photos fail to blend because their white balance, exposure and grain
    come from a different world than the plate. We pull each of those partway
    toward the local background: a light ambient tint, a partial luminance
    match, a touch of contrast, slightly reduced saturation, and a gentle
    sharpen so downscaled headshots stay crisp.
    """
    photo = photo.convert("RGB")

    tint = Image.new("RGB", photo.size, ambient)
    out = Image.blend(photo, tint, strength)

    photo_lum = ImageStat.Stat(photo.convert("L")).mean[0] or 1.0
    ambient_lum = _luminance(ambient)
    target_lum = photo_lum + (ambient_lum - photo_lum) * 0.22
    factor = max(0.78, min(1.28, target_lum / photo_lum))
    out = ImageEnhance.Brightness(out).enhance(factor)

    out = ImageEnhance.Contrast(out).enhance(1.07)
    out = ImageEnhance.Color(out).enhance(0.93)
    out = out.filter(ImageFilter.UnsharpMask(radius=2, percent=65, threshold=3))
    return out


def _rim_light(size: int, colour: tuple[int, int, int], strength: int = 70) -> Image.Image:
    """Accent-coloured rim on the photo edge — sells the 'lit by the scene' look."""
    outer = Image.new("L", (size, size), 0)
    ImageDraw.Draw(outer).ellipse((0, 0, size - 1, size - 1), fill=strength)
    inner = Image.new("L", (size, size), 0)
    inset = max(2, int(size * 0.045))
    ImageDraw.Draw(inner).ellipse((inset, inset, size - 1 - inset, size - 1 - inset), fill=strength)
    ring = ImageChops.subtract(outer, inner).filter(ImageFilter.GaussianBlur(size * 0.02))

    layer = Image.new("RGBA", (size, size), colour + (0,))
    layer.putalpha(ring)
    return layer


def _render_photo_disc(photo: Image.Image, diameter: int, ambient: tuple[int, int, int],
                       accent: tuple[int, int, int], ring_colour: tuple[int, int, int]) -> tuple[Image.Image, Image.Image]:
    """Return (RGBA disc ready to composite, alpha mask for the shadow)."""
    ss = 2  # render at 2x then downsample for clean edges
    d = diameter * ss

    cropped = _smart_crop(photo, d, d)
    cropped = _harmonise(cropped, ambient)

    disc = cropped.convert("RGBA")
    mask = _circle_mask(d, supersample=2, feather=d * 0.004)
    disc.putalpha(mask)

    # accent ring drawn just outside the photo edge
    ring_w = max(3, int(d * 0.022))
    ring_layer = Image.new("RGBA", (d, d), (0, 0, 0, 0))
    ImageDraw.Draw(ring_layer).ellipse(
        (ring_w // 2, ring_w // 2, d - 1 - ring_w // 2, d - 1 - ring_w // 2),
        outline=ring_colour + (235,), width=ring_w,
    )
    disc.alpha_composite(ring_layer)
    disc.alpha_composite(_rim_light(d, accent, strength=64))

    disc = disc.resize((diameter, diameter), Image.LANCZOS)
    final_mask = _circle_mask(diameter, supersample=2, feather=0.8)
    return disc, final_mask


