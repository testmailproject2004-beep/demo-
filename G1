async def handle_banner_refine(
    request: Request,
    domain: HLSDomainType,
    db: AsyncSession
):
    """Refine an existing banner under the same transaction UUID."""

    try:
        data = await request.json()

        transaction_uuid = data.get('transaction_uuid', '').strip()
        feedback = data.get('feedback', '').strip()
        user_id = data.get('user_id', '')
        user_name = data.get('user_name', '')

        if not transaction_uuid:
            return JSONResponse(
                content={"success": False, "error": "Missing transaction_uuid"},
                status_code=400
            )

        if not feedback:
            return JSONResponse(
                content={"success": False, "error": "Missing feedback"},
                status_code=400
            )

        # Look up the transaction to find the current image path
        result = await db.execute(
            select(HLSTransaction).where(
                HLSTransaction.uuid == transaction_uuid
            )
        )
        transaction = result.scalars().first()

        if not transaction:
            return JSONResponse(
                content={"success": False, "error": "Transaction not found"},
                status_code=404
            )

        existing_edits = (
            json.loads(transaction.edited_file_paths)
            if transaction.edited_file_paths
            else []
        )

        # Resolve which version to refine from.
        # source_version_idx: 0 = original, 1 = first edit, 2 = second edit, ...
        source_version_idx = data.get('source_version_idx')

        if source_version_idx is None:
            current_image_path = (
                existing_edits[-1]
                if existing_edits
                else transaction.output_file_path
            )
        else:
            
            try:
                source_version_idx = int(source_version_idx)
            except (TypeError, ValueError):
                return JSONResponse(
                    content={"success": False, "error": "Invalid source_version_idx"},
                    status_code=400
                )


            if source_version_idx == 0:
                current_image_path = transaction.output_file_path
            else:
                edit_idx = source_version_idx - 1

                if edit_idx >= len(existing_edits):
                    return JSONResponse(
                        content={
                            "success": False,
                            "error": f"Version {source_version_idx} not found "
                                     f"(only {len(existing_edits)} edits exist)"
                        },
                        status_code=404
                    )

                current_image_path = existing_edits[edit_idx]

        if not current_image_path or not os.path.exists(current_image_path):
            return JSONResponse(
                content={
                    "success": False,
                    "error": "Current banner image not found on disk"
                },
                status_code=404
            )

        with open(current_image_path, 'rb') as f:
            current_image_bytes = f.read()

        ext = os.path.splitext(current_image_path)[1].lower()
        image_mime = {
            '.png': 'image/png',
            '.jpg': 'image/jpeg',
            '.jpeg': 'image/jpeg'
        }.get(ext, 'image/png')

        print(
            f"🖼️  Refining banner from disk: "
            f"{current_image_path} ({len(current_image_bytes)} bytes)"
        )

        # Send image + feedback directly to Gemini
        api_key = await get_constant("gemini_api_key", db)

        image_data = await asyncio.to_thread(
            refine_banner_image,
            current_image_bytes,
            image_mime,
            feedback,
            api_key
        )


        if not image_data:
