async def generate_banner_image(
    image_prompt: str,
    db: AsyncSession,
    logo_bytes: bytes | None = None,
    logo_mime: str = "image/png"
) -> bytes:
    """Call LiteLLM Gemini to generate the banner. Passes logo as image input if provided."""
    print("🖼️  Calling LiteLLM Gemini for hero banner generation...")

    if logo_bytes:
        print(f"🏷️  Brand logo included ({len(logo_bytes)} bytes, {logo_mime})")

    result = await image_llm_aexecute(
        prompt=image_prompt,
        db=db,
        image_bytes=logo_bytes,
        image_mime=logo_mime
    )

    if result.get("status_code") != 200:
        raise ValueError(
            result.get("message")
            or result.get("error")
            or "LiteLLM Gemini image generation failed"
        )

    image_data = result.get("image_bytes")

    if not image_data:
        raise ValueError("No image bytes returned from LiteLLM Gemini")

    return image_data


