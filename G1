        existing_edits.append(os.path.abspath(file_path))
        transaction.edited_file_paths = json.dumps(existing_edits)

        await db.commit()

        print(f"✅ edited_file_paths updated ({len(existing_edits)} edits)")

        with open(file_path, 'rb') as rf:
            final_refined_data = rf.read()

        return Response(
            content=final_refined_data,
            media_type="image/png",
            headers={
                "Content-Disposition": f'attachment; filename="{file_name}"',
                "X-Transaction-UUID": str(transaction_uuid),
                "X-Version-Number": str(version_num),
                "Access-Control-Expose-Headers": "X-Transaction-UUID, X-Version-Number"
            }
        )

    except Exception as e:
        await db.rollback()

        logger.error(f"Error in handle_banner_refine: {e}")

        import traceback
        traceback.print_exc()

        return JSONResponse(
            content={"success": False, "error": str(e)},
            status_code=500
        )

