/// <reference types="vite/client" />
// The line above is what makes `import.meta.glob` below type-check. It
// works per-file, independent of whatever's in the project's tsconfig
// "types" array — so this resolves "Property 'glob' does not exist on
// type 'ImportMeta'" without needing any project-wide config change.
import { useEffect, useMemo, useRef, useState } from 'react';
import {
  AlertCircle,
  Check,
  Download,
  ImagePlus,
  Loader,
  Sparkles,
  Wand2,
  X,
} from 'lucide-react';
import { middleware_url } from '../../utils/constants';

// ---------------------------------------------------------------------------
// Template library
// ---------------------------------------------------------------------------
//
// Templates are discovered from src/hls_src/assets/Templates/ automatically
// — no filename or extension needs to be known ahead of time. Drop a new
// image in that folder (any of .jpg/.jpeg/.png/.webp) and it appears in the
// picker on the next build/reload; delete one and it disappears. This
// replaced an earlier version with 11 hardcoded imports, which broke the
// moment a real filename or extension didn't match what had been guessed
// from a photo of the folder.
//
// IMPORTANT: the backend (batch_process/.../hls_platform/assets/Templates)
// keeps its own copy of the same images, used for the actual edit. The id
// derived below (the filename without its extension, e.g. "template-6")
// must exist as a same-stem file on the backend too — extension can differ
// there, the backend searches .jpg/.jpeg/.png/.webp for a given id.
//
// Display names default to a prettified version of the filename. Override
// any of them here without renaming the actual file:
const TEMPLATE_NAME_OVERRIDES: Record<string, string> = {
  // 'template-3': 'Sales Champion',
};

const templateModules = import.meta.glob<{ default: string }>(
  '../assets/Templates/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);

interface BannerTemplate {
  id: string;
  name: string;
  image: string;
}

function idFromPath(path: string): string {
  const filename = path.split('/').pop() ?? path;
  return filename.replace(/\.[^./]+$/, '');
}

function prettify(id: string): string {
  const match = id.match(/^template-(\d+)$/i);
  if (match) return `Template ${match[1]}`;
  return id
    .replace(/[_-]+/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function naturalCompare(a: string, b: string): number {
  return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
}

const TEMPLATE_LIBRARY: BannerTemplate[] = Object.entries(templateModules)
  .map(([path, mod]) => {
    const id = idFromPath(path);
    return {
      id,
      name: TEMPLATE_NAME_OVERRIDES[id] ?? prettify(id),
      image: mod.default,
    };
  })
  .sort((a, b) => naturalCompare(a.id, b.id));

// Matches BANNER_SIZES in banner.py — Gemini's full supported ratio set,
// not a narrower guess of my own. Keeping these two lists in the same
// order/values as that dict means a template's detected native ratio can
// never point at a value the dropdown doesn't actually offer.
const COMMON_RATIOS: Record<string, number> = {
  '1:1': 1,
  '3:2': 3 / 2,
  '2:3': 2 / 3,
  '3:4': 3 / 4,
  '4:3': 4 / 3,
  '4:5': 4 / 5,
  '5:4': 5 / 4,
  '9:16': 9 / 16,
  '16:9': 16 / 9,
  '21:9': 21 / 9,
};

function nearestAspectRatio(width: number, height: number): string {
  const actual = width / height;
  let best = '16:9';
  let bestDelta = Infinity;
  for (const [label, ratio] of Object.entries(COMMON_RATIOS)) {
    const delta = Math.abs(ratio - actual);
    if (delta < bestDelta) {
      best = label;
      bestDelta = delta;
    }
  }
  return best;
}

const aspectRatioOptions = [
  { value: '1:1', label: '1:1 · Square' },
  { value: '3:2', label: '3:2 · Standard landscape' },
  { value: '2:3', label: '2:3 · Standard portrait' },
  { value: '3:4', label: '3:4 · Portrait' },
  { value: '4:3', label: '4:3 · Landscape' },
  { value: '4:5', label: '4:5 · Tall square' },
  { value: '5:4', label: '5:4 · Wide square' },
  { value: '9:16', label: '9:16 · Story / skyscraper' },
  { value: '16:9', label: '16:9 · Widescreen' },
  { value: '21:9', label: '21:9 · Ultra widescreen' },
] as const;

interface HistoryItem {
  title: string;
  time: string;
  image: string;
}

interface SalesBannerGeneratorProps {
  /** Called when the modal is dismissed (X, Cancel). Either prop works. */
  onClose?: () => void;
  onBack?: () => void;
  /**
   * Set to false if you render this inside an existing modal/dialog wrapper,
   * so it doesn't add a second full-screen overlay of its own.
   */
  overlay?: boolean;
}

const labelClass = 'mb-1 block text-[11px] font-semibold uppercase tracking-wider text-slate-500';

const inputClass =
  'w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 transition focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600';

function readFileAsDataUrl(file: File): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(typeof reader.result === 'string' ? reader.result : '');
    reader.onerror = () => reject(new Error('Failed to read image file'));
    reader.readAsDataURL(file);
  });
}

export function SalesBannerGenerator({ onClose, onBack, overlay = true }: SalesBannerGeneratorProps) {
  const handleClose = onClose ?? onBack ?? (() => {});

  // Template list is bundled locally (see TEMPLATE_LIBRARY above) — the
  // picker renders immediately, nothing to fetch or wait on.
  const templates = TEMPLATE_LIBRARY;
  const [selectedTemplateId, setSelectedTemplateId] = useState<string | null>(
    templates[0]?.id ?? null,
  );

  // Core banner fields
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [aspectRatio, setAspectRatio] = useState<string>('16:9');
  const [aspectTouched, setAspectTouched] = useState(false);
  const [prompt, setPrompt] = useState('');

  // Optional photo — if left empty, the backend keeps the person already
  // baked into the template.
  const [photo, setPhoto] = useState<string | null>(null);
  const [photoError, setPhotoError] = useState<string | null>(null);

  // UI state
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [previewUrl, setPreviewUrl] = useState<string | null>(null);
  const [history, setHistory] = useState<HistoryItem[]>([]);
  // Captured from the X-Transaction-UUID response header. Not used yet —
  // your banner.py already has a refine-by-feedback flow keyed on this
  // (handle_banner_refine); if you want the "Anything else to change?"
  // field to hit that instead of a full regenerate, this is what a
  // /banner/refine call would need.
  const [lastTransactionId, setLastTransactionId] = useState<string | null>(null);

  // Object URLs from generated blobs need explicit cleanup, but history
  // thumbnails reference the same URLs as past previews — revoking on
  // every previewUrl change would break old history entries the moment a
  // second banner is generated. Track everything created this session and
  // revoke it only when the modal itself unmounts.
  const objectUrlsRef = useRef<string[]>([]);
  useEffect(() => {
    return () => {
      objectUrlsRef.current.forEach((url) => URL.revokeObjectURL(url));
    };
  }, []);

  // Native aspect ratio per template, probed client-side by loading each
  // image once. Populates progressively; a template selected before its
  // probe resolves just keeps the current aspect ratio until it does.
  const [nativeRatios, setNativeRatios] = useState<Record<string, string>>({});

  useEffect(() => {
    let cancelled = false;
    templates.forEach((template) => {
      const img = new Image();
      img.onload = () => {
        if (cancelled) return;
        const ratio = nearestAspectRatio(img.naturalWidth, img.naturalHeight);
        setNativeRatios((prev) => ({ ...prev, [template.id]: ratio }));
      };
      img.src = template.image;
    });
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const selectedTemplate = useMemo(
    () => templates.find((t) => t.id === selectedTemplateId) ?? null,
    [templates, selectedTemplateId],
  );

  // Once a template's native ratio resolves, adopt it as the default —
  // unless the user already deliberately picked a different one.
  useEffect(() => {
    if (!selectedTemplateId || aspectTouched) return;
    const ratio = nativeRatios[selectedTemplateId];
    if (ratio) setAspectRatio(ratio);
  }, [selectedTemplateId, nativeRatios, aspectTouched]);

  function selectTemplate(template: BannerTemplate) {
    setSelectedTemplateId(template.id);
    if (!aspectTouched && nativeRatios[template.id]) {
      setAspectRatio(nativeRatios[template.id]);
    }
  }

  async function handlePhotoUpload(file: File | null) {
    if (!file) return;
    if (!['image/png', 'image/jpeg', 'image/jpg', 'image/webp'].includes(file.type)) {
      setPhotoError('Only PNG, JPG, or WEBP files are supported');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      setPhotoError('Image size must be under 10MB');
      return;
    }
    try {
      setPhoto(await readFileAsDataUrl(file));
      setPhotoError(null);
    } catch {
      setPhotoError('Failed to read image file');
    }
  }

