def _load_logo() -> Image.Image | None:
    if not os.path.exists(LOGO_PATH):
        logger.warning("Zensar logo not found at %s — banner will render without it", LOGO_PATH)
        return None
    try:
        return Image.open(LOGO_PATH).convert("RGBA")
    except Exception as exc:  # noqa: BLE001
        logger.warning("Could not open logo: %s", exc)
        return None


def _logo_alpha(logo: Image.Image) -> Image.Image:
    """
    Build a usable alpha mask from a flat-black logo.

    Handles both shapes we see in practice:
      * PNG with real transparency -> use its alpha directly
      * black artwork on an opaque white background -> derive alpha from
        inverted luminance, so the black strokes become the opaque part
    """
    alpha = logo.split()[3]
    extrema = alpha.getextrema()
    if extrema[0] < 250:  # genuine transparency present
        return alpha

    grey = logo.convert("L")
    derived = ImageChops.invert(grey)
    # stretch so near-white background goes fully transparent
    return derived.point(lambda p: 0 if p < 26 else min(255, int((p - 26) * 1.35)))


def _recolour_logo(logo: Image.Image, colour: tuple[int, int, int]) -> Image.Image:
    """Repaint a monochrome logo in a solid colour, preserving its shape and edges."""
    alpha = _logo_alpha(logo)
    out = Image.new("RGBA", logo.size, colour + (0,))
    out.putalpha(alpha)
    return out


def _place_logo(canvas: Image.Image, logo: Image.Image | None,
                target_h: int, margin_x: int, margin_y: int,
                position: str = "bottom-right") -> None:
    """
    Auto black/white selection: measure the luminance of the pixels the logo will
    actually cover, then choose the version with the stronger contrast. A soft
    plate is added only when the area behind it is too busy to guarantee contrast.
    """
    if logo is None:
        return

    ratio = logo.width / logo.height
    lw, lh = max(1, int(target_h * ratio)), target_h

    if position == "bottom-right":
        x, y = canvas.width - margin_x - lw, canvas.height - margin_y - lh
    elif position == "bottom-left":
        x, y = margin_x, canvas.height - margin_y - lh
    elif position == "top-right":
        x, y = canvas.width - margin_x - lw, margin_y
    else:
        x, y = margin_x, margin_y

    pad = int(lh * 0.35)
    probe = (x - pad, y - pad, x + lw + pad, y + lh + pad)
    lum = _region_luminance(canvas, probe)

    patch = canvas.convert("RGB").crop((
        max(0, probe[0]), max(0, probe[1]),
        min(canvas.width, probe[2]), min(canvas.height, probe[3]),
    ))
    busy = ImageStat.Stat(patch.convert("L")).stddev[0]

    colour = (17, 17, 17) if lum > 150 else (255, 255, 255)

    # High local variance means neither pure white nor pure black is safe.
    if busy > 58:
        plate_colour = (255, 255, 255) if lum > 150 else (10, 12, 18)
        _frosted_panel(
            canvas, (x - pad, y - int(pad * 0.8), x + lw + pad, y + lh + int(pad * 0.8)),
            radius=int(lh * 0.35), tint=plate_colour, tint_alpha=150, blur=14,
        )
        colour = (17, 17, 17) if plate_colour == (255, 255, 255) else (255, 255, 255)

    coloured = _recolour_logo(logo, colour).resize((lw, lh), Image.LANCZOS)
    canvas.alpha_composite(coloured, (x, y))


