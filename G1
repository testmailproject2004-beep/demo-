def build_plate_prompt(llm, *, title: str, description: str, theme: str,
                       template_id: str, background_style: str, aspect_ratio: str,
                       accent_hex: str, layout: dict[str, Any], count: int) -> str:
    """
    Ask the text LLM for an image prompt that describes an EMPTY STAGE.

    Note what is deliberately excluded: people, faces, text, logos. Anything the
    image model draws in those categories is something we would have to cover up
    or fight later, so we simply never ask for it.
    """
    preset = TEMPLATE_PRESETS.get(template_id, TEMPLATE_PRESETS["employee-recognition"])
    style_desc = BACKGROUND_STYLES.get(background_style, BACKGROUND_STYLES["corporate-blue-gradient"])

    h, w = layout["height"], layout["width"]
    tb, db = layout["title_box"], layout["desc_box"]
    cards = layout["cards"]
    card_top = min(c["y"] for c in cards)
    card_bottom = max(c["y"] + c["h"] for c in cards)
    card_left = min(c["x"] for c in cards)
    card_right = max(c["x"] + c["w"] for c in cards)

    def pct(v: float, total: int) -> int:
        return int(round(v / total * 100))

    meta_prompt = f"""
You are an art director writing a single image-generation prompt for a corporate
award-banner BACKGROUND PLATE.

This plate is a backdrop only. Real photographs, real text and a real logo are
composited on top of it afterwards by a separate deterministic renderer.

CONTEXT (for mood only — do NOT render any of these words into the image):
• Occasion  : {title}
• Message   : {description}
• Theme     : {theme}
• Mood      : {preset['mood']}
• Palette   : anchor colour {accent_hex}; {style_desc}
• Ratio     : {aspect_ratio}

ABSOLUTE EXCLUSIONS — the prompt you write must forbid all of these:
1. NO people, NO faces, NO human figures, NO silhouettes, NO hands, NO body parts.
2. NO text, NO letters, NO numbers, NO words, NO typography of any kind.
3. NO logos, NO wordmarks, NO badges with writing, NO watermarks.
4. NO empty picture frames, NO portrait placeholders, NO avatar circles,
   NO podium figures, NO trophy engraved with text.

RESERVED CLEAN ZONES — these areas must stay visually calm: low contrast, no
busy detail, no focal elements, nothing the eye catches on:
• Top band, {pct(tb[1], h)}%–{pct(db[3], h)}% of height, full width — headline area.
• Centre block, {pct(card_left, w)}%–{pct(card_right, w)}% width and
  {pct(card_top, h)}%–{pct(card_bottom, h)}% height — recipient area
  ({count} card{'s' if count > 1 else ''} will be placed here).
• Bottom-right corner, last 22% width and last 14% height — logo area;
  keep it a flat, even tone.

WHAT THE PLATE SHOULD CONTAIN:
• A rich, premium, full-bleed abstract environment: {style_desc}
• Depth via soft gradients, gentle bokeh, subtle light rays or glass reflections
• Decorative interest pushed to the EDGES and CORNERS, away from the reserved zones
• Optional non-figurative motifs: light ribbons, geometric line-work, particle
  glow, soft laurel-like abstract curves — all subtle, none in the reserved zones
• Even, predictable tone in the reserved zones so overlaid white or dark text
  stays legible

OUTPUT RULES:
• Return ONLY the final image-generation prompt. No preamble, no markdown.
• Restate the exclusions and the reserved zones inside the prompt you produce.
• End with: "aspect ratio {aspect_ratio}, ultra high resolution, clean, premium."

Write the background plate prompt now.
"""
    response = llm.invoke(meta_prompt)
    prompt = (getattr(response, "content", None) or str(response)).strip()
    logger.info("Plate prompt (%s): %s...", aspect_ratio, prompt[:220])
    return prompt


def _procedural_plate(width: int, height: int, accent: tuple[int, int, int],
                      background_style: str) -> Image.Image:
    """
    Deterministic fallback plate. Used when Gemini errors, rate-limits, or returns
    nothing — the endpoint still produces a presentable banner rather than a 500.
    """
    light = background_style in LIGHT_STYLES
    if light:
        top, bottom = (250, 251, 253), (228, 233, 241)
    else:
        top = _mix(accent, (8, 12, 30), 0.55)
        bottom = _mix(accent, (2, 4, 14), 0.82)

    base = Image.new("RGB", (width, height))
    draw = ImageDraw.Draw(base)
    for y in range(height):
        t = y / max(1, height - 1)
        draw.line([(0, y), (width, y)], fill=_mix(top, bottom, t))

    glow = Image.new("RGBA", (width, height), (0, 0, 0, 0))
    gd = ImageDraw.Draw(glow)
    radius = int(min(width, height) * 0.75)
    gd.ellipse(
        (int(width * 0.62) - radius, int(height * 0.10) - radius,
         int(width * 0.62) + radius, int(height * 0.10) + radius),
        fill=accent + ((46,) if not light else (26,)),
    )
    gd.ellipse(
        (int(width * 0.05) - radius // 2, int(height * 0.95) - radius // 2,
         int(width * 0.05) + radius // 2, int(height * 0.95) + radius // 2),
        fill=_mix(accent, (255, 255, 255), 0.4) + (30,),
    )
    glow = glow.filter(ImageFilter.GaussianBlur(int(min(width, height) * 0.12)))
    base = Image.alpha_composite(base.convert("RGBA"), glow).convert("RGB")

    vignette = Image.new("L", (width, height), 0)
    ImageDraw.Draw(vignette).ellipse(
        (int(-width * 0.18), int(-height * 0.18), int(width * 1.18), int(height * 1.18)), fill=255
    )
    vignette = vignette.filter(ImageFilter.GaussianBlur(int(min(width, height) * 0.09)))
    dark = Image.new("RGB", (width, height), (0, 0, 0) if not light else (190, 196, 208))
    base = Image.composite(base, dark, vignette)
    return base


async def _generate_plate(prompt: str, db: AsyncSession, width: int, height: int,
                          accent: tuple[int, int, int], background_style: str) -> tuple[Image.Image, bool]:
    """Returns (plate, used_ai). Never raises — falls back to the procedural plate."""
    try:
        result = await image_llm_aexecute(prompt=prompt, db=db)
        if result.get("status_code") == 200 and result.get("image_bytes"):
            plate = _open_rgb(result["image_bytes"])
            plate = _smart_crop(plate, width, height) if plate.size != (width, height) else plate
            return plate, True
        logger.warning("Plate generation returned no image: %s", result.get("message") or result.get("error"))
    except Exception as exc:  # noqa: BLE001
        logger.warning("Plate generation failed, using procedural fallback: %s", exc)

    return _procedural_plate(width, height, accent, background_style), False


