# ---------------------------------------------------------------------------
# Refine by feedback
# ---------------------------------------------------------------------------
#
# Self-contained to this module — does not import from, depend on, or
# modify banner.py (a different factory). Reuses only the generic
# zenseai_content_factory_repo helpers (fetch_hls_transaction_by_uuid is
# not banner-specific — it's the same generic lookup used across the
# platform), plus this file's own _refine_edit above.
#
# Keyed on the X-Transaction-UUID a successful /banner/generate call
# returns. Refines from the latest existing edit if there is one,
# otherwise from the original — same "iterative chain" behaviour as the
# rest of this platform's versioning, so repeated feedback keeps building
# on the last result rather than always starting over from the original.


async def sales_banner_refine_handler(request: Request, db: AsyncSession) -> Response:
    try:
        try:
            raw_body = await request.json()
        except Exception:
            return JSONResponse(
                content={"success": False, "error": "Request body is not valid JSON."},
                status_code=400,
            )
        if not isinstance(raw_body, dict):
            return JSONResponse(
                content={"success": False, "error": "Request body must be a JSON object."},
                status_code=400,
            )

        transaction_uuid = (raw_body.get("transaction_uuid") or "").strip()
        feedback = (raw_body.get("feedback") or "").strip()

        if not transaction_uuid:
            return JSONResponse(
                content={"success": False, "error": "Missing transaction_uuid."}, status_code=400
            )
        if not feedback:
            return JSONResponse(
                content={"success": False, "error": "Missing feedback."}, status_code=400
            )

        from ..repository.zenseai_content_factory_repo import fetch_hls_transaction_by_uuid

        transaction = await fetch_hls_transaction_by_uuid(db, transaction_uuid)
        if not transaction:
            return JSONResponse(
                content={"success": False, "error": "Transaction not found."}, status_code=404
            )

        existing_edits = (
            json.loads(transaction.edited_file_paths) if transaction.edited_file_paths else []
        )
        current_image_path = Path(existing_edits[-1] if existing_edits else transaction.output_file_path)

        if not current_image_path.exists():
            return JSONResponse(
                content={"success": False, "error": "Current banner image not found on disk."},
                status_code=404,
            )

        current_bytes = current_image_path.read_bytes()
        current_mime = _mime_for(current_image_path)

        # Preserve the existing image's own aspect ratio rather than
        # guessing — this is an edit of what's already there, not a new
        # generation, so the canvas shouldn't change shape.
        try:
            from PIL import Image as PILImage

            with PILImage.open(current_image_path) as img:
                aspect_ratio = _nearest_common_ratio(img.width, img.height)
        except Exception:
            aspect_ratio = "16:9"

        api_key = None
        api_key_source = "none"
        try:
            api_key = await get_constant("gemini_api_key", db)
            if api_key:
                api_key_source = "db"
        except Exception as exc:
            logger.warning(f"get_constant('gemini_api_key') failed, using env fallback: {exc}")
        if not api_key:
            api_key = os.getenv("GEMINI_API_KEY", "")
            if api_key:
                api_key_source = "env"
        if not api_key:
            return JSONResponse(
                content={"success": False, "error": "Gemini API key is not configured."},
                status_code=502,
            )
        masked = f"{api_key[:6]}…{api_key[-4:]}" if len(api_key) > 12 else "(too short to mask safely)"
        print(f"🔑 [{transaction_uuid}] Gemini API key resolved from {api_key_source}: {masked}")

        try:
            refined_bytes = await _refine_edit(
                current_bytes, current_mime, feedback, aspect_ratio, api_key, transaction_uuid
            )
        except Exception as exc:
            return JSONResponse(
                content={"success": False, "error": f"Refine failed: {exc}"}, status_code=502
            )

        version_num = len(existing_edits) + 2
        base = current_image_path.stem
        # Strip any prior _vN suffix so chained refinements don't produce
        # names like foo_v2_v3_v4.png.
        base = re.sub(r"_v\d+$", "", base)
        new_file_name = f"{base}_v{version_num}.png"
        new_path = current_image_path.parent / new_file_name
        counter = version_num
        while new_path.exists():
            counter += 1
            new_file_name = f"{base}_v{counter}.png"
            new_path = current_image_path.parent / new_file_name
        new_path.write_bytes(refined_bytes)

        existing_edits.append(str(new_path))
        transaction.edited_file_paths = json.dumps(existing_edits)
        try:
            await db.commit()
        except Exception as exc:
            logger.warning(f"[{transaction_uuid}] Could not save edited_file_paths: {exc}")
            try:
                await db.rollback()
            except Exception:
                pass
            # The refined image itself is still valid and on disk — return
            # it even if the DB bookkeeping failed, same "don't block the
            # actual result over metadata" principle as generate.

        print(f"✅ [{transaction_uuid}] Refined banner saved: {new_path}")

        return Response(
            content=refined_bytes,
            media_type="image/png",
            headers={
                "Content-Disposition": f'attachment; filename="{new_file_name}"',
                "X-Transaction-UUID": transaction_uuid,
                "X-Version-Number": str(version_num),
                "Access-Control-Expose-Headers": "X-Transaction-UUID, X-Version-Number",
            },
        )

    except Exception as e:
        logger.error(f"Error in sales_banner_refine_handler: {e}")
        traceback.print_exc()
        return JSONResponse(content={"success": False, "error": str(e)}, status_code=500)



