# Gemini-supported aspect ratios with display names
BANNER_SIZES = {
    '1:1':  'Square',
    '3:2':  'Standard Landscape',
    '2:3':  'Standard Portrait',
    '3:4':  'Portrait',
    '4:3':  'Landscape',
    '4:5':  'Tall Square',
    '5:4':  'Wide Square',
    '9:16': 'Story / Skyscraper',
    '16:9': 'Widescreen',
    '21:9': 'Ultra Widescreen',
}

# Layout hints per ratio for the image generation prompt
LAYOUT_HINTS = {
    '21:9': "ultra-wide horizontal strip — bold headline far left, dominant visual centre-right",
    '16:9': "wide horizontal strip — bold headline on the left, dominant visual on the right",
    '3:2':  "landscape rectangle — visual dominant left two-thirds, text right third",
    '4:3':  "landscape rectangle — two-zone split: visual left half, headline + supporting line right half",
    '5:4':  "slightly landscape rectangle — headline top, visual centre",
    '1:1':  "square — centred composition: headline top, dominant visual middle",
    '4:5':  "slightly portrait rectangle — headline top, visual large centre",
    '3:4':  "portrait rectangle — stacked top-to-bottom: headline, visual, supporting line",
    '2:3':  "portrait rectangle — stacked: headline, visual",
    '9:16': "tall vertical strip — stacked: small icon top, large bold headline upper-middle, supporting line below",
}


def get_aspect_ratio(size_str: str) -> tuple[str, str]:
    """Return (ratio, label) for a supported Gemini aspect ratio string. Raises ValueError if unsupported."""
    s = size_str.strip()
    if s in BANNER_SIZES:
        return s, BANNER_SIZES[s]
    supported = ', '.join(BANNER_SIZES.keys())
    raise ValueError(f"Unsupported aspect ratio '{size_str}'. Gemini supports: {supported}")


async def get_brand_logo_bytes(
    brand_name: str,
    db: AsyncSession
) -> tuple[bytes | None, str]:
    """Look up brand logo from DB by brand name and return (bytes, mime_type)."""
    try:
        result = await db.execute(
            select(HLSBrand).where(
                HLSBrand.fieldname == 'brand_name',
                HLSBrand.fieldvalue == brand_name
            )
        )
        name_row = result.scalars().first()

        if not name_row:
            logger.info(f"Brand '{brand_name}' not found in DB")
            return None, ''

        result = await db.execute(
            select(HLSBrand).where(
                HLSBrand.brand_id == name_row.brand_id,
                HLSBrand.fieldname == 'brand_logo'
            )
        )
        logo_row = result.scalars().first()

        if not logo_row or not logo_row.fieldvalue:
            logger.info(f"No logo found for brand '{brand_name}'")
            return None, ''

        # Stored as "hls_brand_logos/<brand_id>/<filename>"
        rel = logo_row.fieldvalue

        if rel.startswith('hls_brand_logos/') or rel.startswith('hls_brand_logos\\'):
            rel = rel[len('hls_brand_logos/'):]

        logo_path = os.path.join(BRAND_LOGOS_BASE_DIR, rel)

        if not os.path.exists(logo_path):
            logger.warning(f"Logo file not found on disk: {logo_path}")
            return None, ''

        ext = os.path.splitext(logo_path)[1].lower()
        mime_map = {
            '.png': 'image/png',
            '.jpg': 'image/jpeg',
            '.jpeg': 'image/jpeg',
            '.gif': 'image/gif',
            '.webp': 'image/webp'
        }
        mime_type = mime_map.get(ext, 'image/png')

        with open(logo_path, 'rb') as f:
            return f.read(), mime_type

    except Exception as e:
        logger.warning(f"Could not load brand logo for '{brand_name}': {e}")
        return None, ''


