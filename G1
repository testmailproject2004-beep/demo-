def _canvas_size(aspect_ratio: str) -> tuple[int, int]:
    if aspect_ratio in CANVAS_SIZES:
        return CANVAS_SIZES[aspect_ratio]
    try:
        a, b = aspect_ratio.split(":")
        rw, rh = float(a), float(b)
    except Exception:  # noqa: BLE001
        return CANVAS_SIZES["16:9"]
    if rw >= rh:
        w = 1920
        h = int(round(w * rh / rw / 2) * 2)
    else:
        h = 1600
        w = int(round(h * rw / rh / 2) * 2)
    return (w, h)


def _build_layout(width: int, height: int, count: int) -> dict[str, Any]:
    """
    Compute every rectangle up front. Two reasons:
      1. the LLM prompt can name the exact reserved zones as percentages
      2. compositing becomes pure arithmetic with no surprises
    """
    landscape = width >= height
    count = max(1, min(MAX_RECIPIENTS, count))

    if landscape:
        title_top = height * 0.075
        title_h = height * 0.130
        desc_top = height * 0.242
        desc_h = height * 0.100
        grid_cols, grid_rows = count, 1
        disc_factor = {1: 0.36, 2: 0.31, 3: 0.27, 4: 0.235}[count]
    else:
        title_top = height * 0.060
        title_h = height * 0.095
        desc_top = height * 0.170
        desc_h = height * 0.085
        grid_cols, grid_rows = (count, 1) if count <= 2 else (2, 2)
        disc_factor = {1: 0.30, 2: 0.26, 3: 0.22, 4: 0.22}[count]

    # Card height is derived from what actually goes in it (see CARD_CONTENT_H
    # in compose_banner) rather than guessed, so there is no dead space below
    # the achievement pill.
    disc = int(min(width, height) * disc_factor * (1.0 if landscape else 1.30))
    card_w = int(disc * 1.58)
    card_h = int(disc * 1.76)
    gap_x = int(card_w * 0.15)
    gap_y = int(card_h * 0.10)

    # Free band: everything between the description and the logo strip.
    band_top = desc_top + desc_h + height * 0.020
    band_bottom = height - height * (0.115 if landscape else 0.090)
    band_h = max(1.0, band_bottom - band_top)

    def fits() -> tuple[float, float]:
        return (grid_cols * card_w + (grid_cols - 1) * gap_x,
                grid_rows * card_h + (grid_rows - 1) * gap_y)

    total_w, total_h = fits()
    shrink = min(1.0, (width * 0.92) / total_w, band_h / total_h)
    if shrink < 1.0:
        card_w, card_h = int(card_w * shrink), int(card_h * shrink)
        disc, gap_x, gap_y = int(disc * shrink), int(gap_x * shrink), int(gap_y * shrink)
        total_w, total_h = fits()

    start_x = (width - total_w) // 2
    start_y = int(band_top + (band_h - total_h) / 2)

    cards: list[dict[str, int]] = []
    for index in range(count):
        col, row = index % grid_cols, index // grid_cols
        in_row = min(grid_cols, count - row * grid_cols)
        row_w = in_row * card_w + (in_row - 1) * gap_x
        rx = (width - row_w) // 2
        x = rx + col * (card_w + gap_x)
        y = start_y + row * (card_h + gap_y)
        cards.append({
            "x": x, "y": y, "w": card_w, "h": card_h,
            "disc": disc,
            "disc_x": x + (card_w - disc) // 2,
            "disc_y": y + int(card_h * 0.075),
        })

    return {
        "width": width, "height": height, "landscape": landscape,
        "margin_x": int(width * 0.065),
        "title_box": (int(width * 0.08), int(title_top), int(width * 0.92), int(title_top + title_h)),
        "desc_box": (int(width * 0.13), int(desc_top), int(width * 0.87), int(desc_top + desc_h)),
        "cards": cards,
        "logo_h": int(height * (0.052 if landscape else 0.038)),
        "logo_margin_x": int(width * 0.045),
        "logo_margin_y": int(height * 0.045),
    }


