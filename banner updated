import { useState, useEffect, useCallback, useRef } from "react";
import { Star, MessageSquare, CheckCircle2, Loader2, Send } from "lucide-react";
import { flask_url, middleware_url } from "../../../utils/constants";

// ---------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------
const FEEDBACK_FORMATS = ['movie maker', 'presentation +', 'audio summary', 'video', 'podcast'];

export function isFeedbackFormat(format: string): boolean {
  return FEEDBACK_FORMATS.includes(format.toLowerCase());
}

const STAR_LABELS = ["", "Poor", "Fair", "Good", "Very Good", "Excellent"];

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------
interface ExistingFeedback {
  id: number;
  star_rating: number | null;
  feedback_text: string | null;
}

interface ContentFeedbackProps {
  transactionUuid: string | null;
  formatType: string;
  domain: string;
  /** Called after a rating is submitted so parent can refresh the card star and text */
  onFeedbackSubmitted?: (rating: number | null, text: string | null) => void;
}

// ---------------------------------------------------------------------------
// Main panel component (right-side panel in modal)
// ---------------------------------------------------------------------------
export function ContentFeedback({
  transactionUuid,
  formatType,
  domain,
  onFeedbackSubmitted,
}: ContentFeedbackProps) {
  const [existing, setExisting] = useState<ExistingFeedback | null>(null);
  const [loadingExisting, setLoadingExisting] = useState(true);

  const [hoverRating, setHoverRating] = useState(0);
  const [selectedRating, setSelectedRating] = useState(0);
  const [feedbackText, setFeedbackText] = useState("");
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submitted, setSubmitted] = useState(false);

  const fetchedRef = useRef<string | null>(null);

  // --- fetch existing feedback on mount ---
  const fetchExisting = useCallback(async () => {
    if (!transactionUuid || fetchedRef.current === transactionUuid) {
      setLoadingExisting(false);
      return;
    }
    fetchedRef.current = transactionUuid;
    try {
      const res = await fetch(
        `${middleware_url}/batch_process/sales_platform/content_feedback/${transactionUuid}`,
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      if (res.ok) {
        const data = await res.json();
        if (data.id) {
          setExisting(data);

          if (data.star_rating !== null) {
            setSelectedRating(data.star_rating);
          }
          if (data.feedback_text !== null) {
            setFeedbackText(data.feedback_text);
          }

          // If BOTH are already submitted, switch to the read-only summary view.
          // Otherwise, stay in form view so they can complete the feedback.
          if (data.star_rating !== null && data.feedback_text !== null) {
            setSubmitted(true);
          }
        }
      }
    } catch (_) { }
    finally { setLoadingExisting(false); }
  }, [transactionUuid]);

  useEffect(() => { fetchExisting(); }, [fetchExisting]);

  const submitFeedback = async (rating: number | null, text: string | null) => {
    setIsSubmitting(true);
    try {
      await fetch(`${middleware_url}/batch_process/sales_platform/content_feedback`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${localStorage.getItem("token")}`,
        },
        body: JSON.stringify({
          transaction_uuid: transactionUuid,
          format_type: formatType,
          domain,
          star_rating: rating,
          feedback_text: text,
          user_id: localStorage.getItem("userId") || null,
          user_name: localStorage.getItem("name") || null,
        }),
      });
      setSubmitted(true);
      onFeedbackSubmitted?.(rating, text);
    } catch (err) {
      console.error("Failed to submit feedback:", err);
      setSubmitted(true);
    } finally {
      setIsSubmitting(false);
    }
  };

  if (loadingExisting) {
    return (
      <div className="flex items-center justify-center h-full min-h-[200px]">
        <Loader2 className="size-5 animate-spin text-slate-300" />
      </div>
    );
  }

  // Already submitted — show summary
  if (submitted) {
    const displayRating = existing?.star_rating || selectedRating || null;
    const displayText = existing?.feedback_text || feedbackText || null;
    return (
      <div className="flex flex-col h-full p-3.5">
        <div className="mb-3">
          <div className="flex items-center gap-1.5 mb-0">
            <div className="p-1 bg-purple-50 rounded-md">
              <MessageSquare className="size-3 text-purple-500" />
            </div>
            <p className="text-sm font-semibold text-slate-700">Your Feedback</p>
          </div>
          <p className="text-xs text-slate-400 ml-6 -mt-0.5">Content quality rating</p>
        </div>

        <div className="flex items-center justify-center gap-1 mb-1.5">
          {[1, 2, 3, 4, 5].map((star) => (
            <Star
              key={star}
              className={`size-6 ${star <= (displayRating || 0)
                  ? "fill-amber-400 text-amber-400"
                  : "text-slate-200 fill-slate-100"
                }`}
            />
          ))}
        </div>

        {displayRating ? (
          <p className="text-center text-xs font-semibold text-amber-600 mb-3">
            {STAR_LABELS[displayRating]}
          </p>
        ) : (
          <p className="text-center text-xs text-slate-400 mb-3">No rating given</p>
        )}

        {displayText ? (
          <div className="bg-slate-50 rounded-lg p-3 border border-slate-200 mb-3 min-h-[80px]">
            <p className="text-sm text-slate-700 italic leading-relaxed">
              "{displayText}"
            </p>
          </div>
        ) : null}

        <div className="flex items-center justify-center gap-1.5 py-2 px-3 rounded-full bg-emerald-50 border border-emerald-200 mt-auto">
          <CheckCircle2 className="size-3.5 text-emerald-500 flex-shrink-0" />
          <span className="text-xs font-medium text-emerald-700">Thank you!</span>
        </div>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-full p-3.5">
      {/* Header */}
      <div className="mb-3">
        <div className="flex items-center gap-1.5 mb-0">
          <div className="p-1 bg-purple-50 rounded-md">
            <MessageSquare className="size-3 text-purple-500" />
          </div>
          <p className="text-sm font-semibold text-slate-700">Rate this Content</p>
        </div>
        <p className="text-xs text-slate-400 ml-6 -mt-0.5">Optional</p>
      </div>

      {/* Star rating */}
      <div className="flex items-center justify-center gap-1.5 mb-1">
        {[1, 2, 3, 4, 5].map((star) => (
          <button
            key={star}
            type="button"
            id={`cf-panel-star-${star}`}
            className="transition-transform hover:scale-110 focus:outline-none"
            onMouseEnter={() => setHoverRating(star)}
            onMouseLeave={() => setHoverRating(0)}
            onClick={() => setSelectedRating(selectedRating === star ? 0 : star)}
          >
            <Star
              className={`size-7 transition-colors duration-150 ${star <= (hoverRating || selectedRating)
                  ? "fill-amber-400 text-amber-400"
                  : "text-slate-200 fill-slate-100"
                }`}
            />
          </button>
        ))}
      </div>
      <div className="h-4 mb-2 flex justify-center">
        {selectedRating > 0 && (
          <p className="text-[10px] font-semibold text-amber-600 animate-in fade-in duration-200">
            {STAR_LABELS[selectedRating]}
          </p>
        )}
      </div>

      {/* Text */}
      <p className="text-xs font-medium text-slate-500 mb-1">Comments</p>
      <textarea
        id="cf-panel-feedback-text"
        value={feedbackText}
        onChange={(e) => setFeedbackText(e.target.value)}
        placeholder="Thoughts?"
        rows={3}
        className="w-full text-xs text-slate-700 placeholder-slate-300 border border-slate-200 rounded-lg px-2.5 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-purple-200 focus:border-purple-300 transition-all bg-slate-50 mb-3"
      />

      {/* Actions */}
      <div className="flex flex-col gap-1.5 mt-auto">
        <button
          id="cf-panel-submit-btn"
          type="button"
          onClick={() => submitFeedback(selectedRating || null, feedbackText.trim() || null)}
          disabled={isSubmitting}
          className="flex items-center justify-center gap-1.5 text-xs font-semibold text-white bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 px-3 py-1.5 rounded-full transition-all shadow-sm hover:shadow-md disabled:opacity-60 w-full"
        >
          {isSubmitting ? <Loader2 className="size-3 animate-spin" /> : <Send className="size-3" />}
          Submit
        </button>
        <button
          id="cf-panel-skip-btn"
          type="button"
          onClick={() => submitFeedback(null, null)}
          disabled={isSubmitting}
          className="text-[10px] text-slate-400 hover:text-slate-600 transition-colors py-1 rounded-full hover:bg-slate-100 disabled:opacity-50 w-full"
        >
          Skip
        </button>
      </div>
    </div>
  );
}

// ---------------------------------------------------------------------------
// Mini star widget for history card rows
// Fetches existing rating on mount and locks itself once submitted.
// ---------------------------------------------------------------------------
interface MiniStarRatingProps {
  transactionUuid: string;
  formatType: string;
  domain: string;
  /** Pass a known rating if available (e.g. from onFeedbackSubmitted callback) */
  externalRating?: number | null;
}

export function MiniStarRating({
  transactionUuid,
  formatType,
  domain,
  externalRating,
}: MiniStarRatingProps) {
  const [hoverRating, setHoverRating] = useState(0);
  const [rating, setRating] = useState<number | null>(null);
  const [saving, setSaving] = useState(false);
  const [locked, setLocked] = useState(false); // once submitted, lock

  const fetchedRef = useRef<string | null>(null);

  // Sync with external rating (from panel submission callback)
  useEffect(() => {
    if (externalRating !== undefined && externalRating !== null) {
      setRating(externalRating);
      setLocked(true);
    }
  }, [externalRating]);

  const handleRate = async (star: number) => {
    if (locked || saving) return;
    const newRating = rating === star ? null : star;
    setRating(newRating);
    setSaving(true);
    try {
      await fetch(`${middleware_url}/batch_process/sales_platform/content_feedback`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${localStorage.getItem("token")}`,
        },
        body: JSON.stringify({
          transaction_uuid: transactionUuid,
          format_type: formatType,
          domain,
          star_rating: newRating,
          feedback_text: null,
          user_id: localStorage.getItem("userId") || null,
          user_name: localStorage.getItem("name") || null,
        }),
      });
      setLocked(true);
    } catch (err) {
      console.error("Failed to save rating:", err);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="flex items-center gap-0.5">
      {[1, 2, 3, 4, 5].map((star) => (
        <button
          key={star}
          type="button"
          title={locked ? (STAR_LABELS[rating || 0] || "Rated") : STAR_LABELS[star]}
          className={`transition-transform focus:outline-none ${locked ? "cursor-default" : "hover:scale-110"}`}
          onMouseEnter={() => !locked && !saving && setHoverRating(star)}
          onMouseLeave={() => setHoverRating(0)}
          onClick={(e) => { e.stopPropagation(); handleRate(star); }}
          disabled={saving}
        >
          <Star
            className={`size-3.5 transition-colors duration-100 ${star <= (hoverRating || rating || 0)
                ? "fill-amber-400 text-amber-400"
                : "text-slate-300 fill-slate-100"
              }`}
          />
        </button>
      ))}
      {saving && <Loader2 className="size-3 animate-spin text-slate-400 ml-1" />}
      {locked && !saving && rating && (
        <span className="ml-1 text-[10px] text-amber-600 font-medium">{STAR_LABELS[rating]}</span>
      )}
    </div>
  );
}

// ---------------------------------------------------------------------------
// Inline text-feedback popover (used in content history card)
// Fetches existing feedback; disabled when already submitted.
// Opens downward to avoid clipping behind the header.
// ---------------------------------------------------------------------------
interface InlineTextFeedbackProps {
  transactionUuid: string;
  formatType: string;
  domain: string;
  /** Pass external text when parent knows it's already been submitted */
  externalText?: string | null;
  /** Called after saving so parent can update local state */
  onSaved?: (text: string) => void;
}

export function InlineTextFeedback({
  transactionUuid,
  formatType,
  domain,
  externalText,
  onSaved,
}: InlineTextFeedbackProps) {
  const [open, setOpen] = useState(false);
  const [existingText, setExistingText] = useState<string | null>(externalText ?? null);
  const [alreadySubmitted, setAlreadySubmitted] = useState(false);
  const [text, setText] = useState("");
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);

  // Sync if parent provides updated externalText
  useEffect(() => {
    if (externalText !== undefined && externalText !== null) {
      setExistingText(externalText);
      setAlreadySubmitted(true);
    }
  }, [externalText]);

  // Close on outside click
  useEffect(() => {
    if (!open) return;
    const handler = (e: MouseEvent) => {
      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {
        setOpen(false);
      }
    };
    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, [open]);

  const handleSave = async () => {
    setSaving(true);
    try {
      await fetch(`${middleware_url}/batch_process/sales_platform/content_feedback`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${localStorage.getItem("token")}`,
        },
        body: JSON.stringify({
          transaction_uuid: transactionUuid,
          format_type: formatType,
          domain,
          star_rating: null,
          feedback_text: text.trim() || null,
          user_id: localStorage.getItem("userId") || null,
          user_name: localStorage.getItem("name") || null,
        }),
      });
      setSaved(true);
      setAlreadySubmitted(true);
      setExistingText(text.trim() || null);
      onSaved?.(text.trim());
      setTimeout(() => { setSaved(false); setOpen(false); }, 1000);
    } catch (err) {
      console.error("Failed to save feedback:", err);
    } finally {
      setSaving(false);
    }
  };

  // If already submitted and no text, show a muted disabled label
  if (alreadySubmitted && !existingText) {
    return (
      <span className="flex items-center gap-1 text-[10px] text-slate-300 font-medium px-1.5 py-0.5 cursor-default select-none">
        <MessageSquare className="size-2.5" />
        Feedback given
      </span>
    );
  }

  // If already submitted with text, show read-only badge
  if (alreadySubmitted && existingText) {
    return (
      <span
        title={existingText}
        className="flex items-center gap-1 text-[10px] text-purple-500 font-medium px-1.5 py-0.5 bg-purple-50 rounded-md cursor-default select-none max-w-[80px] truncate"
      >
        <MessageSquare className="size-2.5 flex-shrink-0" />
        <span className="truncate">{existingText}</span>
      </span>
    );
  }

  return (
    <div className="relative inline-block" ref={containerRef}>
      <button
        type="button"
        onClick={(e) => { e.stopPropagation(); setOpen(!open); }}
        className="flex items-center gap-1 text-[9px] font-medium px-1.5 py-0.5 rounded-md transition-colors text-slate-400 hover:text-slate-600 hover:bg-slate-100"
        title="Give feedback"
      >
        <MessageSquare className="size-2.5" />
        Give Feedback
      </button>

      {open && (
        <div
          className="absolute left-0 top-full mt-1.5 z-[100] bg-white rounded-xl border border-slate-200 shadow-2xl p-3 w-60 animate-in fade-in slide-in-from-top-2 duration-150"
          onClick={(e) => e.stopPropagation()}
        >
          <p className="text-xs font-semibold text-slate-700 mb-2">Your comments</p>
          <textarea
            value={text}
            onChange={(e) => setText(e.target.value)}
            placeholder="Share your thoughts..."
            rows={3}
            autoFocus
            className="w-full text-xs text-slate-700 placeholder-slate-300 border border-slate-200 rounded-lg px-2.5 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-purple-200 focus:border-purple-300 bg-slate-50 mb-2"
          />
          <div className="flex items-center justify-end gap-2">
            <button
              type="button"
              onClick={() => setOpen(false)}
              className="text-xs text-slate-400 hover:text-slate-600 px-2 py-1 rounded-full hover:bg-slate-100"
            >
              Cancel
            </button>
            <button
              type="button"
              onClick={handleSave}
              disabled={saving}
              className="flex items-center gap-1 text-xs font-medium text-white bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 px-3 py-1 rounded-full shadow-sm hover:shadow-md disabled:opacity-60"
            >
              {saving ? <Loader2 className="size-3 animate-spin" /> : saved ? <CheckCircle2 className="size-3" /> : null}
              {saved ? "Saved!" : "Save"}
            </button>
          </div>
        </div>
      )}
    </div>
  );
}





