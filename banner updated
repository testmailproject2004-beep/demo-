import { useEffect, useMemo, useRef, useState } from 'react';
import {
  AlertCircle,
  Check,
  Download,
  ImagePlus,
  Loader,
  Plus,
  Sparkles,
  Trash2,
  Wand2,
  X,
} from 'lucide-react';
import { middleware_url } from '../../utils/constants';



interface BannerTemplate {
  id: string;
  name: string;
  image_url: string;
}

function templateImageUrl(template: BannerTemplate, width?: number): string {
  const base = `${middleware_url}${template.image_url}`;
  return width ? `${base}?w=${width}` : base;
}

// Matches BANNER_SIZES in banner.py — Gemini's full supported ratio set,
// not a narrower guess of my own. Keeping these two lists in the same
// order/values as that dict means a template's detected native ratio can
// never point at a value the dropdown doesn't actually offer.
const COMMON_RATIOS: Record<string, number> = {
  '1:1': 1,
  '3:2': 3 / 2,
  '2:3': 2 / 3,
  '3:4': 3 / 4,
  '4:3': 4 / 3,
  '4:5': 4 / 5,
  '5:4': 5 / 4,
  '9:16': 9 / 16,
  '16:9': 16 / 9,
  '21:9': 21 / 9,
};

function nearestAspectRatio(width: number, height: number): string {
  const actual = width / height;
  let best = '16:9';
  let bestDelta = Infinity;
  for (const [label, ratio] of Object.entries(COMMON_RATIOS)) {
    const delta = Math.abs(ratio - actual);
    if (delta < bestDelta) {
      best = label;
      bestDelta = delta;
    }
  }
  return best;
}

const aspectRatioOptions = [
  { value: '1:1', label: '1:1 · Square' },
  { value: '3:2', label: '3:2 · Standard landscape' },
  { value: '2:3', label: '2:3 · Standard portrait' },
  { value: '3:4', label: '3:4 · Portrait' },
  { value: '4:3', label: '4:3 · Landscape' },
  { value: '4:5', label: '4:5 · Tall square' },
  { value: '5:4', label: '5:4 · Wide square' },
  { value: '9:16', label: '9:16 · Story / skyscraper' },
  { value: '16:9', label: '16:9 · Widescreen' },
  { value: '21:9', label: '21:9 · Ultra widescreen' },
] as const;

interface HistoryItem {
  title: string;
  time: string;
  image: string;
}

interface SalesBannerGeneratorProps {
  /** Called when the modal is dismissed (X, Cancel). Either prop works. */
  onClose?: () => void;
  onBack?: () => void;
  /**
   * Set to false if you render this inside an existing modal/dialog wrapper,
   * so it doesn't add a second full-screen overlay of its own.
   */
  overlay?: boolean;
}

const labelClass = 'mb-1 block text-[11px] font-semibold uppercase tracking-wider text-slate-500';

const inputClass =
  'w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 transition focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600';

function readFileAsDataUrl(file: File): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(typeof reader.result === 'string' ? reader.result : '');
    reader.onerror = () => reject(new Error('Failed to read image file'));
    reader.readAsDataURL(file);
  });
}

export function SalesBannerGenerator({ onClose, onBack, overlay = true }: SalesBannerGeneratorProps) {
  const handleClose = onClose ?? onBack ?? (() => {});

  // Template list now comes from the backend — the single source of
  // truth. Fetched on mount; add/delete both re-fetch so the grid never
  // shows stale state.
  const [templates, setTemplates] = useState<BannerTemplate[]>([]);
  const [templatesLoading, setTemplatesLoading] = useState(true);
  const [templatesError, setTemplatesError] = useState<string | null>(null);
  const [selectedTemplateId, setSelectedTemplateId] = useState<string | null>(null);

  async function fetchTemplates(selectId?: string) {
    setTemplatesLoading(true);
    setTemplatesError(null);
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${middleware_url}/batch_process/sales_platform/banner/templates`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await response.json();
      if (!response.ok || data.success === false) {
        throw new Error(data.error || data.detail || 'Could not load templates');
      }
      const list: BannerTemplate[] = data.templates || [];
      setTemplates(list);
      setSelectedTemplateId((current) => {
        if (selectId && list.some((t) => t.id === selectId)) return selectId;
        if (current && list.some((t) => t.id === current)) return current;
        return list[0]?.id ?? null;
      });
    } catch (err) {
      setTemplatesError(err instanceof Error ? err.message : 'Could not load templates');
    } finally {
      setTemplatesLoading(false);
    }
  }

  useEffect(() => {
    void fetchTemplates();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Upload state — the "+" tile at the end of the grid
  const [uploading, setUploading] = useState(false);
  const [uploadError, setUploadError] = useState<string | null>(null);
  const uploadInputRef = useRef<HTMLInputElement>(null);

  async function handleUploadTemplate(file: File | null) {
    if (!file) return;
    if (!['image/png', 'image/jpeg', 'image/jpg', 'image/webp'].includes(file.type)) {
      setUploadError('Only PNG, JPG, or WEBP files are supported');
      return;
    }
    if (file.size > 15 * 1024 * 1024) {
      setUploadError('Image must be under 15MB');
      return;
    }
    setUploading(true);
    setUploadError(null);
    try {
      const dataUrl = await readFileAsDataUrl(file);
      const token = localStorage.getItem('token');
      const name = file.name.replace(/\.[^./]+$/, '');
      const response = await fetch(`${middleware_url}/batch_process/sales_platform/banner/templates`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ name, image: dataUrl }),
      });
      const data = await response.json();
      if (!response.ok || data.success === false) {
        throw new Error(data.error || data.detail || 'Upload failed');
      }
      await fetchTemplates(data.template?.id);
    } catch (err) {
      setUploadError(err instanceof Error ? err.message : 'Upload failed');
    } finally {
      setUploading(false);
      if (uploadInputRef.current) uploadInputRef.current.value = '';
    }
  }

  // Delete state — bin icon on each card
  const [deletingId, setDeletingId] = useState<string | null>(null);
  const [deleteError, setDeleteError] = useState<string | null>(null);

  async function handleDeleteTemplate(templateId: string, templateName: string) {
    if (!window.confirm(`Delete "${templateName}"? This can't be undone.`)) return;
    setDeletingId(templateId);
    setDeleteError(null);
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(
        `${middleware_url}/batch_process/sales_platform/banner/templates/${encodeURIComponent(templateId)}`,
        { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } },
      );
      const data = await response.json();
      if (!response.ok || data.success === false) {
        throw new Error(data.error || data.detail || 'Delete failed');
      }
      await fetchTemplates();
    } catch (err) {
      setDeleteError(err instanceof Error ? err.message : 'Delete failed');
    } finally {
      setDeletingId(null);
    }
  }

  // Core banner fields
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [aspectRatio, setAspectRatio] = useState<string>('16:9');
  const [aspectTouched, setAspectTouched] = useState(false);
  const [prompt, setPrompt] = useState('');

  // Optional photo — if left empty, the backend keeps the person already
  // baked into the template.
  const [photo, setPhoto] = useState<string | null>(null);
  const [photoError, setPhotoError] = useState<string | null>(null);

  // UI state
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [previewUrl, setPreviewUrl] = useState<string | null>(null);
  const [history, setHistory] = useState<HistoryItem[]>([]);
  // Captured from the X-Transaction-UUID response header. Not used yet —
  // your banner.py already has a refine-by-feedback flow keyed on this
  // (handle_banner_refine); if you want the "Anything else to change?"
  // field to hit that instead of a full regenerate, this is what a
  // /banner/refine call would need.
  const [lastTransactionId, setLastTransactionId] = useState<string | null>(null);

  
  const objectUrlsRef = useRef<string[]>([]);
  useEffect(() => {
    return () => {
      objectUrlsRef.current.forEach((url) => URL.revokeObjectURL(url));
    };
  }, []);

  
  const [nativeRatios, setNativeRatios] = useState<Record<string, string>>({});

  useEffect(() => {
    let cancelled = false;
    templates.forEach((template) => {
      if (nativeRatios[template.id]) return; // already probed
      const img = new Image();
      img.onload = () => {
        if (cancelled) return;
        const ratio = nearestAspectRatio(img.naturalWidth, img.naturalHeight);
        setNativeRatios((prev) => ({ ...prev, [template.id]: ratio }));
      };
      img.src = templateImageUrl(template, 300);
    });
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [templates]);

  const selectedTemplate = useMemo(
    () => templates.find((t) => t.id === selectedTemplateId) ?? null,
    [templates, selectedTemplateId],
  );

  // Once a template's native ratio resolves, adopt it as the default —
  // unless the user already deliberately picked a different one.
  useEffect(() => {
    if (!selectedTemplateId || aspectTouched) return;
    const ratio = nativeRatios[selectedTemplateId];
    if (ratio) setAspectRatio(ratio);
  }, [selectedTemplateId, nativeRatios, aspectTouched]);

  function selectTemplate(template: BannerTemplate) {
    setSelectedTemplateId(template.id);
    if (!aspectTouched && nativeRatios[template.id]) {
      setAspectRatio(nativeRatios[template.id]);
    }
  }

  async function handlePhotoUpload(file: File | null) {
    if (!file) return;
    if (!['image/png', 'image/jpeg', 'image/jpg', 'image/webp'].includes(file.type)) {
      setPhotoError('Only PNG, JPG, or WEBP files are supported');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      setPhotoError('Image size must be under 10MB');
      return;
    }
    try {
      setPhoto(await readFileAsDataUrl(file));
      setPhotoError(null);
    } catch {
      setPhotoError('Failed to read image file');
    }
  }

  async function generateBanner() {
    if (!selectedTemplateId) {
      setError('Pick a template first');
      return;
    }
    if (!title.trim() && !description.trim() && !prompt.trim()) {
      setError('Add a title, description, or instruction so there is something to change');
      return;
    }

    setLoading(true);
    setError(null);

    try {
      const token = localStorage.getItem('token');
      const payload = {
        template_id: selectedTemplateId,
        title: title.trim(),
        description: description.trim(),
        prompt: prompt.trim(),
        aspect_ratio: aspectRatio,
        photo, // null keeps the person already in the template
      };

      const response = await fetch(
        `${middleware_url}/batch_process/sales_platform/banner/generate`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(payload),
        },
      );

      if (!response.ok) {
        // Error responses are JSON ({"success": false, "error": "..."}),
        // even though a successful response is raw image bytes.
        let message = 'Banner generation failed';
        try {
          const errBody = await response.json();
          message = errBody.detail || errBody.error || errBody.message || message;
        } catch {
          /* response wasn't JSON either — keep the generic message */
        }
        throw new Error(message);
      }

      const blob = await response.blob();
      if (blob.size === 0) throw new Error('No banner image returned by the server');

      const bannerImage = URL.createObjectURL(blob);
      objectUrlsRef.current.push(bannerImage);
      const transactionId = response.headers.get('X-Transaction-UUID');
      setPreviewUrl(bannerImage);
      setLastTransactionId(transactionId);

      setHistory((prev) =>
        [
          {
            title: title.trim() || selectedTemplate?.name || 'Banner',
            time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            image: bannerImage,
          },
          ...prev,
        ].slice(0, 6),
      );
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to generate banner');
    } finally {
      setLoading(false);
    }
  }

  function downloadBanner() {
    if (!previewUrl) return;
    const link = document.createElement('a');
    link.href = previewUrl;
    link.download = `sales-banner-${Date.now()}.png`;
    link.click();
  }

  const card = (
    <div className="flex max-h-[94vh] w-full max-w-3xl flex-col overflow-hidden rounded-xl bg-white text-sm text-slate-900 antialiased shadow-2xl">
      {/* ===== Header ===== */}
      <div className="flex items-center justify-between px-5 py-3">
        <div>
          <div className="text-lg font-bold leading-tight text-slate-900">Banner Generator</div>
          <div className="mt-0.5 text-xs leading-tight text-slate-500">
            Edits one of the approved templates — layout and logo stay locked
          </div>
        </div>
        <button
          type="button"
          onClick={handleClose}
          aria-label="Close"
          className="rounded-md p-1 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
        >
          <X size={18} />
        </button>
      </div>
      <div className="border-b border-blue-100" />

      {/* ===== Scrollable body ===== */}
      <div className="flex-1 space-y-5 overflow-y-auto px-5 py-4">
        {/* Template picker */}
        <section>
          <div className="mb-2 flex items-center justify-between">
            <div className="text-sm font-semibold leading-tight text-slate-900">
              Choose a template
            </div>
            {templatesLoading && (
              <span className="flex items-center gap-1 text-[11px] text-slate-400">
                <Loader size={11} className="animate-spin" />
                Loading…
              </span>
            )}
          </div>

          {templatesError && (
            <div className="mb-2 flex items-start gap-2 rounded-md border border-red-200 bg-red-50 p-2.5">
              <AlertCircle size={15} className="mt-0.5 flex-shrink-0 text-red-600" />
              <p className="text-xs font-medium text-red-900">{templatesError}</p>
            </div>
          )}

          {deleteError && (
            <div className="mb-2 flex items-start gap-2 rounded-md border border-red-200 bg-red-50 p-2.5">
              <AlertCircle size={15} className="mt-0.5 flex-shrink-0 text-red-600" />
              <p className="text-xs font-medium text-red-900">{deleteError}</p>
            </div>
          )}

          {!templatesLoading && !templatesError && templates.length === 0 && (
            <p className="mb-2 text-xs text-slate-500">
              No templates yet — use the tile below to add the first one.
            </p>
          )}

          <div className="grid grid-cols-3 gap-2.5 sm:grid-cols-4">
            {templates.map((template) => {
              const active = template.id === selectedTemplateId;
              const isDeleting = deletingId === template.id;
              return (
                <div
                  key={template.id}
                  className={`group relative overflow-hidden rounded-lg border-2 transition ${
                    active
                      ? 'border-blue-600 ring-2 ring-blue-100'
                      : 'border-slate-200 hover:border-blue-300'
                  }`}
                >
                  <button
                    type="button"
                    onClick={() => selectTemplate(template)}
                    disabled={isDeleting}
                    className="block w-full text-left"
                  >
                    <img
                      src={templateImageUrl(template, 300)}
                      alt={template.name}
                      className={`aspect-[4/3] w-full object-cover ${isDeleting ? 'opacity-40' : ''}`}
                      loading="lazy"
                    />
                    {active && (
                      <span className="absolute right-1 top-1 rounded-full bg-blue-600 p-0.5 text-white">
                        <Check size={11} />
                      </span>
                    )}
                    <span className="block truncate bg-white px-1.5 py-1 text-[10.5px] font-medium text-slate-700">
                      {template.name}
                    </span>
                  </button>

                  <button
                    type="button"
                    onClick={(e) => {
                      e.stopPropagation();
                      void handleDeleteTemplate(template.id, template.name);
                    }}
                    disabled={isDeleting}
                    aria-label={`Delete ${template.name}`}
                    title={`Delete ${template.name}`}
                    className="absolute left-1 top-1 rounded-full bg-white p-1 text-red-600 shadow-sm transition hover:bg-red-600 hover:text-white disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    {isDeleting ? (
                      <Loader size={11} className="animate-spin" />
                    ) : (
                      <Trash2 size={11} />
                    )}
                  </button>
                </div>
              );
            })}

            {/* "+" tile — add a new template/golden sample */}
            <label
              className={`flex aspect-[4/3] cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed text-slate-400 transition hover:border-blue-400 hover:text-blue-600 ${
                uploading ? 'pointer-events-none opacity-60' : 'border-slate-300'
              }`}
            >
              {uploading ? (
                <Loader size={18} className="animate-spin" />
              ) : (
                <Plus size={18} />
              )}
              <span className="text-[10.5px] font-medium">
                {uploading ? 'Uploading…' : 'Add template'}
              </span>
              <input
                ref={uploadInputRef}
                type="file"
                accept="image/*"
                className="sr-only"
                onChange={(e) => void handleUploadTemplate(e.target.files?.[0] || null)}
              />
            </label>
          </div>

          {uploadError && <p className="mt-1.5 text-[11px] text-red-600">{uploadError}</p>}
        </section>

        <br />

        {/* Banner content */}
        <section>
          <div className="mb-2 text-sm font-semibold leading-tight text-slate-900">
            Banner content
          </div>
          <div className="space-y-3">
            <div>
              <label className={labelClass}>Title</label>
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="e.g., Q3 Sales Champion"
                className={inputClass}
              />
