# Matches the frontend's COMMON_RATIOS/nearestAspectRatio exactly, and
# BANNER_SIZES' key set elsewhere on this platform — used by refine to
# snap an existing image's pixel dimensions to the aspect-ratio hint
# Gemini expects, rather than passing raw width/height.
_COMMON_RATIOS: dict = {
    "1:1": 1,
    "3:2": 3 / 2,
    "2:3": 2 / 3,
    "3:4": 3 / 4,
    "4:3": 4 / 3,
    "4:5": 4 / 5,
    "5:4": 5 / 4,
    "9:16": 9 / 16,
    "16:9": 16 / 9,
    "21:9": 21 / 9,
}


def _nearest_common_ratio(width: int, height: int) -> str:
    if not height:
        return "16:9"
    actual = width / height
    return min(_COMMON_RATIOS, key=lambda label: abs(_COMMON_RATIOS[label] - actual))


