                onChange={(e) => setDescription(e.target.value)}
                placeholder="e.g., Congratulations on closing the year with record numbers"
                className={`${inputClass} min-h-[48px] resize-none`}
              />
            </div>
          </div>
        </section>

        <br />

        {/* Photo + aspect ratio */}
        <section>
          <div className="mb-2 text-sm font-semibold leading-tight text-slate-900">
            Person &amp; format
